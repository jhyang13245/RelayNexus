{
  "name": "relay-novel-nexus",
  "version": "1.26.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/build-nexus.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:unit && node --test tests/rendered-html.test.mjs tests/jieum-rendered.test.mjs && npm run test:cortex-replay && npm run test:cortex-host",
    "test:cortex-replay": "node scripts/cortex-165-log-replay.mjs",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/jieum/*.test.ts tests/dialogue-name-label.test.mjs",
    "test:jieum": "node --import tsx --test tests/jieum/*.test.ts",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:cortex-host": "node --test tests/cortex/*.test.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.49",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "hash-wasm": "^4.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "단청"
}
