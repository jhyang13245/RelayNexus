    const response=await apiFetchV1390(`${settings.baseUrl.replace(/\/$/,'')}/responses`,{method:'POST',headers:{'content-type':'application/json','authorization':`Bearer ${settings.apiKey}`},body:JSON.stringify({model:CortexPublicationReview.model,...engineReasoningParamsV253(CortexPublicationReview.model),stream:false,max_output_tokens:4096,input:[{role:'developer',content:[{type:'input_text',text:developer}]},{role:'user',content:[{type:'input_text',text:JSON.stringify({rawUserInput:input,publicState,requirements,attempt,priorPublicText:asText(visibleDraft).slice(-5000)})}]}]})});
