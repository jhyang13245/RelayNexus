      try{const response=await apiFetchV1390(settings.baseUrl.replace(/\/$/,'')+'/responses',{method:'POST',headers:{'content-type':'application/json','authorization':'Bearer '+settings.apiKey},body:JSON.stringify({model:CortexPublicationReview.model,...engineReasoningParamsV253(CortexPublicationReview.model),stream:false,max_output_tokens:4096,text:{format:{type:'json_schema',name:'cortex_minimal_edit',strict:true,schema:CortexPublicationPolicy.editSchema}},input:[{role:'developer',content:[{type:'input_text',text:CortexPublicationPolicy.editInstruction+(applicationFailure?' 이전 편집은 JSON 형식 또는 치환 위치 오류로 적용되지 않았다. 같은 초안의 같은 지적만 처리한다. before는 draft에 실제 존재하며 한 번만 나오는 연속 문자열을 그대로 복사한다. 새 결함을 찾거나 전체 문단을 재작성하지 않는다.':'')}]},{role:'user',content:[{type:'input_text',text:JSON.stringify({draft,protectionContext,...context,...(applicationFailure?{applicationFailure}:{})})}]}]})});
        if(!response.ok)throw new Error('EDIT_HTTP_'+response.status);diagnostic.stage='PARSE';const envelope=await response.json();diagnostic.rawResponse=parseOutputText(envelope);diagnostic.responseStatus=envelope.status||null;const proposal=JSON.parse(diagnostic.rawResponse);diagnostic.proposal=clone(proposal);diagnostic.stage='APPLY';const result=CortexPublicationPolicy.applyEdit(draft,proposal);Object.assign(diagnostic,clone(proposal),{status:'APPLIED',kept:result.kept});
        minimalEditResultsV1400.set(txn,{paragraphIndex:context.paragraphIndex,before:draft,after:result.text,kept:result.kept,changesPremise:result.changesPremise,claim:asText(context.reason).slice(0,300),reason:asText(proposal.reason).slice(0,300)});return result.text;
      }catch(error){diagnostic.status='FAILED';diagnostic.error=asText(error?.message||error);if(attempt===2||diagnostic.stage==='HTTP')throw error;applicationFailure={stage:diagnostic.stage,error:diagnostic.error,previousResponse:diagnostic.rawResponse};}
