  /* ===== v1.13.0 LLM 요건 판정 (선택형) =====
     "독자에게 무엇을 전달했는가"는 어휘 겹침으로 판정할 수 있는 종류의 물음이 아니다.
     한명진과 외할머니라는 낱말이 본문 어딘가에 있는 것과, 그 관계가 독자에게 전달된 것은 다르다.
     결정론적 판정은 여기까지가 한계고, 그것을 정규식으로 밀어붙이다 두 번 오탐을 냈다.

     켜면 커밋 직전에 미충족 요건만 모아 한 번 묻는다. 요건이 다 충족돼 있으면 호출하지 않는다.
     기본은 꺼 둔다. 켜면 정확해지는 대신 턴당 호출이 하나 늘고 커밋이 그만큼 늦어진다. */
  /* ===== v1.13.0 LLM 문학 캡슐 (선택형) =====
     v1.7.8 에는 매 턴 끝에 별도 호출로 인물의 표면/이면 감정, 대사의 속뜻, 관계의 온도를
     분석해 다음 턴에 넘기는 편집자가 있었다. 어느 시점에 결정론적 캡슐로 대체되면서
     장기 인물 일관성과 관계 누적이 함께 사라졌다.

     되살리되 기본은 꺼 둔다. "추가 API 호출 없음"은 Cortex 의 계약이고,
     비동기라 해도 문자 그대로는 위배이며 비용도 실제로 든다.
     켜면 사용자가 방금 나온 본문을 읽는 동안 백그라운드에서 돌고,
     실패하거나 늦으면 결정론적 캡슐이 그대로 쓰인다. 집필 경로는 어느 쪽이든 건드리지 않는다. */
  function literaryCapsuleSchemaV13(){
    const str={type:'string'},strArray={type:'array',items:str,maxItems:8},obj=p=>({type:'object',properties:p,required:Object.keys(p),additionalProperties:false});
    return obj({
      characters:{type:'array',maxItems:8,items:obj({name:str,surfaceEmotion:str,hiddenEmotion:str,currentAttitude:str,diction:str,dialogueSubtext:str,forbiddenShortcut:str})},
      relationships:{type:'array',maxItems:8,items:obj({from:str,to:str,temperature:str,delta:str,unspokenTension:str,nextDialoguePressure:str})},
      styleBlueprint:obj({perspectiveDistance:str,sentenceRhythm:str,sensoryPalette:strArray,metaphorDiscipline:str,endingImage:str}),
      sceneArc:obj({emotionalTrajectory:strArray,tensionCurve:strArray,sceneDelta:str,closingImage:str}),
      styleAvoid:strArray
    });
  }
  function literaryCapsuleInstructionsV13(){return '확정된 한국어 장르소설 본문을 다음 턴용 문학 캡슐로 압축하는 비공개 편집자다. 본문을 다시 쓰지 않는다. 설명이나 마크다운 없이 JSON 객체 하나만 출력한다. 공개된 사실만 남기고 아직 드러나지 않은 사건의 정답·물품·장소를 누설하지 않는다. 감정은 표면과 이면을 분리하고, 인물별 어휘와 대사의 속뜻, 관계의 실제 변화, 장면의 호흡과 마지막 이미지를 구체적으로 압축한다. 다음 행동을 하나로 확정하지 마라.'}
  function capsuleContextV13(sc){
    try{const c=globalThis.CORTEX_RUNTIME_V1111?.publicWriterContextV8?.(sc);if(c)return {title:c.title,genre:c.genre,tone:c.tone,protagonist:c.protagonist,presentCharacters:c.presentCharacters,relationships:c.relationships,world:c.world}}catch{}
    return {title:asText(sc?.title),world:sc?.world};
  }
  async function requestLiteraryCapsuleV13(sc,visible){
    const url=`${settings.baseUrl.replace(/\/$/,'')}/responses`,body={finalizedStory:asText(visible).slice(-4000),context:capsuleContextV13(sc)};
    const response=await apiFetchV1390(url,{method:'POST',headers:{'content-type':'application/json','authorization':`Bearer ${settings.apiKey}`},body:JSON.stringify({model:settings.model,stream:false,max_output_tokens:1400,input:[{role:'developer',content:[{type:'input_text',text:literaryCapsuleInstructionsV13()}]},{role:'user',content:[{type:'input_text',text:JSON.stringify(body)}]}],text:{format:{type:'json_schema',name:'cortex_literary_capsule_v13',strict:true,schema:literaryCapsuleSchemaV13()}}})});
    if(!response.ok)throw new Error(`Literary Capsule ${response.status}`);
    const parsed=JSON.parse(parseOutputText(await response.json()));
    if(!parsed||typeof parsed!=='object'||Array.isArray(parsed))throw new Error('Literary Capsule JSON 파싱 실패');
    return parsed;
  }
  /* 커밋 직후 백그라운드에서 캡슐을 채운다. 다음 턴이 이미 시작됐거나 세션이 갈렸으면 버린다. */
  async function enrichCapsuleWithLLMV13(sc,visible,epoch){
    if(asText(settings.literaryCapsule)!=='llm'||!settings.apiKey)return;
    try{
      const jobId=`capsule-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`,token=CortexContract.capsuleJobToken({jobId,baseRevision:sysCapsuleRevisionV9(sc),createdAtTurn:turns.filter(turn=>turn?.status==='COMMITTED').length,eventCursor:sysCapsuleCursorV9(sc),canonHash:sysCapsuleHashV9(sc)});sc.runtime.literaryCapsuleJob={token,status:'RUNNING',source:'llm_literary_capsule_v15'};
      const payload=await requestLiteraryCapsuleV13(sc,visible);
      if(epoch!==sessionEpoch||scenario!==sc)return;
      const currentToken=sc?.runtime?.literaryCapsuleJob?.token,current={jobId:currentToken?.jobId,baseRevision:sysCapsuleRevisionV9(sc),createdAtTurn:turns.filter(turn=>turn?.status==='COMMITTED').length,eventCursor:sysCapsuleCursorV9(sc),canonHash:sysCapsuleHashV9(sc)};if(!CortexContract.capsuleJobCurrent(token,current))return;
      const capsule=sc?.runtime?.nextTurnContinuityCapsule;if(!capsule?.payload)return;
