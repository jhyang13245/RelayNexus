        if(rawGraph&&!asText(rawGraph.schema).trim()&&(Array.isArray(rawGraph.claims)||Array.isArray(rawGraph.entityDeltas)||Array.isArray(rawGraph.inputRealizations))){rawGraph={...rawGraph,schema:CortexCommitGraph.schema};metrics.extractionSchemaCoerced=true}/* v1.26.6 — 정말 누락된 schema만 V2로 복구한다. 명시된 다른 schema는 의미가 다를 수 있으므로 조용히 재명명하지 않고 normalize의 불일치 거부로 보낸다. */else if(rawGraph&&asText(rawGraph.schema).trim()!==CortexCommitGraph.schema){metrics.extractionSchemaMismatch=asText(rawGraph.schema).trim()}metrics.extractionMs=performance.now()-extractionStarted;metrics.extractionSource=rawGraph?'ENGINE_MODEL_EXTRACTION':'UNAVAILABLE';metrics.extractionFailed=extractionFailed;
        const graph=acceptedGraph||CortexCommitGraph.normalize(rawGraph||CortexCommitGraph.graphShape(),{prose:committedText,input,catalog:txn.commitGraphCatalog,requireInputAttestation:true}),audit=CortexCommitGraph.audit(graph,commitAuditContextV213(txn));
        metrics.extractionClaimCount=asList(graph?.claims).length;metrics.extractionRawClaimCount=asList(rawGraph?.claims).length;if(!asList(rawGraph?.claims).length&&rawGraph)metrics.extractionEmptyGraph=true;/* v1.25.4/v1.26.1 — 빈 그래프 가시화: 정규화 전 원시 claims 수까지 기록해 모델 출력과 정규화 중 어디서 비는지 가른다 */metrics.zeroRepairPass=repairs===0;metrics.paragraphRepairRate=repairs/Math.max(1,metrics.packetsReceived||1);metrics.crossParagraphContinuity=true;metrics.crossBitContinuity=true;
        return {text:committedText,rawGraph:rawGraph||CortexCommitGraph.graphShape(),graph,audit,extractionFailed,packets:[],spine:null,planLedger:[],stream:{status:extractionFailed?'EXTRACTION_UNAVAILABLE':'PROSE_PARSED',packetCount:metrics.packetsReleased,outsideText:''}}
      }
    };
  }
  async function requestGraphExtractionV250(input,txn,fullText,attempt=0,minimal=false,recoveryFeedback=null){
    /* v1.25.0 — 엔진 소유 의미 추출. 작가와 별개 호출로, 확정된 본문에서만 Commit Graph V2 raw를 뽑는다. canonRealizations는 판정관 권한이므로 추출하지 않는다. */
    const catalog=txn?.commitGraphCatalog||{},compact={characters:asList(catalog.characters).map(row=>({ref:row.ref,name:row.name,aliases:asList(row.aliases)})),locations:asList(catalog.locations).map(row=>({ref:row.ref,label:row.label,aliases:asList(row.aliases)})),entities:asList(catalog.entities).map(row=>({ref:row.ref,label:row.label})),actions:asList(catalog.actions).map(row=>asText(row.ref)),capabilities:asList(catalog.capabilities).map(row=>({capabilityRef:row.capabilityRef,label:row.label,state:row.state})),resources:asList(catalog.resources).map(row=>({resourceRef:row.resourceRef,current:row.current})),current:catalog.current||{}};
    const exampleActor=asText(asList(catalog.characters)[0]?.ref,'char:주인공'),exampleEntity=asText(asList(catalog.entities)[0]?.ref,'entity:사물'),exampleClaim={claimId:'c1',actorRef:exampleActor,actionRef:'action:inspect',targetRef:exampleEntity,actuality:'COMMITTED',completionStatus:'COMPLETED',confidence:'VERIFIED',evidenceQuote:'본문의 실제 연속 인용 20자 내외'},exampleTransitClaim={claimId:'move-1',actorRef:exampleActor,actionRef:'action:move',sourceLocationRef:asText(catalog?.current?.locationRef),destinationLocationRef:'catalog.locations 안의 실제 목적지 ref',movementScope:'REMOTE',actuality:'COMMITTED',completionStatus:'PARTIAL',confidence:'VERIFIED',evidenceQuote:'실제로 출발했거나 이동 중인 본문의 연속 인용'};
    compact.transitSemantics={rule:'actuality는 목적지 도착 여부가 아니라 해당 행동 단계가 현실에서 실제 발생했는지를 뜻한다. 실제 출발·탑승·이동 중이면 COMMITTED+PARTIAL, 실제 시도 후 차단이면 COMMITTED+BLOCKED다. NONCOMMITTED는 계획·가정·취소뿐이다.',exampleTransitClaim,allowedActionRule:'catalog.actions의 ref만 사용한다. action:wait가 목록에 없으면 action:rest 또는 action:other를 쓴다.'};
    if(recoveryFeedback)compact.recovery={instruction:'직전 후보는 제품 정규화에서 탈락했다. 같은 오류를 반복하지 말고 rawUserInput의 정확한 연속 부분문자열을 inputQuote로 쓰며, 그 inputRealization을 검증 가능한 claimId에 연결한다. 이동 본문이면 실제 발생한 출발·탑승·이동 단계를 COMMITTED로 기록한다.',failureCodes:asList(recoveryFeedback.codes),issueCodes:asList(recoveryFeedback.issueCodes),failedRefs:asList(recoveryFeedback.failedRefs)};
    /* v1.29.4 — 즉흥 인물 등록 예시. v1.29.2에서 계약 문장은 넣었지만 형식 예시가 없어 모델이 따르지 않았고,
       실전 로그 v1.29.3에서 편의점 직원 관련 claim이 UNKNOWN_REFERENCE·OUT_OF_SCENE_ACTION으로 무더기 탈락했다. */
    const examplePersonDelta={entityRef:'entity:convenience-clerk',label:'편의점 직원',entityType:'PERSON',claimId:'c2',evidenceQuote:'본문에서 그 인물이 처음 등장한 연속 인용'},
      examplePersonClaim={claimId:'c2',actorRef:'entity:convenience-clerk',actionRef:'action:speak',actuality:'COMMITTED',confidence:'VERIFIED',evidenceQuote:'직원이 소리를 질렀다'};const developer=`너는 이미 확정된 한국어 소설 본문의 의미 장부만 추출하는 Cortex 추출기다. 본문을 다시 쓰거나 평가하거나 새 사실을 만들지 않는다. 본문에서 실제로 성립한 행동만 claims로 기록한다. 계획·가정·회상·비유·부정·실패한 시도는 COMMITTED로 기록하지 않는다. rawUserInput의 행동이 본문에서 실제로 실현·부분 실현·차단됐다면 세계가 크게 바뀌지 않았어도 그 실현 자체를 최소 1개의 claim(적절한 actionRef가 없으면 action:other)과 inputRealizations로 반드시 제출한다. 빈 claims는 본문에 성립한 행동이 전혀 없을 때만 허용된다. actorRef·targetRef·장소·능력·자원은 아래 catalog의 ref만 사용한다. 목록에 없는 장소가 나오면 destinationLocationLabel을 본문에서 확인되는 실제 표기 그대로 제출하고 destinationLocationRef는 비워 둔다. 엔진이 본문 증거와 출발지로 결정론적 session-local ref를 발급한다. 목록에 없는 능력·자원은 참조를 발명하지 말고 confidence를 UNCERTAIN으로 남긴다. 다만 catalog에 없는 인물이 장면에 등장하면 entityDeltas에 entityRef 'entity:슬러그', entityType 'PERSON', label, evidenceQuote로 먼저 등록하고, 그 entityRef를 그대로 actorRef·targetRef로 쓴다. 등록하면 그 인물의 행동도 정상 claim으로 제출한다. 각 claim에는 그 행동이 성립한 본문의 실제 연속 인용을 evidenceQuote로 넣는다. 이동은 actionRef action:move에 출발·도착과 movementScope(LOCAL|REMOTE|UNKNOWN)를 쓴다. claims는 중요도순 최대 10개, evidenceQuote는 20자 내외의 짧은 인용으로 제한한다. rawUserInput의 행동이 실현·부분 실현·차단된 claim을 inputRealizations로 연결한다. 장기 지속·시점 도약은 temporalRealizations로 기록한다. 본문에 실제로 나온 새 사물·새 인물은 entityDeltas(entityType PROP|INFORMATION|DOCUMENT|DEVICE|PERSON|OTHER), 새 부분공간은 locationDeltas, 인물 등퇴장은 presenceDeltas, 상태 변화는 stateDeltas로 제출한다. canonRealizations는 절대 제출하지 않는다. ${CortexCommitGraph.begin}와 ${CortexCommitGraph.end} 사이에 JSON 하나만 출력하며, 그 JSON의 최상위에 "schema":"${CortexCommitGraph.schema}" 필드를 반드시 포함한다.\n${JSON.stringify({exampleClaim,examplePersonDelta,examplePersonClaim,claimFields:Object.keys(CortexCommitGraph.claimShape()),catalog:compact})}`;
    const controller=new AbortController(),timeoutMs=attempt===0?45000:30000,timer=setTimeout(()=>controller.abort('GRAPH_EXTRACTION_TIMEOUT'),timeoutMs);/* v1.25.3 — 추출은 판정이 아니라 생성 작업이다. 판정관 예산(12s)을 물려받아 상시 타임아웃이 되던 것을 생성 예산으로 교정. 타자기 표시와 병렬이라 체감 비용은 낮다. */
    try{
      const response=await apiFetchV1390(`${settings.baseUrl.replace(/\/$/,'')}/responses`,{method:'POST',signal:controller.signal,headers:{'content-type':'application/json','authorization':`Bearer ${settings.apiKey}`},body:JSON.stringify({model:settings.model,stream:false,max_output_tokens:minimal?1800:3600,...engineReasoningParamsV253(settings.model),input:[{role:'developer',content:[{type:'input_text',text:minimal?`${developer}\n[최소 추출 모드] 시간이 부족하다. 세계를 바꾸는 핵심 행동(이동·획득·상태 변화·사용자 행동 실현)의 claims와 inputRealizations만 최대 6개로 제출하고 나머지 delta는 생략한다.`:developer}]},{role:'user',content:[{type:'input_text',text:JSON.stringify({rawUserInput:asText(input),fullTurnText:asText(fullText).slice(0,12000),startState:txn?.start,temporalAuthority:txn?.temporalAuthority,eventEligibility:txn?.eventEligibility})}]}]})});
      if(!response.ok)throw new Error(`EXTRACTION_API_${response.status}`);
      const payload=await response.json(),outputText=parseOutputText(payload),finishReason=asText(payload?.incomplete_details?.reason||payload?.status);
      const envelope=CortexCommitGraph.splitEnvelope(outputText);
      if(envelope.status==='PARSED'&&envelope.graph)return {graph:envelope.graph,salvaged:false,finishReason};
      const salvage=CortexCommitGraph.salvageEnvelope(outputText);/* v1.25.4 — 토큰 잠식으로 END 전에 잘린 봉투 복구. 실전 로그의 EXTRACTION_INCOMPLETE 3연속이 이 경로로 흡수된다. */
      if(salvage.status==='SALVAGED'&&salvage.graph)return {graph:salvage.graph,salvaged:true,finishReason};
      throw new Error(`EXTRACTION_${envelope.status}${finishReason?':'+finishReason:''}`);
    }catch(error){throw controller.signal.aborted?new Error('EXTRACTION_TIMEOUT'):error}
    finally{clearTimeout(timer)}
  }
  function canonEvidenceSourcesV267(fullText){
    /* 종결조건은 사건 전체에 걸쳐 성립한다. 현재 문단만 다시 채점하면 앞 비트의
       확정 사실을 잊어 복합 요건이 영원히 UNCERTAIN에 머무르므로, 같은 사건에서
       화면에 확정된 본문만 sourceRef별로 누적하고 현재 후보를 별도 출처로 붙인다. */
    const eventId=asText(scenario?.event?.id),prior=asList(turns).filter(row=>row?.status==='COMMITTED'&&asText(row?.transition?.eventId)===eventId&&asText(row?.text)).slice(-6).map(row=>({sourceRef:`BEAT:${asText(row.id)}`,text:asText(row.text).slice(-5000),current:false}));
    if(!prior.length){const continuity=asText(scenario?.runtime?.sceneContinuity?.lastText);if(continuity)prior.push({sourceRef:'PRIOR_PUBLIC_CONTINUITY',text:continuity.slice(-5000),current:false})}
    const previous=CortexPublicationReview.previousEventEvidence(turns,eventId),seen=new Set(previous.map(row=>row.sourceRef));
    const pending=CortexProgression.context(scenario.runtime,turns).pendingTexts;return [...pending.filter(row=>!previous.some(x=>x.sourceRef===row.sourceRef)&&!prior.some(x=>x.sourceRef===row.sourceRef)),...previous,...prior.filter(row=>!seen.has(row.sourceRef)&&!previous.some(old=>old.text.includes(row.text))),{sourceRef:'CURRENT_BEAT',text:asText(fullText),eventId,current:true}]
  }
  async function requestCanonAdjudicationV250(input,txn,fullText){
    /* v1.26.7 — 판정관은 활성 사건의 누적 공개 근거창을 읽는다. MET은 각 출처의
       실제 인용이 결박될 때만 유효하며, 비트별로 흩어진 복합 조건도 합산한다. */
    if(txn?.eventEligibility?.canConsumeEventTurn!==true)return {schema:CortexCanonAdjudicator.schema,available:true,skipped:'EVENT_NOT_ELIGIBLE',verdicts:[],metCount:0,unmetCount:0,uncertainCount:0};/* v1.25.1 — 시작 전 사건의 미래 요건은 판정 대상이 아니다 */
    const requirements=asList(txn?.commitGraphCatalog?.requirements);
    if(!requirements.length)return {schema:CortexCanonAdjudicator.schema,available:true,verdicts:[],metCount:0,unmetCount:0,uncertainCount:0};
    const saved=scenario.runtime?.requirementVerdicts,sameEvent=asText(saved?.eventId)===asText(scenario?.event?.id),priorMetRefs=sameEvent?requirements.filter(row=>saved?.records?.[row.ref]?.status==='MET').map(row=>row.ref):[]/* v1.26.3 — 봉인 판정은 증거 결박된 records만 신뢰. 근거 없는 구 verdicts=true는 재판정된다 */,open=requirements.filter(row=>!priorMetRefs.includes(row.ref));
    if(!open.length)return {schema:CortexCanonAdjudicator.schema,available:true,verdicts:[],metCount:0,unmetCount:0,uncertainCount:0};
    const evidenceSources=canonEvidenceSourcesV267(fullText),request=CortexCanonAdjudicator.request({rawUserInput:input,fullText,evidenceSources,requirements:open,priorMetRefs,invariants:asList(txn?.commitGraphCatalog?.invariants)});
    const controller=new AbortController(),timer=setTimeout(()=>controller.abort('ADJUDICATOR_TIMEOUT'),judgeTimeoutV242('TURN_FINAL'));
    try{
      const response=await apiFetchV1390(`${settings.baseUrl.replace(/\/$/,'')}/responses`,{method:'POST',signal:controller.signal,headers:{'content-type':'application/json','authorization':`Bearer ${settings.apiKey}`},body:JSON.stringify({model:CortexContinuityJudge.model,stream:false,max_output_tokens:1200,...engineReasoningParamsV253(CortexContinuityJudge.model),text:{format:{type:'json_schema',name:'cortex_canon_adjudication',strict:true,schema:request.schema}},input:[{role:'developer',content:[{type:'input_text',text:request.developer}]},{role:'user',content:[{type:'input_text',text:JSON.stringify(request.payload)}]}]})});
      if(!response.ok)return CortexCanonAdjudicator.fallback(open,response.status===429?'MODEL_RATE_LIMIT':'MODEL_FAILURE');
      let parsed=null;try{parsed=JSON.parse(parseOutputText(await response.json()))}catch{return CortexCanonAdjudicator.fallback(open,'INVALID_OUTPUT')}
      const firstPass=CortexCanonAdjudicator.bindVerdicts(CortexCanonAdjudicator.normalize(parsed,open,asList(txn?.commitGraphCatalog?.invariants)),evidenceSources,open);
      return await resolveChoiceCandidatesV1210(firstPass,{input,open,evidenceSources});
    }catch(error){return CortexCanonAdjudicator.fallback(open,error?.name==='AbortError'||controller.signal.aborted?'MODEL_TIMEOUT':'MODEL_FAILURE')}
    finally{clearTimeout(timer)}
  }
  async function resolveChoiceCandidatesV1210(adjudication,{input,open,evidenceSources}){
    /* v1.27.10 — 복합 선택조건의 토큰 회복은 자문일 뿐이다. 후보 인용이 모이면 같은 판정관에게
       "이 인용들이 문맥상 요건을 충족하는가"를 좁게 한 번 더 묻고, 충족 부여는 그 답변만 한다.
       2차 질의는 턴당 1회이며 실패·시간초과 시 UNCERTAIN 그대로 둔다(안전 기본값). */
    const rows=asList(adjudication?.verdicts),candidates=rows.filter(row=>row?.code==='CHOICE_EVIDENCE_CANDIDATE'&&row?.recoveryCandidate);
    if(!candidates.length)return adjudication;
    /* v1.27.11 — 후보 전부를 한 번의 요청에 묶는다. 첫 후보만 처리하면 나머지 조건이 이미 충족됐어도 비트를 더 쓴다. */
    const byRef=new Map(open.map(row=>[asText(row.ref),row])),items=candidates.map(row=>({requirement:byRef.get(asText(row.requirementRef)),candidate:row.recoveryCandidate})).filter(row=>row.requirement);
    if(!items.length)return adjudication;
    const itemRequirements=items.map(row=>row.requirement),request=CortexCanonAdjudicator.recoveryRequest({items,evidenceSources,rawUserInput:input});
    const controller=new AbortController(),timer=setTimeout(()=>controller.abort('ADJUDICATOR_TIMEOUT'),judgeTimeoutV242('TURN_FINAL'));
    try{
      const response=await apiFetchV1390(`${settings.baseUrl.replace(/\/$/,'')}/responses`,{method:'POST',signal:controller.signal,headers:{'content-type':'application/json','authorization':`Bearer ${settings.apiKey}`},body:JSON.stringify({model:CortexContinuityJudge.model,stream:false,max_output_tokens:900,...engineReasoningParamsV253(CortexContinuityJudge.model),text:{format:{type:'json_schema',name:'cortex_canon_adjudication',strict:true,schema:request.schema}},input:[{role:'developer',content:[{type:'input_text',text:request.developer}]},{role:'user',content:[{type:'input_text',text:JSON.stringify(request.payload)}]}]})});
      if(!response.ok)return {...adjudication,choiceRecovery:{requested:true,outcome:'MODEL_FAILURE'}};
      let parsed=null;try{parsed=JSON.parse(parseOutputText(await response.json()))}catch{return {...adjudication,choiceRecovery:{requested:true,outcome:'INVALID_OUTPUT'}}}
      const second=CortexCanonAdjudicator.bindVerdicts(CortexCanonAdjudicator.normalize(parsed,itemRequirements,[]),evidenceSources,itemRequirements);
      const answers=new Map(asList(second?.verdicts).map(row=>[asText(row.requirementRef),row]));
      /* 항목별 병합: 2차 MET(결박 통과)만 승격, 나머지는 원래 상태 유지 */
      let recovered=0;const outcomes={};
      const verdicts=rows.map(row=>{if(row?.code!=='CHOICE_EVIDENCE_CANDIDATE')return row;const answer=answers.get(asText(row.requirementRef));outcomes[asText(row.requirementRef)]=answer?answer.status:'NO_ANSWER';if(answer&&answer.status==='MET'){recovered++;return {...answer,code:'CHOICE_RECOVERY_ADJUDICATED'}}return row});
      return {...adjudication,verdicts,metCount:verdicts.filter(row=>row.status==='MET').length,uncertainCount:verdicts.filter(row=>row.status==='UNCERTAIN').length,choiceRecovery:{requested:true,candidates:items.length,recovered,outcomes,outcome:recovered?'MET':'NONE_RECOVERED'}};
    }catch(error){return {...adjudication,choiceRecovery:{requested:true,outcome:controller.signal.aborted?'MODEL_TIMEOUT':'MODEL_FAILURE'}}}
    finally{clearTimeout(timer)}
  }
  function applyCanonAdjudicationV250(sc,txn,adjudication){sc.runtime=sc.runtime||{};const requirements=asList(txn?.commitGraphCatalog?.requirements),merged=CortexCanonAdjudicator.mergeLedger(sc.runtime.requirementVerdicts,adjudication,{eventId:asText(sc?.event?.id),requirements,at:new Date().toISOString()});sc.runtime.requirementVerdicts=merged;if(sc.runtime.systemicEventState)sc.runtime.systemicEventState.requirementVerdicts=clone(merged);return merged}
  /* v1.12.0 — 커밋을 막지는 않지만 한 번은 고쳐 써야 하는 문제.
     INPUT_ARGUMENT_MISSING 은 목적지 문자열 포함 검사라 대명사·환언에서 오탐이 난다.
     이걸 하드로 올리면 정상 문장이 REJECTED 되므로, 재작성 트리거로만 쓴다. */
  function repairableQualityIssuesV12(issues){return [...new Set(asList(issues).filter(i=>/^(?:INPUT_ACTION_MISSING|INPUT_ARGUMENT_MISSING|DEFERRED_DESTINATION_COMPLETED|INCOMPLETE_SENTENCE|DANGLING|EVENT_TOPIC_LEAK|MISSING_DIALOGUE|SCENE_PROP_OVERUSE|CLOSURE_UNMET)/u.test(asText(i))))]}
  /* v1.12.2 — 현실 경계 위반.
     실제 로그에서 꿈속 학교 사물함에서 꺼낸 쪽지가 깨어난 뒤 현실의 손에 남았다.
     기존 검사는 이것을 전혀 보지 못했다. 미래 사건 누출도 장소 점프도 아니기 때문이다.
     꿈·회상 진입 → 현실 복귀 → 소지 표현이 순서대로 나타나면 재작성 대상으로 올린다.
     하드로 올리지 않는 이유는 정상적인 회상 서술과 구분이 완전하지 않기 때문이다. */
  const LIT_UNREAL_ENTER_RE=/(?:꿈|회상|기억\s*속|상상|환영|환각|잠결|떠올랐|떠올리)/u;
