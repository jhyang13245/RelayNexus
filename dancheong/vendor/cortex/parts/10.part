      return asText(body).split(/\n\s*\n/u)[0].trim();
    });
  }
  function markRepairResultV1391(txn,kind,status,code=''){const turn=turns.find(row=>row.txn===txn||row.txn?.txnId===txn?.txnId),entry=asList(turn?.repairLog?.entries).findLast(row=>row.kind===kind&&row.status==='AWAITING_REVIEW');if(entry){entry.status=status==='ACCEPTED'&&entry.before===entry.after?'KEPT':status;entry.reviewCode=asText(code)}}
  async function requestRepairFragmentV160(input,txn,draft,issues,instruction,logContext={}){return recordRepairAttemptV1391(txn,{kind:'PARAGRAPH',before:draft,reasonCodes:issues,...logContext},()=>requestRepairFragmentV160UnloggedV1391(input,txn,draft,issues,instruction,logContext))}
  async function requestRepairFragmentV160UnloggedV1391(input,txn,draft,issues,instruction,logContext={}){return requestMinimalEditV1400(input,txn,draft,{...logContext,code:issues[0]})}
  async function requestMinimalEditV1400(input,txn,draft,context){
    const turnForRoute=turns.find(row=>row.txn===txn),lastRoute=asList(turnForRoute?.metrics?.publicationRouting).findLast(row=>row.paragraphIndex===context.paragraphIndex),protectionContext=CortexPublicationPolicy.request(paragraphRequestV1391(input,txn,{paragraphIndex:context.paragraphIndex,paragraphText:draft,priorText:context.priorPublicText}),{scopes:lastRoute?.scopes||['DISCLOSURE','ORDER','MATERIAL','FIXED_FACT']}).payload;delete protectionContext.draft;delete protectionContext.rawUserInput;
