  function terminalClosureRowsV1361(txn,refs=txn?.finalExtension?.missingRefs){const wanted=new Set(asList(refs).map(value=>asText(value))),rows=asList(txn?.writerCommitGraphCatalog?.requirements).filter(row=>wanted.has(asText(row?.ref)));return rows.map(row=>({requirementRef:asText(row?.ref),description:asText(row?.description||row?.label||row?.statement)})).filter(row=>row.requirementRef&&row.description)}
