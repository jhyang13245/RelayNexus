  function refreshRepairTracksV1394(txn,prose){const pairs=repairPairsV1394.get(txn);if(!pairs)return;const parts=asText(prose).split(/\n\s*\n/u).filter(Boolean);let rows=asList(txn.narrativeSpacetimeTrack?.segments);parts.forEach((part,i)=>{const pair=pairs.get(part);if(!pair?.accepted)return;rows=rows.filter(r=>r.paragraphIndex!==i+1);rows.push(...pair.segments.map(r=>({...r,paragraphIndex:i+1,index:i+1})));});rows.sort((a,b)=>a.paragraphIndex-b.paragraphIndex);txn.narrativeSpacetimeTrack=CortexNarrativeSpacetime.normalize({segments:rows},{start:txn.start,turnId:txn.txnId,source:'PUBLIC_REPAIR_PAIRS'});}
  function repairTrackContractV1394(){return '\n'+CortexNarrativeSpacetime.markerInstruction();}
