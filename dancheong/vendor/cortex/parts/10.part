  async function recordRepairAttemptV1391(txn,meta,work){const turn=turns.find(row=>row.txn===txn||row.txn?.txnId===txn?.txnId);if(!turn){const result=await work();return result==null?null:CortexQuality.prose(result)}const log=turn.repairLog||(turn.repairLog={schema:'CORTEX_REPAIR_LOG_V1',visibility:'DIAGNOSTIC_ONLY',entries:[]}),entry={id:turn.id+':repair:'+(log.entries.length+1),kind:meta.kind,operation:meta.operation||'REPLACE',paragraphIndex:meta.paragraphIndex||null,attempt:meta.attempt||log.entries.filter(row=>row.kind===meta.kind&&row.paragraphIndex===(meta.paragraphIndex||null)).length+1,reason:asText(meta.reason),reasonCodes:asList(meta.reasonCodes).map(value=>asText(value)),before:asText(meta.before),after:null,status:'REQUESTED',startedAt:new Date().toISOString()},started=performance.now();log.entries.push(entry);try{const priorTrack=clone(txn.narrativeSpacetimeTrack);let candidate,candidateTrack;try{candidate=await work();candidateTrack=txn.narrativeSpacetimeTrack}finally{txn.narrativeSpacetimeTrack=priorTrack}const decoded=CortexNarrativeSpacetime.parseText(asText(candidate),{start:txn.start,turnId:txn.txnId,source:'REPAIR_CANDIDATE'}),body=candidate==null?null:CortexQuality.prose(decoded.visible);if(!decoded.track.segments.length&&candidateTrack&&JSON.stringify(candidateTrack)!==JSON.stringify(priorTrack))decoded.track={...candidateTrack,segments:meta.kind==='TAIL_RECOVERY'?candidateTrack.segments:asList(candidateTrack.segments).slice(asList(priorTrack?.segments).length)};entry.after=body;entry.spacetimeCandidate=decoded.track;entry.status=body?'AWAITING_REVIEW':'NO_OUTPUT';if(body){let pairs=repairPairsV1394.get(txn);if(!pairs){pairs=new Map();repairPairsV1394.set(txn,pairs)}const parts=body.split(/\n\s*\n/u).filter(Boolean),offset=Math.max(0,(meta.paragraphIndex||1)-1),rows=decoded.track.segments.filter(r=>meta.kind!=='TAIL_RECOVERY'||r.paragraphIndex>offset);pairs.set(body,{segments:rows,accepted:false});if(parts.length>1)parts.forEach((p,i)=>pairs.set(p,{segments:rows[i]?[rows[i]]:[],accepted:false}));}return body}catch(error){entry.status='REQUEST_FAILED';entry.errorCode=asText(error?.message||'REPAIR_REQUEST_FAILED');entry.errorStage=asList(turn.metrics?.minimalEdits).at(-1)?.stage||null;throw error}finally{entry.generationMs=performance.now()-started;entry.finishedAt=new Date().toISOString()}}
