  function proseSpeakerCatalogV1421(txn){
    const byRef=new Map,remember=(ref,name)=>{ref=asText(ref).trim();name=asText(name).trim();if(ref&&name&&!byRef.has(ref))byRef.set(ref,{characterId:ref,speakerName:name})};
    for(const row of asList(txn?.writerCommitGraphCatalog?.characters||txn?.commitGraphCatalog?.characters))remember(row?.ref||row?.id,row?.name||row?.label);
    const context=txn?.writerContext||{};remember(context?.protagonist?.id||context?.protagonist?.ref,context?.protagonist?.name);
    for(const row of asList(context?.presentCharacters))remember(row?.id||row?.ref,row?.name);
    // The writer needs a private identity lookup even before a character is public.
    const people=[scenario?.protagonist,...asList(scenario?.characters)].filter(Boolean);
    const hero=CortexTurnExperience.publicCharacter(scenario?.protagonist,scenario);if(hero)remember(hero.id,hero.name);
    for(const person of people)if(asList(scenario?.runtime?.publicAppearanceRefs).includes(person.id)){const visible=CortexTurnExperience.publicCharacter(person,scenario);if(visible)remember(visible.id,visible.name)}
    for(const person of people)remember(person.id,person.name||person.source?.name);
    return [...byRef.values()].flatMap(row=>{const person=people.find(p=>String(p.id)===row.characterId);if(!person)return [];const visible=CortexTurnExperience.publicCharacter(person,scenario);return [{characterId:row.characterId,registeredName:asText(person.name||person.source?.name).trim(),speakerName:visible?.name||''}]})
  }
  function proseSpeakerContractV1421(txn){
    return [
      '\n[작가 전용 사건 등장인물 — 독자에게 출력하지 않음]',
      JSON.stringify(CortexTurnExperience.authorCast(scenario)),
      '[산문작가가 대사에 직접 붙이는 화자 주석 — 소설 카드와 VN이 함께 사용]',
      '등록 인물의 대사를 집필하는 그 순간, 여는 따옴표 바로 앞에 ⟦S:등록명|공개 호칭|PHYSICAL⟧을 붙인다. (실제 화자 이름) 주석의 기계 판독 형식이다. registeredName을 정확히 쓰며, 공개 호칭은 현재 본문에서 부르는 이름 그대로 쓴다. 현장 대사는 PHYSICAL, 전화·무전·문자·화면 너머 대사는 REMOTE로 쓴다. 주석 전체는 독자 본문에서 제거된다.',
      '예: 여자가 문 앞에서 말했다. ⟦S:강민서|여자|PHYSICAL⟧“이쪽으로 와요.” 등록명 강민서는 내부 이미지 연결에만 쓰고 카드에는 여자만 표시한다. 이 대사의 상대를 화자로 지정하지 않는다. 인물이 색인에 없거나 등록명이 중복되어 특정할 수 없으면 ⟦N:공개 이름⟧으로 호칭만 쓴다. 외형이 비슷하다는 이유로 등록 인물에 연결하지 않는다.',
      '이름 공개의 연속성: 여자·남자·검사 등 익명 호칭으로 등장한 인물은 자신을 소개하거나, 이미 아는 인물이 호명하거나, 이름을 알게 되는 작중 근거가 나온 뒤에만 나레이션과 카드에서 이름으로 바꾼다. 단순히 다음 문단·비트가 됐거나 인물 이미지가 준비됐다는 이유로 등록명을 공개하지 않는다. publicName·registeredName 목록 자체는 이름을 알게 된 근거가 아니다. lastWrittenName과 앞 본문의 호칭을 이어 쓴다. 작품의 시점 및 더 강한 정체 비공개 조건을 지킨다.',
      '매 대사마다 주석을 쓴다. 앞 화자를 이어받거나 교대 순서·주변 이름으로 추측하지 않는다. 여러 익명 인물은 단발 여자, 긴 머리 여자처럼 구별 가능한 공개 호칭을 쓴다. 문자·채팅은 작성자를 지정한다. 누구도 현재 말하지 않은 사물·메모·간판, 속마음·회상·중첩 인용은 ⟦Q⟧로 구분한다. 화자를 모르면 ⟦N:화자 미확인⟧을 쓴다.',
      '주석은 인용의 여는 따옴표 바로 앞에만 쓴다. 등록명·인물 ID·화자 목록을 본문이나 문단 뒤에 출력하지 않는다. 이미지 선정을 위해 집필한 화자를 바꾸지 않는다.',
