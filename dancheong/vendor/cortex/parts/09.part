  function renderAdjudicationDelayV13915(node){
    const op=activeAdjudicationWaitV13915;if(!op||!ownsAdjudicationWaitV13915(op)||!op.offered)return false;
    node.hidden=false;node.replaceChildren();const message=document.createElement('p');message.textContent=op.retry?'기존 요청의 대기를 종료하고 같은 판정을 다시 요청합니다.':'판정 응답이 지연되고 있습니다. 계속 기다리거나 현재 판정을 다시 요청할 수 있습니다. 본문은 보존됩니다.';node.append(message);
    for(const [label,choose] of [['계속 기다리기','WAIT'],['현재 판정 재시도','RETRY']]){const button=document.createElement('button');button.textContent=label;button.disabled=op.retry;button.onclick=()=>{
      if(!ownsAdjudicationWaitV13915(op)||op.retry)return;
