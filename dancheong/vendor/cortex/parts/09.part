  }
  async function adjudicationCallV13915(turn,stage,work){
    for(;;){
      const op={turn,epoch:sessionEpoch,controller:new AbortController(),offered:false,retry:false,noticeAt:Date.now()+ADJUDICATION_DELAY_NOTICE_MS_V13915,timer:null};
      op.row={requestId:turn.id+':judgement:'+((turn.metrics.adjudicationWait?.requests.length||0)+1),stage,startedAt:new Date().toISOString(),status:'WAITING',choices:[]};
      turn.metrics.adjudicationWait=turn.metrics.adjudicationWait||{noticeAfterMs:ADJUDICATION_DELAY_NOTICE_MS_V13915,requests:[]};turn.metrics.adjudicationWait.requests.push(op.row);activeAdjudicationWaitV13915=op;
      const check=()=>{if(!ownsAdjudicationWaitV13915(op))return;if(Date.now()>=op.noticeAt){op.offered=true;renderRecoveryV1390()}else op.arm()};
      op.arm=()=>{clearTimeout(op.timer);op.timer=setTimeout(check,Math.max(0,op.noticeAt-Date.now()))};
      const onVisible=()=>{if(document.visibilityState==='visible')check()};document.addEventListener('visibilitychange',onVisible);window.addEventListener('pageshow',check);op.arm();
