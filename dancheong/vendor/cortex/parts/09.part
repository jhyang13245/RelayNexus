  function temporalNarrativeBridgeDirectiveV267(txn){
    const bridge=txn?.temporalAuthority?.narrativeBridge;if(!bridge)return '';
    return `- [주관 시간 흡수] ${asText(bridge.requestedDurationText,'요청한 긴 시간')}을 없던 말로 만들거나 “그만큼 흐르지 않았다”라고 바로 기각하지 마라. 먼저 현재 행동을 실제로 수행하고, 그만큼 오래 지난 듯한 체감이 몸·꿈·기억·집중 가운데 장면에 맞는 원인으로 생기게 하라. 그 체감을 충분히 보존한 다음, 시계·빛·주변 상태로 객관적으로는 ${asText(bridge.objectiveDurationText,'허용된 짧은 시간')}만 흘렀음을 인물이 발견하게 하라. 이 대비는 초자연 현상이나 실제 시간 도약을 새 정사로 만들지 않는다.`
  }
  function openingContractV180(txn){
    const allowed=narrativeLatinAllowlist(txn);return [
      '너는 한국어 릴레이 소설의 첫 문단 전담 작가다. 분석·제목 없이 서사 문단 하나와 지정된 숨은 시공간 주석만 출력한다.',
      `영문 표기는 ${allowed.length?`다음 공개 고유표기만 허용한다: ${allowed.join(', ')}`:'사용하지 않는다'}.`,
      '사용자의 실제 의도, 인물 별칭·대명사, 현재 인물과 장소를 원문 전체 문맥으로 이해한다.',
      `시간 권한: ${JSON.stringify(txn?.temporalAuthority||{})}`,
      temporalNarrativeBridgeDirectiveV267(txn),
      '숫자가 없어도 졸업·평생·계절 변화처럼 의미상 장기간을 요구하는지 판단한다. 사건 잔여시간을 넘으면 즉시 행동과 심리만 보존하고 초과 기간의 완료·계절 변화·장기 몽타주는 쓰지 않는다.',
      txn?.eventEligibility?.canConsumeEventTurn===false?'현재 사건은 아직 예정 시각이 되지 않았다. 공개 전 정사 사실·필수 조건·활성 비트를 추측하거나 발생시키지 말고, 사용자 행동을 살리면서 예정 시각으로 향하는 개연성 있는 일상·준비·이동만 쓴다.':'현재 사건은 시작 자격을 충족했다. 장소 불일치는 게이트가 아니며 사건 쪽 인물·물건·연락·기한이 현재 장면으로 들어오게 한다.',
      txn?.closureControl?.closureActive===true?'종결 단계의 첫 문단이다. 기존 인과와 남은 조건만 진행하고 새로운 소리·위협·인물·사물·의문·미스터리를 열지 않는다.':'새로운 갈고리는 현재 활성 비트 범위 안에서만 허용한다. 사용자 입력·현재 공개 정사·공개 엔티티에 없는 고유 사물이나 장기 미스터리를 임의로 만들지 않는다.',
      '사용자 입력을 거부하거나 없던 일로 만들지 않는다. 아직 쓰지 않은 부분은 다음 문단이 이어 쓸 수 있게 남긴다.',
      '정사에 복귀시키기 위해 사용자의 선택을 같은 문단에서 즉시 취소하거나 반대 행동으로 뒤집지 않는다. 게임을 하기로 했다면 시작 자체를 무효화하지 말고, 정사의 압력은 그 선택을 실제로 유지한 상태에서 이후 원인으로 들어오게 한다.',
      '현재 장소에서 다른 장소로 전이하려면 일반 이동의 출발·경로·시간을 쓰거나, 공개된 세계 규칙과 현재 AVAILABLE 능력 및 충분한 자원이 허가하는 전이를 사용한다. 허가되지 않은 결과는 확정하지 않는다.',
      'inputCapabilityAuthority가 ALLOWED면 선언된 효과와 소요시간·비용 범위에서 성공시켜도 된다. DENIED면 시도와 직접 반응까지만 보존하고, UNKNOWN이면 성공을 확정하지 않는다. 비공개 능력의 정체나 조건을 추측하지 않는다.',
