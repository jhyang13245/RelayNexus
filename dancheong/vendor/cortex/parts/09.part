          const q=missing[row.index],evidence=asText(row.evidence).trim();if(evidence.length<4||!publicProse.includes(evidence))continue;
          const name=asText(row.speakerName).trim(),byName=people.filter(p=>[p.name,...p.aliases].includes(name)),person=byName.length===1?byName[0]:null;
