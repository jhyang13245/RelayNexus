  function missingDialogueV1141(turn){return dialogueQuotesV1141(turn).filter(q=>!asList(turn?.dialogueAnnotations).some(a=>!a.bindingInvalid&&(a.characterId||a.speakerName||a.quoteKind==='NON_SPEECH')&&(a.quoteText?q.quoteText===a.quoteText&&(+a.offset===q.offset||dialogueQuotesV1141(turn).filter(x=>x.quoteText===q.quoteText).length===1):+a.offset===q.offset)))}
