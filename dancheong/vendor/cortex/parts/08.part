      if(baseDelay===0&&queue.length){const proposed=received.length,allowed=window.NexusCortexSpeakerMedia?.gate(turn,received,shown,proposed)??proposed;if(allowed<=shown){renderTurns({displayOnly:true});schedule(24);return}let end=Math.min(allowed,received.length);if(end>shown&&end<received.length&&/[\uD800-\uDBFF]/u.test(received[end-1])&&/[\uDC00-\uDFFF]/u.test(received[end]))end--;if(end<=shown){renderTurns({displayOnly:true});schedule(24);return}markDisplayStarted();turn.displayText+=received.slice(shown,end);queue=Array.from(received.slice(end));checkBoundaries();renderTurns({displayOnly:true})}
else if(queue.length){/* Luna and Muse natural keep a readable single-glyph cadence even when fast generation fills the buffer. Other speed choices retain their existing pacing. */const ahead=queue.length,batch=finishing?finishProfile.batch:readableNatural?1:ahead>600?2:1;let text='',consumed=0,maxUnits=Infinity;for(let i=0;i<Math.min(batch,queue.length);i++){text+=queue[i];consumed++}const proposed=shown+text.length,allowed=window.NexusCortexSpeakerMedia?.gate(turn,received,shown,proposed)??proposed;if(allowed<=shown){renderTurns({displayOnly:true});schedule(24);return}if(allowed<proposed){text='';consumed=0;maxUnits=allowed-shown;for(let i=0;i<Math.min(batch,queue.length);i++){const glyph=queue[i];if(text.length+glyph.length>maxUnits)break;text+=glyph;consumed++}if(!text){renderTurns({displayOnly:true});schedule(24);return}}markDisplayStarted();queue.splice(0,consumed);turn.displayText+=text;checkBoundaries();renderTurns({displayOnly:true});if(finishing&&!readableNatural){schedule(finishProfile.delay);return}const after=queue.length,factor=readableNatural?(after>600?.8:after>320?.9:after>150?.96:1):(after>600?.55:after>320?.7:after>150?.85:1),unit=readableNatural?(finishing?finishProfile.delay:Math.max(36,Math.round(baseDelay*factor))):Math.max(12,Math.round(baseDelay*factor)),tail=text.slice(-1),pause=readableNatural?(/[.!?。！？]/u.test(tail)?140:/[,，]/u.test(tail)?75:/\n/u.test(tail)?180:unit):(/[.!?。！？]/u.test(tail)?Math.max(70,Math.round(baseDelay*3*factor)):/[,，]/u.test(tail)?Math.max(35,Math.round(baseDelay*1.4*factor)):/\n/u.test(tail)?Math.max(60,Math.round(baseDelay*2.2*factor)):unit);schedule(pause);return}
      if(closed&&!queue.length){turn.displayTyping=false;turn.displayText=undefined;renderTurns({displayOnly:true});disposed=true;for(const resolve of drainWaiters.splice(0))resolve();return}
      if(proseApproved&&!queue.length)return;
