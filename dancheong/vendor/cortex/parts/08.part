    if(issues.some(row=>row?.code==='PLAYER_AGENCY_CONTRADICTION'))add({code:'PLAYER_AGENCY_CONTRADICTION',severity:'ERROR',title:'사용자 선택과 본문 충돌',summary:'본문의 검증된 행동이 사용자가 요청한 선택을 취소하거나 반대로 처리한 것으로 판정됐습니다.',stage:'사용자 입력 → 본문 claim 대조 → CONTRADICTED',cause:'inputRealizations가 사용자 입력과 연결된 claim을 CONTRADICTED로 보고했습니다.',impact:'충돌한 claim의 상태 변화는 반영하지 않습니다. 사용자 선택은 사건 완료를 위한 빚으로 전환되지 않습니다.',action:'입력이 복원됐다면 다시 시도하고, 아니라면 다음 행동에서 원래 선택을 명시할 수 있습니다.'});
