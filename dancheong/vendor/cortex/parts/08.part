    if(typeof value==='object')return Object.entries(value).flatMap(([k,v])=>styleLinesV13(v,STYLE_LABEL_V13[k]||k,depth+1));
    const text=asText(value).trim();if(!text||text==='null'||text==='undefined')return [];
    return [label?`- ${label}: ${text}`:`- ${text}`];
  }
  function renderPackageStyleV13(){
    const rules=scenario?.styleRules;if(!rules||typeof rules!=='object')return [];
    const seen=new Set(),lines=[];
    for(const [key,value] of Object.entries(rules)){
      for(const line of styleLinesV13(value,STYLE_LABEL_V13[key]||key)){if(!seen.has(line)){seen.add(line);lines.push(line)}}
    }
    return lines.length?['','[작품 문체·설정 — 현재 사건 범위, 공개 원문 연속성, 사용자 요청의 인과적 처리 및 엔진 출력 규약 안에서 적용한다]',...lines.slice(0,24)]:[];
  }
  /* v1.18.1 — 수신 속도와 표시 속도를 분리한다. 모델 응답은 최대 속도로
