       narrationPerson / proseStyle / dialogueStyle / descriptionDensity
       violenceLevel / romanceLevel / statusDisclosure / customRules
     추측으로 만든 이름(narrativePerspective, sentenceStyle 등)도 남겨 둔다.
     Studio 가 필드명을 바꾸거나 다른 도구가 내보낼 때를 위한 별칭이다. */
  const STYLE_LABEL_V13={narrationPerson:'서술 시점',proseStyle:'문장 스타일',dialogueStyle:'대화 스타일',descriptionDensity:'묘사 밀도',violenceLevel:'폭력 묘사 수준',romanceLevel:'연애 요소',statusDisclosure:'상태 공개 수준',customRules:'추가 집필 규칙',narrativePerspective:'서술 시점',perspective:'서술 시점',sentenceStyle:'문장 스타일',romance:'연애 요소',playStyle:'플레이 방식',tone:'전체 분위기'};
  /* style.json 의 정확한 키 구조를 알 수 없으므로 스키마에 관대하게 읽는다.
     알려진 키는 라벨을 붙이고, 모르는 키도 문자열이면 그대로 싣는다.
     값이 객체나 배열이어도 한 겹 펼쳐서 문자열만 뽑는다.
     Studio 가 필드를 추가해도 엔진을 고치지 않아도 되게 하려는 것이다. */
  function styleLinesV13(value,label,depth=0){
