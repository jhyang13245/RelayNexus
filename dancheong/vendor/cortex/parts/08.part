  async function restore(){try{settings.apiKey=localStorage.getItem('dancheong-cortex-device-api-key-v1')||''}catch{}try{const saved=await preferredCurrentSaveV1421();storageRevisionV1390=+saved?.storageRevision||0;lastPersistedAtV1421=asText(saved?.savedAt);let source=saved?.schema===STORE_SCHEMA?saved:null,migrated=false;if(!source){const legacy=await readLegacySave();if(legacy){source=legacy;migrated=true}}if(source){restoredExistingState=true;settings={...settings,...source.settings,apiKey:settings.apiKey};for(const obsolete of ['kiwiBase','morphologyGate','semanticAssist','semanticJudge','requirementJudge'])delete settings[obsolete];source=CortexQuality.migrate(source);canonicalSession=source.canonicalSession?.schema===CortexNexusBridge.schema?source.canonicalSession:null;canonicalSession=upgradeSavedCanonicalV1315(canonicalSession,source.scenario,'RESTORE');scenario=normalizeScenario(canonicalSession||source.scenario);turns=asList(source.turns);undoLedger=CortexTurnExperience.normalizeUndoLedger(source.undoLedger);recoveryJournalV1390=asList(source.recoveryJournal);pendingRecoveryV1390=source.pendingRecovery||null;if(migrated){scenario.runtime=scenario.runtime||{};scenario.runtime.migratedFrom={schema:asText(source.__legacySchema)||LEGACY_STORE_SCHEMA,db:asText(source.__legacyDb)||LEGACY_STORE_DB,at:new Date().toISOString()}}}}catch{restoreFailedV1390=true;storageNoticeV1390('기존 저장 기록을 읽지 못했습니다. 덮어쓰기를 중단했습니다. 새로고침으로 다시 시도해 주세요.')}scenario=normalizeScenario(scenario);canonicalSession=CortexNexusBridge.fromCortexScenario(scenario,turns,canonicalSession)}
  function applyFontSize(value){const size=['small','medium','large'].includes(value)?value:'small';settings.fontSize=size;const root=document.documentElement;if(root?.dataset)root.dataset.fontSize=size;document.querySelectorAll?.('[data-font-size]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.fontSize===size)));return size}
  function engineNoticeV1320({code='',severity='WARNING',title='',summary='',stage='',cause='',impact='',action='',requirementRef=''}={}){return {schema:'CORTEX_ENGINE_NOTICE_V1',code:asText(code,'ENGINE_NOTICE'),severity:['ERROR','WARNING','INFO'].includes(asText(severity).toUpperCase())?asText(severity).toUpperCase():'WARNING',title:asText(title,'엔진 처리 알림'),summary:asText(summary),stage:asText(stage),cause:asText(cause),impact:asText(impact),action:asText(action),requirementRef:asText(requirementRef),at:new Date().toISOString()}}
  function renderEngineNoticeV1320(row){const level=asText(row?.severity,'WARNING').toLowerCase(),details=[['단계',row?.stage],['원인',row?.cause],['영향',row?.impact],['처리',row?.action]].filter(([,value])=>asText(value));return `<section class="engine-notice ${level==='warning'?'':level}"><div class="engine-notice-head"><b>${escapeHtml(row?.title||'엔진 처리 알림')}</b><span class="engine-notice-code">${escapeHtml(row?.code||'ENGINE_NOTICE')}</span></div>${row?.summary?`<p>${escapeHtml(row.summary)}</p>`:''}${details.length?`<dl>${details.map(([key,value])=>`<dt>${key}</dt><dd>${escapeHtml(value)}</dd>`).join('')}</dl>`:''}</section>`}
  function renderEngineNoticesV1320(rows){const notices=asList(rows);return notices.length?`<aside class="engine-notice-stack" aria-label="엔진 특이사항">${notices.map(renderEngineNoticeV1320).join('')}</aside>`:''}
  function describeCommitGraphFailureV1321(graph){
    const issues=asList(graph?.issues),parts=[],refs=uniqueValues(issues.filter(row=>asText(row?.code)==='UNKNOWN_REFERENCE').flatMap(row=>asList(row?.refs)).map(value=>asText(value)).filter(Boolean)),incomplete=issues.filter(row=>asText(row?.code)==='CLAIM_ACTION_FIELDS_INCOMPLETE').flatMap(row=>asList(row?.fields)).map(value=>asText(value)),move=asList(graph?.claims).find(row=>asText(row?.actionRef)==='action:move'&&row?.verified!==true);
    if(move&&asText(move?.actuality)==='NONCOMMITTED'&&['PARTIAL','ATTEMPTED','BLOCKED'].includes(asText(move?.completionStatus)))parts.push(`이동 claim ${asText(move.claimId)}이 실제 출발·이동 중 장면인데도 actuality=${asText(move.actuality)}, completionStatus=${asText(move.completionStatus)}로 제출되어 현실의 이동으로 확정되지 않았습니다.`);
    if(refs.length)parts.push(`카탈로그에 없는 참조 ${refs.join(', ')} 때문에 관련 claim이 UNKNOWN_REFERENCE로 보류되었습니다.`);
    if(incomplete.length)parts.push(`이동·행동 필수 필드 ${uniqueValues(incomplete).join(', ')}가 빠졌습니다.`);
    if(issues.some(row=>asText(row?.code)==='PLAYER_AGENCY_UNATTESTED'))parts.push('사용자 입력의 정확한 연속 인용이 검증 claim에 연결되지 않았습니다.');
    if(issues.some(row=>asText(row?.code)==='ENTITY_DELTA_WITHOUT_VERIFIED_CLAIM'))parts.push('새 사물·인물 등록이 검증되지 않은 claim에 매달려 함께 폐기되었습니다.');
    return parts.join(' ')||'세계 변이를 주장한 claim이 본문 근거 결박·허용 참조·행동 현실성 검사 중 하나를 통과하지 못했습니다.'
  }
  function buildEngineNoticesV1320({canonAdjudication=null,commitGraph=null,graphExtractionFailed=false,transition=null,catalog=null,finalJudgeVerdict=null,visibleCommit=null,transitVerdictRebound=null}={}){const notices=[],requirements=new Map(asList(catalog?.requirements).map(row=>[asText(row?.ref),row])),add=value=>{const notice=engineNoticeV1320(value),key=`${notice.code}|${notice.requirementRef}`;if(!notices.some(row=>`${row.code}|${row.requirementRef}`===key))notices.push(notice)},label=ref=>asText(requirements.get(asText(ref))?.description,asText(ref,'알 수 없는 종결조건'));
    for(const verdict of asList(canonAdjudication?.verdicts)){const code=asText(verdict?.code).toUpperCase();if(verdict?.status!=='UNCERTAIN'||verdict?.failureStage!=='VISIBLE_EVIDENCE_REBIND'||!['EVIDENCE_NOT_FOUND','EVIDENCE_MISSING','EVIDENCE_REF_NOT_FOUND'].includes(code))continue;const cause=code==='EVIDENCE_MISSING'?'판정관이 MET의 근거를 제출하지 않았습니다.':code==='EVIDENCE_REF_NOT_FOUND'?`판정관이 반환한 근거 참조 ${asText(verdict?.failedEvidenceRef,'(빈 참조)')}가 엔진이 발급한 근거 목록에 없습니다.`:'판정관이 본문을 그대로 가리키지 않고 요약·합성한 문장을 인용했거나, 최종 공개 과정에서 해당 문장이 제외되었습니다.';add({code,severity:'WARNING',title:'종결조건 근거 재결박 실패',summary:`판정관은 “${label(verdict.requirementRef)}”을 MET으로 판단했지만, 그 사유를 화면에 확정된 본문과 다시 연결하는 단계에서 근거를 찾지 못했습니다.`,stage:'판정관 MET → 보이는 본문 재결박 → UNCERTAIN 강등',cause,impact:'이 요건은 충족으로 저장되지 않고 남은 종결조건으로 유지됩니다. 화면에 확정된 본문 자체는 보존됩니다.',action:'다음 비트에서 누적 공개 본문을 포함해 다시 판정합니다.',requirementRef:verdict.requirementRef})}
    if(canonAdjudication?.available===false){const code=asText(canonAdjudication?.code,'UNIFIED_ADJUDICATOR_UNAVAILABLE').toUpperCase();add({code,severity:'WARNING',title:'통합 판정관 응답 불가',summary:'공개 본문은 정사로 확정했지만 이번 비트의 상태 변화와 종결조건 판정을 확정하지 못했습니다.',stage:'공개 본문 보존 → 판정 미완료 → 다음 비트에서 기록 회수',cause:code==='MODEL_TIMEOUT'?'판정관 응답이 제한 시간 안에 끝나지 않았습니다.':code==='MODEL_RATE_LIMIT'?'판정관 호출이 공급자 제한에 걸렸습니다.':'판정관 응답을 유효한 구조 데이터로 해석하지 못했습니다.',impact:'근거 없는 상태 변화나 MET은 부여하지 않습니다. 화면에 표시된 본문과 비트는 그대로 보존됩니다.',action:'공개 본문을 보존하고 다음 비트에서 미확정 기록을 회수합니다. 이미 한 행동을 다시 입력할 필요는 없습니다.'})}
    if(graphExtractionFailed||asText(visibleCommit?.code)==='UNIFIED_ADJUDICATOR_UNAVAILABLE')add({code:'UNIFIED_ADJUDICATOR_UNAVAILABLE',severity:'ERROR',title:'턴 상태 판정 보류',summary:'통합 판정관이 공개 본문에서 안전한 Turn Delta를 만들지 못했습니다.',stage:'전체 본문 표시 완료 → 통합 판정 실패 → 본문·비트 정사 보존 → 구조 상태만 보류',cause:'제한시간·공급자 오류 또는 유효하지 않은 구조 응답 때문에 근거 결박된 상태 변화를 얻지 못했습니다.',impact:'독자가 읽은 본문은 전부 정사입니다. 인물·사물·위치 등 구조화 상태만 이번 비트에서 바꾸지 않습니다.',action:'공개 본문을 이어가며 다음 판정에서 미확정 기록을 회수합니다. 행동을 반복할 필요는 없습니다.'});
