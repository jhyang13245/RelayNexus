  function persist(options={}){let payload,sequence=++persistenceSequenceV1363;try{canonicalSession=CortexNexusBridge.fromCortexScenario(scenario,turns,canonicalSession);payload={schema:STORE_SCHEMA,engine:{id:ENGINE_ID,version:VERSION},savedAt:new Date().toISOString(),settings:{...settings,apiKey:undefined},canonicalSession:clone(canonicalSession),scenario:safeScenarioForStorage(scenario),turns:clone(safeTurns()),undoLedger:CortexTurnExperience.normalizeUndoLedger(undoLedger),recoveryJournal:clone(recoveryJournalV1390),pendingRecovery:clone(pendingRecoveryV1390)};const committedTurnId=asText(options?.committedTurnId);if(committedTurnId){const durableTurn=payload.turns.find(row=>asText(row?.id)===committedTurnId);if(!durableTurn)throw new Error('PERSIST_COMMITTED_TURN_MISSING');durableTurn.metrics=durableTurn.metrics||{};durableTurn.metrics.persistence={...durableTurn.metrics.persistence,schema:'CORTEX_PERSISTENCE_V2',mode:'COMMIT_BARRIER',status:'SAVED',sequence,savedAt:payload.savedAt};durableTurn.metrics.lifecycle={...durableTurn.metrics.lifecycle,schema:'CORTEX_TURN_LIFECYCLE_V1',stage:'DURABLE',turnId:committedTurnId,at:payload.savedAt}}}catch(error){return Promise.resolve({ok:false,sequence,code:asText(error?.message||error,'PERSIST_SNAPSHOT_FAILED')})}const write=()=>writePersistencePayloadV1363(payload,sequence),task=persistenceQueueV1363.then(write,write),reported=task.then(result=>{if(result.ok&&options.notifyHost!==false&&typeof window!=='undefined')window.dispatchEvent(new CustomEvent('nexus-cortex-persisted'));return {...result,savedAt:payload.savedAt}});persistenceQueueV1363=reported.then(()=>undefined,()=>undefined);return reported}
  let canonicalUpgradeV1315=null;
