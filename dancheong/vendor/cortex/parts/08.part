    const displayNotBeforeAt=Math.max(performance.now(),+options.displayNotBeforeAt||0);let queue=[],timer=0,closed=false,proseApproved=false,received='',finalText='',disposed=false,displayStarted=false;const boundaries=[],drainWaiters=[];
    turn.displayText='';turn.displayTyping=true;turn.metrics.typewriterPolicy='ADAPTIVE_APPROVED_FINISH_V268';turn.metrics.typewriterMode='LIVE_ADAPTIVE';turn.metrics.typewriterFinishPace={delayMs:finishProfile.delay,batch:finishProfile.batch};
    const checkBoundaries=()=>{const shown=asText(turn.displayText).length,elapsed=performance.now()-(+turn?.metrics?.turnStartedAt||performance.now());for(const boundary of boundaries)if(!boundary.reached&&shown>=boundary.count){boundary.reached=true;boundary.callback?.(elapsed)}};
