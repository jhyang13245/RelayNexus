  let openingFeedScenarioV290=null;
  function replaceTurnFeedV290(feed,html,opening){
    const previous=feed.querySelector(':scope > .opening-scene'),reuse=openingFeedScenarioV290===scenario&&previous?.querySelector('.prose')?.textContent===opening;
    openingFeedScenarioV290=scenario;feed.innerHTML=html;
