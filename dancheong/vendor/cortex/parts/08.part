    const world={day:+sc?.world?.day||0,time:sx(sc?.world?.time),location:sysSafePublicV8(sc,sc?.world?.location,180)},payload={lastCriticalProseTail:lastTail,immediateScene:sysSafePublicV8(sc,visible,1600),characters,relationships,emotionalResidue,activeCharacterGoals,relationshipSubtext:relationships,nextScenePressure:pressures,repetitionCooldown:styleAvoid,sceneAtmosphere:sensory,openThreads:carry.map(x=>x.statement),styleAvoid,nextCausalCandidates:candidates,styleBlueprint:{perspectiveDistance:'현재 인물의 즉각적인 감각·행동·선택에 밀착',sentenceRhythm:'행동·감각·대사의 길이를 장면 긴장에 맞춰 변주',sensoryPalette:sensory,metaphorDiscipline:'현재 장면의 실제 감각 근거 안에서만 사용하고 같은 상징을 연속 재사용하지 않는다.',endingImage:sensory.at(-1)||''},sceneArc:{sceneDelta:sysSafePublicV8(sc,frames.map(sysFrameDescriptionV6).join(' → ')||'현재 행동의 직접 결과',320),atmosphere:sensory,closingImage:sensory.at(-1)||''},longArc:{openThreads:carry.map(x=>x.statement),foreshadowDebts:[],promises:canon.entries.filter(e=>e.kind==='promise').map(e=>e.statement).slice(-6),relationshipDirections:relationships,futureCandidates:[]},continuityGraph:{canon:canon.entries.slice(-16),characters,relationships,arcs:{unresolvedThreads:carry,eligiblePayoffs:[],protectedSetups:[]},motifs:[],physical:{...world,presentCharacterIds:[...ids],inventory,destroyed,conditions,state:{consciousness:physical.consciousness,mobility:physical.mobility,lowerBodyControl:physical.lowerBodyControl,alive:physical.alive,restrained:Boolean(physical.restrained)}}}};
    return {schema:typeof CONTINUITY_CAPSULE_SCHEMA!=='undefined'?CONTINUITY_CAPSULE_SCHEMA:SYS_CONTINUITY_SCHEMA_V8,engine:{id:typeof ENGINE_ID!=='undefined'?ENGINE_ID:'cortex',version:typeof VERSION!=='undefined'?VERSION:'1.12.0'},profile:sysCapsuleProfileV9(sc),createdAtTurn:typeof turns!=='undefined'&&Array.isArray(turns)?turns.length:0,baseRevision:sysCapsuleRevisionV9(sc),canonHash:sysCapsuleHashV9(sc),eventCursor:sysCapsuleCursorV9(sc),world,source:CortexContract.contractSource,producerSource:sysSafePublicV8(sc,source,80),payload};
  }
  function sysValidateContinuityCapsuleV9(sc,capsule){const errors=[],expectedSchema=typeof CONTINUITY_CAPSULE_SCHEMA!=='undefined'?CONTINUITY_CAPSULE_SCHEMA:SYS_CONTINUITY_SCHEMA_V8;if(!capsule||capsule.schema!==expectedSchema)errors.push('SCHEMA');if(capsule?.profile!==sysCapsuleProfileV9(sc))errors.push('PROFILE');if(capsule?.baseRevision!==sysCapsuleRevisionV9(sc))errors.push('REVISION');if(capsule?.eventCursor!==sysCapsuleCursorV9(sc)||capsule?.canonHash!==sysCapsuleHashV9(sc))errors.push('CURRENTNESS');if(capsule?.source!==CortexContract.contractSource)errors.push('SOURCE');const payload=capsule?.payload||{},immediate=sx(payload.immediateScene),physical=payload?.continuityGraph?.physical||{};if(immediate.includes('[object Object]')||immediate.length>1600||/<\/?[a-z][^>]*>/iu.test(immediate))errors.push('IMMEDIATE_SCENE');if(capsule?.world?.location!==physical.location||capsule?.world?.time!==physical.time||capsule?.world?.day!==physical.day)errors.push('PHYSICAL_WORLD');const characters=sl(payload.characters),ids=characters.map(v=>v?.id);if(new Set(ids).size!==ids.length||characters.some(v=>!v?.id||!v?.name||v?.present!==true))errors.push('CHARACTERS');const pressures=sl(payload.nextScenePressure);if(pressures.length<1||pressures.length>3||pressures.some(v=>!v?.id||!v?.statement))errors.push('PRESSURE');if(!Array.isArray(payload.relationshipSubtext)||!Array.isArray(payload.activeCharacterGoals)||!Array.isArray(payload.repetitionCooldown))errors.push('COMPAT_FIELDS');try{if(typeof containsProtected==='function'&&containsProtected(sc,JSON.stringify({characters,pressures,threads:payload?.continuityGraph?.arcs?.unresolvedThreads||[]})))errors.push('PROTECTED')}catch{}return {valid:errors.length===0,errors:su(errors)}}
  function sysContinuityCapsuleIsCurrentV9(sc,capsule){return sysValidateContinuityCapsuleV9(sc,capsule).valid}
  function sysNarrativeCapsuleForTurnV9(sc){const capsule=sc?.runtime?.nextTurnContinuityCapsule;if(sysContinuityCapsuleIsCurrentV9(sc,capsule)){try{telemetry.capsuleStatus='V9 HIT'}catch{}return capsule}const previous=Boolean(capsule),last=sysSafePublicV8(sc,sc?.runtime?.sceneContinuity?.lastText,1600);if(previous||last||(typeof turns!=='undefined'&&Array.isArray(turns)&&turns.length)){const rebuilt=sysContinuityCapsuleV8(sc,{blocks:[]},{},last,previous?'stale_rebuild':'deterministic_first_handoff');try{telemetry.capsuleStatus='V9 SAFE REBUILD'}catch{}return rebuilt}try{telemetry.capsuleStatus='MISS'}catch{}return null}
  function sysScheduleContinuityV9(sc,turn,visible=''){try{if(typeof cancelLiteraryCapsuleJob==='function')cancelLiteraryCapsuleJob('systemic_v9_deterministic')}catch{}const started=(typeof performance!=='undefined'&&performance.now)?performance.now():Date.now(),capsule=sysContinuityCapsuleV8(sc,turn,{},visible,'deterministic_continuity_v9'),check=sysValidateContinuityCapsuleV9(sc,capsule);sc.runtime=sc.runtime||{};if(check.valid){sc.runtime.nextTurnContinuityCapsule=capsule;sc.runtime.literaryCapsuleJob={jobId:`systemic-${stableHash(`${sysCapsuleProfileV9(sc)}|${capsule.canonHash}|${capsule.createdAtTurn}`)}`,status:'READY',profile:capsule.profile,canonHash:capsule.canonHash,baseRevision:capsule.baseRevision,eventCursor:capsule.eventCursor,createdAtTurn:capsule.createdAtTurn,source:'systemic_v9_no_extra_api'};if(turn)turn.literaryCapsulePrepared=capsule}else{delete sc.runtime.nextTurnContinuityCapsule;sc.runtime.literaryCapsuleJob={status:'FAILED',reason:check.errors.join('|'),source:'systemic_v9_no_extra_api'}}const elapsed=Math.max(0,((typeof performance!=='undefined'&&performance.now)?performance.now():Date.now())-started);try{telemetry.capsuleBuildMs=elapsed;telemetry.capsuleStatus=check.valid?'V9 READY':'V9 REJECTED'}catch{}if(turn)turn.metrics={...(turn.metrics||{}),literaryCapsuleBuildMs:elapsed,literaryCapsuleStatus:check.valid?'V9 READY':'V9 REJECTED',literaryCapsuleSource:'systemic_v9_no_extra_api',...(check.valid?{}:{literaryCapsuleErrors:check.errors})};try{if(typeof persist==='function')persist();if(typeof renderTelemetry==='function')renderTelemetry()}catch{}return check.valid?capsule:null}
  function sysPublicWriterContextV8(sc,canonCapsule=null){
    const graph=sysPresenceGraph(sc),ids=new Set(graph.presentCharacterIds.map(id=>sysPublicIdV8(sc,id,'actor'))),people=[sc?.protagonist,...sl(sc?.characters)].filter(Boolean),presentCharacters=people.map(c=>sysPublicCharacterV8(sc,c)).filter(c=>c&&ids.has(c.id)),continuity=sc?.runtime?.sceneContinuity||{},cap=sysNarrativeCapsuleForTurnV9(sc),packageContract=sysPackageContractV9(sc);
    return {schema:SYS_CONTEXT_SCHEMA_V8,title:sysSafePublicV8(sc,sc?.title,160),genre:sysSafePublicV8(sc,sc?.genre,120),tone:sysSafePublicV8(sc,sc?.tone,240),protagonist:sysPublicCharacterV8(sc,sc?.protagonist),presentCharacters,relationships:sysPublicRelationshipsV8(sc,[...ids]),world:{day:+sc?.world?.day||0,time:sx(sc?.world?.time),location:sysSafePublicV8(sc,sc?.world?.location,180)},continuity:{lastText:sysSafePublicV8(sc,continuity.lastText,1200),lastLocation:sysSafePublicV8(sc,continuity.lastLocation,180),lastWorldTime:sx(continuity.lastWorldTime||sc?.world?.time),stateFacts:sl(continuity.stateFacts).map(v=>sysSafePublicV8(sc,v,220)).filter(Boolean).slice(-8)},canonCapsule:sysPublicCanonV8(sc,canonCapsule),event:sysCurrentEventPublicV8(sc),narrativeCapsule:cap, ...(packageContract?{packageContract}:{}),narrativeContract:sysNarrativeContractV9(sc),systemic:{schema:SYS_SCHEMA,contextSchema:SYS_CONTEXT_SCHEMA_V8,koreanContextSchema:SYS_KOREAN_CONTEXT_SCHEMA,eventPhase:sysEventPhase(sc),motifDiscipline:sysMotifDirective(sc,''),futureEventContextWithheld:sysEventPhase(sc)==='WAITING_FOR_START',policyAuthority:'SYSTEMIC_V14_NATIVE_PACKAGE_FIDELITY'}};
  }
  try{publicWriterContext=function(sc,canonCapsule=null){return sysPublicWriterContextV8(sc,canonCapsule)}}catch{}
  try{createContinuityCapsuleV3=function(sc,turn,candidate={},visible='',source=CortexContract.contractSource){return sysContinuityCapsuleV8(sc,turn,candidate,visible,source)}}catch{}
  try{validateContinuityCapsuleV3=function(sc,capsule){return sysValidateContinuityCapsuleV9(sc,capsule)}}catch{}
  try{continuityCapsuleIsCurrent=function(sc,capsule){return sysContinuityCapsuleIsCurrentV9(sc,capsule)}}catch{}
  try{narrativeCapsuleForTurn=function(sc){return sysNarrativeCapsuleForTurnV9(sc)}}catch{}
  try{scheduleLiteraryCapsuleV2=function(sc,turn,visible){return sysScheduleContinuityV9(sc,turn,visible)}}catch{}
  function sysWriterPromptContextV8(sc,txn){const c=sysPublicWriterContextV8(sc,txn?.writerContext?.canonCapsule||null),candidate=txn?.writerContext?.narrativeCapsule;return {...c,narrativeCapsule:candidate&&sysContinuityCapsuleIsCurrentV9(sc,candidate)?candidate:c.narrativeCapsule}}
  /* v1.12.0 — 장면 브리핑 렌더러.
     narrativePlan·literaryPolicy 는 v1.11.1 에서도 존재했지만 JSON 으로 직렬화되어
     기계 계약과 같은 층에 섞여 있었다. 사람이 읽는 한국어 지시문으로 컴파일해 앞에 세우고,
     타입 정보는 뒤쪽 기계 부록으로 격리한다. */
  function sysNarrativeBriefingV12(sc,txn){
    const lp=sysLiteraryPolicy(sc,txn),plan=sysNarrativePlan(sc,txn),ctx=sysWriterPromptContextV8(sc,txn),out=[];
    out.push('[이번 장면]');
    const head=[sx(ctx?.title),sx(ctx?.genre),sx(ctx?.tone)].filter(Boolean).join(' · ');
    if(head)out.push(`작품의 결: ${head}`);
    out.push(`작중 시각은 ${sx(ctx?.world?.day)}일차 ${sx(ctx?.world?.time)}, 장소는 ${sx(ctx?.world?.location)}이다.`);
    const pro=ctx?.protagonist;
    if(pro)out.push(`시점 인물은 ${sx(pro.name)}이다.${sx(pro.voice)?` 말투와 태도 — ${sx(pro.voice)}`:''}`);
    const npc=sl(ctx?.presentCharacters).filter(c=>c&&sx(c.id)!==sx(pro?.id));
    if(npc.length)out.push(`지금 이 자리에 실제로 있는 인물: ${npc.map(c=>`${sx(c.name)}${sx(c.relationshipToProtagonist)?`(${sx(c.relationshipToProtagonist)})`:''}${sx(c.voice)?` — ${sx(c.voice)}`:''}`).join(' / ')}. 여기 없는 인물은 말하게 하지 마라.`);
    else out.push('지금 이 자리에 다른 인물은 없다. 대화를 만들려고 사람을 불러오지 마라.');
    const rel=sl(ctx?.relationships).map(r=>sx(r?.summary||r?.description||r?.label)).filter(Boolean).slice(0,4);
    if(rel.length)out.push(`관계: ${rel.join(' / ')}`);
    const last=sx(ctx?.continuity?.lastText);
    if(last)out.push(`직전 장면의 마지막 대목 — ${last.slice(-320)}`);
    const facts=sl(ctx?.continuity?.stateFacts).map(value=>sx(value)).filter(Boolean);
    if(facts.length)out.push(`지금 유효한 상태: ${facts.join(' / ')}`);
    /* v1.12.2 — 사건 요약은 '사건 전체의 진행 계획'이다. 그것을 첫 턴에 주면 작가가 한 턴에 다 쓴다.
       실제 로그에서 요약이 "꿈 → 학교 소음 → 서현의 장난 → 사물함 → 첫 쪽지 발견"이었고
       작가는 사용자의 '거실로 나온다' 한 줄에 그 전부를 실행했다.
       종결 압력 구간에 들어가기 전까지는 사건의 전개 계획을 작가에게 주지 않는다. */
    let closureV122=null;try{closureV122=sysClosureState(sc,'',txn)}catch{}
    /* v1.13.0 — 단계별 공개 범위. 사건 요약은 '사건 전체의 진행 계획'이라
       공개 단계 전에 주면 작가가 한 턴에 다 쓴다. 실제 로그의 첫 턴 폭주가 그 결과였다. */
    const phaseV13=sx(txn?.beatPhase)||SYS_BEAT_PHASE_V13.FREE;
    if(sysPhaseAllowsGoalsV13(phaseV13)){
      if(sx(ctx?.event?.summary))out.push(`지금 벌어지고 있는 일: ${sx(ctx.event.summary)}`);
      if(sx(ctx?.event?.nextBeat))out.push(`이 국면이 나아가야 할 방향: ${sx(ctx.event.nextBeat)}`);
      if(phaseV13===SYS_BEAT_PHASE_V13.HARD)out.push('이 장면에서 사건을 닫는다. 새 갈등이나 새 인물을 만들지 말고 남은 것만 실제로 벌어지게 해라.');
      else if(phaseV13===SYS_BEAT_PHASE_V13.RECOVERY)out.push('사건의 마감이 임박했다. 사용자의 선택을 취소하지 말고, 지금 위치와 시간에서 가능한 경로로 남은 일이 닿게 해라.');
    }else{
      /* v1.13.0 — 연출 의무가 열려 있으면 억제 문구를 쓰지 않는다.
         "반드시 보여 줘야 하는 것"과 "소재를 앞당기지 마라"가 함께 나가면 모델은 뒤엣것을 따른다.
         감춰야 할 것은 아직 오지 않은 발견·정답이지, 이 장면이 지금 보여 줘야 할 설정이 아니다. */
      const hasOpenDirective=sl(closureV122?.audit?.evidence).some(r=>r?.directive&&r?.ok===false);
      if(hasOpenDirective)out.push('위에 적힌 "반드시 성립해야 하는 것"은 이번 장면에서 실제로 써야 한다. 아직 오지 않은 발견이나 정답만 앞당기지 않으면 된다.');

      else if(phaseV13===SYS_BEAT_PHASE_V13.GUIDED)out.push('사용자의 행동을 그대로 살리되, 그 결과가 이 사건 쪽으로 한 걸음 기울게 해라. 다만 사건의 핵심 소재나 답을 직접 꺼내지는 마라.');
      else out.push('이 장면은 아직 사건의 초입이다. 사용자의 행동과 그 직접 결과만 써라. 사건의 핵심 소재·발견·결말을 앞당기지 마라.');
    }
    /* v1.33.0/v1.36.4 — 위치 게이트와 그 복구 계층은 폐지됐다.
       사건은 시각이 되면 시작하고, 무대 불일치는 연출 정보(stageMismatch)로만 온다. */
    const restaging=txn?.eventEligibility?.restaging;
    if(txn?.eventEligibility?.stageMismatch&&restaging){
      const stage=asText(restaging.eventLocation||sc?.event?.canonLocation,'사건의 무대'),here=asText(sc?.world?.location,'지금 있는 곳');
      out.push('');out.push('[사건이 여기로 온다]');
      out.push(`이 사건의 기본 무대는 ${stage}이지만 한시우는 지금 ${here}에 있다. 사건은 주인공을 기다리지 않는다 — 이번 턴 안에 사건이 실제로 시작된다.`);
      out.push('둘 중 하나를 골라라. (가) 사건과 얽힌 사람·물건·연락·기한 중 하나가 지금 이곳으로 도착해 사건의 첫 비트가 여기서 벌어진다. (나) 사용자의 행동을 그대로 치른 뒤 그 흐름 안에서 주인공이 무대로 이동해 사건이 열린다.');
      out.push('사용자의 행동을 취소하거나 되감지 마라. 그 행동이 사건과 부딪히면 부딪히는 대로 써라. 어느 쪽이든 이 턴이 끝날 때 사건은 이미 시작돼 있어야 한다.');
    }
    /* v1.30.0 — 작가 기억 창 사용 지시. 계약은 짧게, 원문은 payload.sceneContext.recentProse에 있다. */
    const memory=txn?.writerMemory;
    if(asList(memory?.recentProse?.turns).length){out.push('');out.push('[이전 턴 원문 — sceneContext.recentProse]');
      out.push('직전 몇 턴의 본문이 원문 그대로 실려 있다. 거기 쓰인 것은 이미 일어난 일이다. 그 흐름·감정·미해결 상태를 그대로 이어 쓰고, 앞선 턴이 끝난 지점에서 시작하라. 원문을 다시 옮겨 쓰거나 요약해서 되풀이하지 마라.');
      out.push('원문에 나온 인물·물건·상처·약속·긴장은 잊지 않는다. 다음 턴이 몇 사건 뒤라도 그 결과가 살아 있어야 한다.')}
    const digests=memory?.episodeDigests;
    if(asList(digests?.episodes).length||asList(digests?.chapters).length||asList(digests?.volumes).length){out.push('');out.push('[지난 이야기 — sceneContext.episodeDigests]');
      out.push('episodes: 최근 사건들의 상세(사용자의 선택, 시작·끝 문단, 해결·미해결). pending: 아직 챕터로 묶이지 않은 사건들의 한 줄. chapters: 지난 챕터의 통합 요약(현재 장면과 관련된 것과 최근 것만). volumes: 더 오래된 시기의 큰 흐름.');
      out.push('그 사건의 인물이나 결과가 다시 등장하면 그때의 사실과 어긋나지 않게 쓴다. unresolvedThreads·미해결 요건은 아직 살아 있는 실이다. 요약에 없는 세부를 지어내지 마라 — 세부가 필요하면 정사 캡슐(canonCapsule)의 확정 사실을 따른다.');
      out.push('챕터·볼륨의 summary·majorChoices·characterChanges·unresolvedThreads는 서사 보조 기억이지 정사 권위가 아니다. confirmedChanges와 canonCapsule만이 확정 사실이며, 둘이 어긋나면 확정 사실을 따른다.')}
    const transit=sc?.world?.transit;
    if(transit?.destinationLabel){out.push('');out.push('[직전 턴이 끝난 지점]');
      out.push(`한시우는 지금 ${sx(transit.fromLabel)||'직전 장소'}에서 ${sx(transit.destinationLabel)}(으)로 가는 중이다. 이번 장면은 그 이동의 연속으로 시작한다.`);
      out.push('직전 턴 마지막 문장 이후부터 써라. 사건의 정식 장소나 집 현관으로 되감아 다시 출발하지 마라 — 이미 떠났다.');
      out.push('도착을 서둘러 건너뛰지도 마라. 걸어가는 동안의 장면이 이번 턴의 몫이면 그것을 써라.')}
    const moves=sl(plan?.sceneMoves).map(m=>sx(m?.instruction)).filter(Boolean);
    if(moves.length){out.push('');out.push('[이번 턴에 할 것 — 이 순서로]');moves.forEach((m,i)=>out.push(`${i+1}. ${m}`))}
    const eff=sl(txn?.expectedEffects).map(value=>sx(value)).filter(Boolean);
    if(eff.length){out.push('');out.push('[이번 턴에 실제로 성립해야 하는 것]');eff.forEach(e=>out.push(`- ${e}`))}
    /* v1.13.0 — 정사 흡수 계획을 한국어로 푼다.
       흡수는 계산되고 있었지만 기계 부록의 JSON 안에만 있었다.
       작가는 beats:["GROUND_CANON_INTERCEPT"] 를 지시로 읽지 않는다.
       그래서 흡수가 required:true 로 잡혀도 본문에는 아무 개입이 없었다.
       사용자 행동을 지우지 않으면서 정사가 끼어들 근거를 문장으로 준다. */
    if(txn?.absorptionPlan?.required){
      const grounds=su(sl(txn.absorptionPlan.grounding).map(g=>sx(g?.evidence||g?.statement||g)).filter(Boolean)).slice(0,2);
      out.push('');
      out.push('[이번 장면에 정사를 끼워 넣어라]');
      out.push('- 사용자의 행동은 그대로 실행시킨다. 취소하거나 미루지 마라.');
      out.push('- 다만 그 행동을 하는 동안 아래 정사가 장면 안에서 자연스럽게 드러나게 하라. 설명으로 붙이지 말고 인물이 보고 겪는 것으로 만든다.');
      grounds.forEach(g=>out.push(`  · ${g}`));
      if(sx(txn.absorptionPlan.deferredGoal))out.push(`- 그러고도 남는 사용자의 의도는 뒤로 살려 둔다: ${sx(txn.absorptionPlan.deferredGoal)}`);
    }
    out.push('');
    out.push('[이 장면을 쓰는 방식]');
    if(sx(lp?.modeGuidance))out.push(`- ${sx(lp.modeGuidance)}`);
    if(sx(lp?.emotionalArc))out.push(`- ${sx(lp.emotionalArc)}`);
    sl(lp?.scenePrinciples).map(value=>sx(value)).filter(Boolean).forEach(v=>out.push(`- ${v}`));
    if(sx(lp?.dialogue?.rule))out.push(`- ${sx(lp.dialogue.rule)}`);
    /* v1.13.0 — 대사가 필요한 장면이면 화자와 상한을 명시한다. */
    if(txn?.dialoguePlan?.required){
      const speakersV13=sl(txn.dialoguePlan.allowedSpeakers).filter(s=>s&&sx(s.id)!==sx(ctx?.protagonist?.id));
      out.push('- 이 장면에는 대사가 있어야 한다. 서술로 요약하지 말고 인물이 따옴표 안에서 실제로 말하게 하라.');
      if(speakersV13.length)out.push(`- 말할 수 있는 인물: ${speakersV13.map(s=>`${sx(s.surfaceName)}${sx(s.voice)?`(${sx(s.voice)})`:''}`).join(' / ')}`);
      out.push(`- 한 인물이 연달아 ${+txn.dialoguePlan.maxLinesPerSpeaker||3}줄을 넘겨 말하지 않는다. 길어지면 상대의 반응이나 행동으로 끊어라.`);
      out.push('- 인물마다 말투와 어휘가 달라야 한다. 이름을 지워도 누가 말했는지 알 수 있어야 한다.');
    }
    if(sx(lp?.exposition?.rule))out.push(`- ${sx(lp.exposition.rule)} 이번 턴에 새로 밝힐 중요한 사실은 최대 ${+lp?.exposition?.maxNewMajorFacts||1}개다.`);
    if(sx(lp?.longArc?.rule))out.push(`- ${sx(lp.longArc.rule)}`);
    /* v1.12.0 — 요건은 다 찼는데 minTurns 때문에 사건이 아직 안 닫히는 구간.
       지시가 없으면 모델이 같은 소재를 되풀이한다. 여운으로 채우게 한다. */
    if(closureV122?.audit?.ok&&!closureV122.closeEligible)out.push('- 이 사건에서 해야 할 일은 이미 다 이루어졌다. 새 사건이나 새 갈등을 만들지 말고 방금 일어난 일의 여파와 인물의 반응으로 장면을 채워라. 이미 확정된 사실을 다시 설명하지 마라.');
    else if(closureV122?.pressure&&!closureV122?.audit?.ok)out.push('- 이 사건은 곧 닫혀야 한다. 새 갈등을 늘리지 말고 아직 남은 것을 이번 장면 안에서 실제로 벌어지게 해라.');
    /* avoid 는 {label,key} 객체 배열이다. 그대로 문자열화하면 [object Object] 가 된다. */
    /* v1.13.0 — 직전 턴 문체 감사 결과를 예방 지시로 받는다.
       재작성으로 되돌리는 대신 다음 턴에 같은 실수를 반복하지 않게 한다. 호출은 늘지 않는다. */
    for(const code of su(sl(sc?.runtime?.literaryLedger?.lastIssues).map(v=>sx(v).split(':')[0]))){
      if(code==='LITERARY_BODY_REPEAT')out.push('- 직전 턴에서 같은 신체 부위를 세 번 넘게 썼다. 이번에는 손·시선·숨에 기대지 말고 다른 방식으로 인물을 드러내라.');
      else if(code==='LITERARY_NO_INTERIORITY')out.push('- 직전 턴은 동작만 이어지고 인물의 생각이 없었다. 이번에는 인물이 무엇을 알아차리거나 판단을 바꾸는 대목을 반드시 넣어라.');
      else if(code==='LITERARY_FLAT_EMOTION')out.push('- 직전 턴은 감정을 이름으로 부르고 끝냈다. 이번에는 그 감정이 무엇이었는지 한 겹 더 파고들어라.');
      else if(code==='LITERARY_REPORTIVE')out.push('- 직전 턴에 보고체 문장이 많았다. 이번에는 인물이 겪고 판단하는 문장으로 써라.');
      else if(code==='LITERARY_REPETITION')out.push('- 직전 턴과 내용이 겹쳤다. 이번에는 새로 일어나는 일로만 장면을 채워라.');
      else if(code==='LITERARY_CLOSING_ECHO')out.push('- 최근 턴들과 마무리가 비슷했다. 이번에는 다른 방식으로 닫아라.');
    }
    const avoid=su(sl(sysMotifDirective(sc,sx(txn?.intent?.raw))?.avoid).map(x=>sx(x?.label||x?.key||x)).filter(Boolean));
    if(avoid.length)out.push(`- 최근 반복한 다음 표현·상징은 이번 턴에 다시 쓰지 마라: ${avoid.join(', ')}`);
    const t=txn?.guards||{};
    if(sx(t.forbidTimeBefore)&&sx(t.forbidTimeAfter))out.push(`- 이번 턴의 시간은 ${sx(t.forbidTimeBefore)}에서 시작해 ${sx(t.forbidTimeAfter)}를 넘지 않는다. 그 뒤의 일은 쓰지 마라.`);
    if(sysEventPhase(sc)==='WAITING_FOR_START')out.push('- 아직 시작되지 않은 예약 사건의 인물·물품·장소·정답을 앞당겨 꺼내지 마라.');
    return out.join('\n');
  }
