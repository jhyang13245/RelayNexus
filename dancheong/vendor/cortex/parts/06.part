    let h,mi,raw=m[0];if(m.length>=4&&m[2]!=null){h=+m[2];mi=+(m[3]||0);if(m[1]==='오후'&&h<12)h+=12;if(m[1]==='오전'&&h===12)h=0}else{h=+m[1];mi=+m[2]}
