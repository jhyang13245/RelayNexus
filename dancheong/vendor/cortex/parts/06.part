  function sysCarryKey(x){return `${sx(x?.kind)}|${sn(x?.eventRef)}|${sn(x?.beatRef)}|${sn(x?.statement)}`}
  function sysReconcileCarryover(sc,txn={},ending={},visible=''){
    sc.runtime=sc.runtime||{};const turnNo=(typeof turns!=='undefined'&&Array.isArray(turns)?turns.length:0)+1,eventRef=sx(sc?.event?.id),evidence=sysEvidenceText(sc,visible);let ledger=sl(sc.runtime.carryoverLedger).map(x=>({...x})).filter(Boolean);
