  const SYS_DIRECT_REFUSAL_RE=/(?:싫(?:어|습니다|다)|거절(?:할게|합니다|했다)|하지\s*않겠|안\s*(?:갈|할|먹|받)|못\s*(?:갑|합|하겠|가겠))/u;
