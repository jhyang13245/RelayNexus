  function sysEventEvidenceV5(sc,current=''){const pieces=[];if(sc?.runtime?.openingCommit?.text)pieces.push(sc.runtime.openingCommit.text);pieces.push(...sl(sc?.event?.runtimeEvidence),current);return pieces.map(value=>sx(value)).filter(Boolean).join(' ')}
  sysEvidenceText=sysEventEvidenceV5;
  const sysRequirementSatisfiedV4=sysRequirementSatisfied;
  /* v1.12.1 — 상태 요건은 상태 객체를 직접 비교한다.
     v1.12.0 까지는 storyState·world·canonLedger 를 JSON 문자열로 만들어
     본문 증거와 같은 자리에 섞었다. 그러면 필드 이름·따옴표·중괄호까지 토큰으로 잡혀
     아직 일어나지 않은 일이 문자열 일치만으로 충족 처리될 수 있었다.
     이제 타입별로 의미 있는 값만 뽑아 요건 문장과 대조하고,
     의미 판정에는 본문 증거만 넘긴다. JSON 직렬화 경로는 완전히 제거한다. */
  function sysStateValuesV121(type,sc){
    const out=[];
