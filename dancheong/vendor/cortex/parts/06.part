  function sysInvariantAudit(sc,txn,text,blocks=[]){const issues=[],phase=sysEventPhase(sc),chrono=sysChronologyIssue(text,txn),state=sysStateIssue(text,txn,sc),future=sysFutureLeak(text,txn,sc),motif=sysMotifIssue(sc,text,txn?.intent?.raw);if(chrono)issues.push(`TIME_CONTINUITY:${chrono}`);if(state)issues.push(`STATE_CONTINUITY:${state}`);if(future)issues.push(future);if(motif)issues.push(motif);issues.push(...sysRealizationIssues(txn?.intent?.raw,txn,text));const graph=sysPresenceGraph(sc,text,blocks,{authorizedEntityRefs:sysInputPresenceLicenseV171(sc,txn)}),present=new Set(graph.presentCharacterIds);for(const b of sl(blocks))if(b?.kind==='dialogue'&&b?.speakerId&&!sysSpeakerPresent(sc,present,b.speakerId))issues.push(`OUT_OF_SCENE_DIALOGUE:${b.speakerId}`);if(phase==='WAITING_FOR_START'&&txn?.eventPatch?.advanceAtCommit)issues.push('EVENT_FSM:WAITING_CANNOT_ADVANCE');const timelineEnd=blocks?.at(-1)?.sceneEnd;if(timelineEnd&&txn?.guards?.forbidTimeAfter&&parseClock(timelineEnd)>parseClock(txn.guards.forbidTimeAfter)&&(((txn?.corridor?.endDay??txn?.start?.day??0))===(txn?.start?.day||0)))issues.push('TIME_CONTINUITY:BLOCK_AFTER_CORRIDOR');return {schema:SYS_INVARIANT_SCHEMA,phase,issues:su(issues),presence:graph,actionFrames:sclone(txn?.intent?.actionFrames||[]),motif:sysMotifDirective(sc,txn?.intent?.raw)}}


  function sysParseDuration(text){
