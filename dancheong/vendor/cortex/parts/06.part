      const destroyed=su(sl(sc?.runtime?.canonLedger?.entries).filter(e=>e?.active!==false&&sx(e?.kind)==='destruction').map(e=>sn(sx(e?.targetName||e?.value))).filter(Boolean));
      const push=v=>{const value=sx(v);if(value&&!destroyed.includes(sn(value)))out.push(value)};
      for(const item of sl(sc?.runtime?.storyState?.inventory||sc?.storyState?.inventory))push(item?.name||item?.title||
item?.label||item?.id||item);
      for(const e of sl(sc?.runtime?.canonLedger?.entries)){if(e?.active===false||sx(e?.kind)!=='inventory_add')continue;push(e?.targetName||e?.value)}
    }else if(type==='RELATIONSHIP_STATE'){
      for(const r of sl(sc?.runtime?.storyState?.relationships||sc?.storyState?.relationships))out.push(sx(r?.summary||r?.status||r?.label||r?.value||r));
      for(const r of sl(sc?.relationships))out.push(sx(r?.publicSummary||r?.publicStatus||r?.status));
    }else if(type==='WORLD_STATE'){
      out.push(sx(sc?.world?.location));
      for(const f of sl(sc?.runtime?.sceneContinuity?.stateFacts))out.push(sx(f));
      for(const s of sl(sc?.runtime?.eventLedger?.sealed))if(sx(s?.outcome)!=='FAILURE')out.push(sx(s?.title));
    }
    return su(out.filter(Boolean));
