  function sysRefusal(text){return /(?:하지\s*않|안\s*(?:할|간|가|하|먹|받|보|만나)|싫(?:다|어|다니까)?|거부|필요\s*없|관두|포기하|무시하|생까|상관\s*없)/u.test(sx(text))}
  function sysWorldAssertion(text){return /(?:사실은|원래부터|실은|이미\s+.+(?:였다|이다|있다)|내가\s+정한다|그건\s+.+(?:이다|였다))/u.test(sx(text))}
  function sysRomanceIntent(text){return /(?:고백|키스|입맞춤|데이트|연애|사랑한다고|껴안|포옹|손을\s*잡고\s*걷)/u.test(sx(text))}
