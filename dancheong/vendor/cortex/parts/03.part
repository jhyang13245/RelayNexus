  function fallback(requirements=[],code='MODEL_FAILURE'){return {schema:SCHEMA,available:false,code:text(code),verdicts:list(requirements).map(row=>({requirementRef:text(row?.ref||row?.requirementRef),status:'UNCERTAIN',evidence:[],code:text(code)})).filter(row=>row.requirementRef),metCount:0,unmetCount:0,uncertainCount:list(requirements).length}}
  function absorptionDoctrine(){/* v1.25.6 — 구세대 단청(2026-08-26)의 이탈 흡수 레시피 이식. 추상 명령("개연성 있게 흡수") 대신 구체 연출법을 준다. */return ['- [이탈 흡수법] 사용자가 장면을 그만두거나 자리를 뜨려 하면, 순서대로: ① 선택을 실현한다 — 떠나겠다면 실제로 떠나게 하고 그 길을 쓴다. 이 장면에 이미 서 있던 사람·사물·상황이 막아서는 것은 실현의 일부이니 써도 된다. 금지되는 것은 근거 없는 즉시 저지다: "몇 걸음 못 가 붙잡혔다"처럼 앞선 본문·이번 입력·현재 장면 어디에도 없던 존재나 우연이 튀어나와 선택을 취소하는 서술. 저지를 쓸 때는 그 원인이 이미 놓여 있었음을 독자가 알아볼 수 있어야 하고, 막힌 뒤에도 인물의 의도와 그 대가는 장면에 남는다.','- ② 사건을 그에게 보낸다 — 셋 중 하나로, 직전 턴과 다른 것으로: 사람이 온다(인물·전화·메시지가 닿는다) / 물건이 따라온다(향한 곳의 사물·기록이 같은 단서를 드러낸다) / 기한이 닥친다(지금 하지 않으면 닫힌다는 사실이 그를 밀어낸다). 근거는 이번 입력에서 실제로 생긴 것(이동·대화·실수·소음·목격·지연)에서 먼저 찾고, 없으면 시간·환경에서 찾는다. 근거 없이 갑자기 붙이지 마라. 엇갈림(만나지 못함)은 사건당 한 번만.','- ③ 한 턴에 목적지까지 닿을 수 없으면 중간의 의미 있는 지점에서 멈춘다. 순간이동시키지 말고 목적지는 다음 턴을 위해 살려 둔다. 시간도 함께 흘려보낸다 — 이동·대기한 만큼 장면 시각을 전진시키고, 시각만 제자리에 둔 채 내용만 앞서가지 마라.'].join('\n')}
  function invariantDutyDirective(duties){const rows=list(duties).map(row=>({label:text(row?.label||row?.invariantRef),severity:text(row?.severity)})).filter(row=>row.label);if(!rows.length)return '';/* v1.27.0 — 비가역처럼 서술된 주인공 상태는 정사로 봉인되지 않았다. 되돌리는 것이 아니라, 봉인된 적 없는 해석을 정리하는 것이다. */return `\n- [불변식 수습] 앞선 비트에서 주인공의 다음 상태가 비가역처럼 서술되었으나 정사로 봉인되지 않았다: ${rows.map(row=>row.label).join(' | ')}. 이번 본문 안에서 둘 중 하나로 정리한다. ① 불발 — 그럴듯한 사유로 그 결과에 이르지 못했음이 드러난다(일시적 충격이었다, 감각이 돌아온다, 생각보다 얕았다). ② 회복 사건을 보낸다 — 사람이 온다/물건이 따라온다/기한이 닥친다 중 하나로 되돌릴 계기가 도착한다. 원래의 시도와 그 대가를 없던 일로 만들지는 마라 — 결과 해석만 정리한다. 외부가 개입해 막거나 거두어 가는 전개도 좋다. 다만 그 개입의 근거가 이미 장면에 놓여 있어야 하고, 뜬금없이 나타난 존재가 상황만 정리하고 사라지는 식이면 안 된다.`}
  function beatPressure({phase='FREE',missing=[],extensionRound=0,preservePlayerChoice=true,recoveryAlternatives=[],transitionRequired=false,invariantDuties=[]}={}){
    const rows=list(missing).map(value=>text(value)).filter(Boolean),alternatives=list(recoveryAlternatives).map(row=>text(row?.description||row)).filter(Boolean),normalized=text(phase).toUpperCase(),doctrine=absorptionDoctrine()+invariantDutyDirective(invariantDuties);
    if(transitionRequired)return '- [비트 압력 0 · 시작 전] 아직 시작하지 않은 사건의 내용과 공개 전 사실은 쓰지 않는다. 현재 행동과 이미 확정된 여파만 전개한다.';
    if(!rows.length)return '- [비트 압력 · 충족 완료] 남은 종결조건이 없다. 현재 장면의 감정과 여파를 자연스럽게 전개한다.';
    const goals=`남은 종결조건: ${rows.join(' | ')}`,choice=preservePlayerChoice?'사용자의 선택은 설명 없이 뒤집지 않는다. 필요하면 허용된 대체 경로를 쓴다.':'',alt=alternatives.length?`허용된 대체 경로: ${alternatives.join(' | ')}`:'';
    if(normalized==='FREE')return `- [비트 압력 1 · 자유] ${goals}\n- 강제하지 않는다. 인물의 감정과 동기가 자연스럽게 그 방향을 향하게 하되, 이번 본문에서 성립시키지 못해도 된다. 이탈이면 그 행동을 충분히 쓰고, 장면 끝에 사건 쪽 실마리를 하나만 놓아둔다(스치는 연락, 눈에 걸리는 물건, 멀리서 나는 소리). ${choice} ${alt}\n${doctrine}`.trim();
    if(normalized==='GUIDED'||normalized==='MODEL_DIRECTED')return `- [비트 압력 2 · 유도] ${goals}\n- 이번 장면 안에서 종결조건을 향한 실제 진전을 만든다. 입력을 인정한 뒤 내적 동기·다른 인물의 개입·환경의 강제 중 하나로 주인공을 사건 쪽으로 데려온다. 이동이 필요하면 동기→출발→경과→도착의 과정을 실제로 쓴다. ${choice} ${alt}\n${doctrine}`.trim();
    if(normalized==='CLOSURE')return `- [비트 압력 3 · 종결] ${goals}\n- 마지막 비트다. 개연성에 무리가 가지 않는 선에서 남은 종결조건을 이번 본문 안에서 모두 실제로 성립시킨다. 암시·예고·설명으로 대신하지 않는다. ${choice} ${alt}\n${doctrine}`.trim();
    if(normalized==='RECOVERY'||normalized==='EXTENSION_1'||+extensionRound===1)return `- [비트 압력 4 · 연장 1] ${goals}\n- 첫 연장이다. 부족했던 인과 과정(동기·이동·시간·도착)을 완성하고 종결조건을 실제로 성립시킨다. 새 갈등·새 미스터리를 만들지 않는다. ${choice} ${alt}`.trim();
    return `- [비트 압력 5 · 최종 연장] ${goals}\n- 마지막 기회다. 현재 장소·시간·인물 안에서 성립 가능한 가장 직접적인 경로로 남은 종결조건을 성립시키고, 성립 문장을 명시적으로 쓴다. ${alt}`.trim()}
  const api={version:VERSION,schema:SCHEMA,mode:MODE,outputSchema,statuses:[...STATUSES],developer,request,normalize,bindVerdicts,evidenceSegments,recoveryRequest,mergeLedger,fallback,beatPressure};Object.freeze(api);Object.defineProperty(globalThis,'CortexCanonAdjudicator',{value:api,writable:false,configurable:false,enumerable:true});
})();

/* v1.41.0: publication-only review. No entity registration or post-publication state projection. */
(()=>{'use strict';const MODEL='gpt-5.6-luna',PREFLIGHT_SCHEMA='CORTEX_PREPUBLICATION_SAFETY_V1';const text=(v,f='')=>v==null?f:String(v),list=v=>Array.isArray(v)?v:[],clone=v=>structuredClone(v),unique=v=>[...new Set(list(v).map(x=>text(x)))];const preflightOutputSchema={"type":"object","additionalProperties":false,"required":["schema","decision","code","unsafeSurfaces","reason","repairTarget","preserveFacts","tailDisposition","defectClass","basis","draftClaim","incompatibility"],"properties":{"schema":{"type":"string","enum":["CORTEX_PREPUBLICATION_SAFETY_V1"]},"decision":{"type":"string","enum":["PASS","REPAIR"]},"code":{"type":"string","enum":["NONE","PRIVATE_CANON_LEAK","FUTURE_CANON_LEAK","IDENTITY_LEAK","UNAUTHORIZED_SUPERNATURAL_CLUE","META_LEAK","CONTROL_TOKEN_LEAK","LANGUAGE_BREAK","OTHER_PUBLICATION_RISK","ORDER_VIOLATION","CONTINUITY_BREAK"]},"unsafeSurfaces":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":120}},"reason":{"type":"string","maxLength":240},"repairTarget":{"type":"string","maxLength":400},"preserveFacts":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":180}},"tailDisposition":{"type":"string","enum":["KEEP","REGENERATE"]},"defectClass":{"type":"string","enum":["NONE","MATERIAL_BRIDGE","DIRECT_CONFLICT","PUBLICATION_RISK"]},"basis":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["sourceId","shortQuote"],"properties":{"sourceId":{"type":"string"},"shortQuote":{"type":"string","maxLength":180}}}},"draftClaim":{"type":"string","maxLength":240},"incompatibility":{"type":"string","maxLength":240}}};
  function normalizePreflight(raw={}){const rawDecision=text(raw?.decision).toUpperCase(),rawCode=text(raw?.code).toUpperCase(),allowed=new Set(preflightOutputSchema.properties.code.enum),valid=raw?.schema===PREFLIGHT_SCHEMA&&['PASS','REPAIR'].includes(rawDecision)&&allowed.has(rawCode)&&Array.isArray(raw?.unsafeSurfaces)&&(rawDecision==='PASS'?rawCode==='NONE':rawCode!=='NONE');if(!valid)return {schema:PREFLIGHT_SCHEMA,decision:'REPAIR',code:'OTHER_PUBLICATION_RISK',unsafeSurfaces:[]};return {schema:PREFLIGHT_SCHEMA,decision:rawDecision,code:rawCode,defectClass:text(raw.defectClass,'NONE'),basis:clone(raw.basis||[]),draftClaim:text(raw.draftClaim),incompatibility:text(raw.incompatibility),reason:text(raw.reason).slice(0,240),repairTarget:text(raw.repairTarget).slice(0,400),preserveFacts:list(raw.preserveFacts).map(v=>text(v)).slice(0,8),tailDisposition:raw.tailDisposition==='REGENERATE'?'REGENERATE':'KEEP',unsafeSurfaces:unique(raw.unsafeSurfaces).slice(0,12)}}
  function previousEventEvidence(turns=[],eventId=''){
    const committed=list(turns).filter(row=>row?.status==='COMMITTED'&&text(row.text)),sourceEvent=row=>text(row.sourceEventId||row.txn?.event?.id||row.txn?.eventId||row.transition?.eventId);
    if(committed.some(row=>sourceEvent(row)===text(eventId)))return [];
    const ids=[];for(const row of [...committed].reverse()){const id=sourceEvent(row);if(id&&id!==text(eventId)&&!ids.includes(id)){ids.push(id);if(ids.length===3)break}}
    return committed.filter(row=>ids.includes(sourceEvent(row))).map(row=>({sourceRef:'BEAT:'+text(row.id),eventId:sourceEvent(row),turnId:text(row.id),text:text(row.text),current:false,previousEvent:true}));
  }

