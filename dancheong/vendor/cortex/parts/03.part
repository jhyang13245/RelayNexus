  function resolveLocationIdentity(location,ref,context={}){const rows=locationRows(context),wantedRef=text(ref).trim(),wantedLabel=text(location).trim(),byRef=rows.find(row=>text(row?.ref||row?.locationRef)===wantedRef),bySurface=rows.find(row=>[row?.label,row?.name,...list(row?.aliases)].some(surface=>key(surface)&&key(surface)===key(wantedLabel)));if(wantedRef&&!byRef)return {kind:'INVALID_REF',ref:wantedRef,label:wantedLabel,surfaces:[wantedLabel].filter(Boolean)};if(wantedRef&&byRef&&bySurface&&text(bySurface?.ref||bySurface?.locationRef)!==wantedRef)return {kind:'REF_LABEL_MISMATCH',ref:wantedRef,label:wantedLabel,row:byRef,surfaces:[byRef?.label,byRef?.name,...list(byRef?.aliases)].filter(Boolean)};const row=byRef||bySurface;if(!row)return {kind:'NEW',ref:'',label:wantedLabel,surfaces:[wantedLabel].filter(Boolean)};return {kind:'KNOWN',ref:text(row?.ref||row?.locationRef),label:text(row?.label||row?.name,wantedLabel),row,surfaces:[row?.label,row?.name,...list(row?.aliases)].filter(Boolean)}}
