  function mergeRecovery(track,raw,prose,context={}){const plan=recoveryPlan(track,prose),replacements=list(raw?.segments),rows=[];for(let i=1;i<=paragraphs(prose).length;i++){const candidates=(plan.paragraphIndices.includes(i)?replacements:plan.existingSegments).filter(r=>r.paragraphIndex===i);if(candidates.length!==1)continue;const row={...candidates[0]};if(!Object.hasOwn(row,'clockEnd')){if(!clock(row.endTime))continue;row.clockEnd={day:row.endDay,time:row.endTime};}delete row.elapsedSec;rows.push(row);}return normalize(rows,context);}
