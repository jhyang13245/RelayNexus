  function developer(mode='PARAGRAPH_SAFETY'){
    const common='너는 본문 집필자와 완전히 격리된 Cortex 판정관 Luna다. 검증·감사·판정만 한다. 본문을 다시 쓰거나 대체 문장, 전개 조언, 다음 문단, 정사 흡수 방법을 만들지 않는다. 출력은 지정된 폐쇄형 JSON뿐이며 자연어 근거를 쓰지 않는다. 제공되지 않은 미래 정사·비공개 이름·GM 정보를 추측하지 않는다. 인용문은 모절의 전언·가정·부정·미래·시도 양상을 상속하고, 턴 뒤쪽의 각성·회상 종료가 앞 문단의 현실성을 뒤집을 수 있음을 고려한다.';
    if(mode==='TURN_FINAL')return `${common}\n이번 턴 전체를 후향적으로 읽고 각 claim이 현실 세계에 실제로 성립했는지만 보수적으로 분류한다. 꿈·전언·미래·부정·실패·시도·비유는 COMMITTED가 아니다. 작가가 제출한 COMMITTED를 NONCOMMITTED 또는 UNKNOWN으로 내릴 수 있지만, 제출되지 않은 사실을 새로 승인하지 않는다. publicState.transitAuthority는 앞선 턴에서 이미 검증된 출발·이동 중 상태다. 그 목적지와 같은 곳에 통상 이동 과정 뒤 도착한 claim을 순간이동이나 SCENARIO_BREAKING으로 판정하지 않는다. publicState.eventEligibility.stageMismatch가 true면 사건의 기본 무대와 주인공의 현재 위치가 다른 것이 엔진이 인정한 정상 상태다(사건이 사용자에게 온다). 사건 인물·물건·연락이 현재 위치로 도착하거나 사건이 현재 위치에서 열리는 장면을 무대 불일치만을 이유로 SCENARIO_BREAKING이나 순간이동으로 판정하지 않는다. continuity는 다음 턴에 넘겨도 되는 본문 범위를 KEEP/SPAN/PRIOR로 지정한다.`;
    return `${common}\n현재 문단을 앞의 공개 담화 문맥과 함께 검사한다. privateShadowRisk가 있으면 그것은 작가에게 보이지 않는 비공개 엔티티 별칭과 현재 문단의 약한 문자열 충돌 후보다. matchedFragments가 우연한 일반어·다른 사물의 일부일 뿐이면 OK다. 문단이 aliases의 비공개 엔티티를 실질적으로 우회 지칭하거나 그 정체·속성을 앞당기면 WITHHOLD와 UNAUTHORIZED_ENTITY_SHADOW를 반환한다. 후보를 그대로 인용하거나 출력하지 않는다. 이 단계는 되돌릴 수 없는 누설, 메타 노출, 현재 공개 계약으로 회수 불가능한 시나리오 파괴만 WITHHOLD 또는 BREAKING으로 판정한다. 이동·획득·정사·상태 변화는 잠정이며 불확실하다는 이유로 정상 본문을 막지 않는다. claimDecisions는 비워 둔다.`
  }
  function request(mode,{rawUserInput='',paragraphIndex=0,paragraphText='',priorText='',fullText='',publicState={},catalog={},graph={},privateShadowRisk={}}={}){const final=mode==='TURN_FINAL',body=text(final?fullText:paragraphText),prior=text(priorText).slice(-3200),risk=privateRiskEnvelope(privateShadowRisk);return {developer:developer(mode),payload:{schema:'CORTEX_CONTINUITY_JUDGE_INPUT_V1',mode,rawUserInput:text(rawUserInput).slice(0,4000),paragraphIndex:Math.max(0,+paragraphIndex||0),paragraphText:final?'':body.slice(0,6000),priorPublicText:final?'':prior,fullTurnText:final?text(fullText).slice(0,18000):'',publicState:clone(publicState||{}),publicCatalog:publicCatalog(catalog),privateShadowRisk:final||!risk.candidates.length?null:risk,claims:final?publicClaims(graph):[]},schema:outputSchema}}
  function applyFinalVerdict(graph={},verdict={}){const normalized=normalize(verdict),decisions=new Map(normalized.claimDecisions.map(row=>[row.claimId,row])),holdAll=verdict?.fallbackUsed!==true&&['WITHHOLD','BREAKING'].includes(normalized.verdict),downgraded=[];const next=clone(graph);next.claims=list(next.claims).map(row=>{const decision=decisions.get(text(row?.claimId));if(!holdAll&&(!decision||decision.actuality==='COMMITTED'))return row;const actuality=decision&&decision.actuality!=='COMMITTED'?decision.actuality:'UNKNOWN',layer=decision?.layer||'UNKNOWN';downgraded.push(text(row.claimId));return {...row,actuality,confidence:'UNCERTAIN',verified:false,judgeLayer:layer}});return {graph:next,downgradedClaimIds:downgraded,verdict:normalized}}
  function reconcileTransitVerdict(graph={},verdict={},authority={}){
    /* v1.32.2 — 실전 로그에서 집→편의점 PARTIAL 이동은 이미 world.transit으로 확정됐지만,
       판정관은 다음 턴의 도착을 현재 위치(집)에서의 순간이동으로 오인해 SCENARIO_BREAKING을 냈다.
       판정관에게 권한을 주는 것만으로는 같은 오판이 재발할 수 있으므로, 오류 span이 오직
       저장된 transit의 도착 claim과 겹칠 때만 결정론적으로 되돌린다. 꿈·전언·부정처럼
       명시된 비현실 계층 결정은 그대로 보존한다. */
    const normalized=normalize(verdict,Math.max(0,+authority?.fullTextLength||Number.MAX_SAFE_INTEGER)),transit=authority?.transitAuthority||{},destination=text(transit?.destinationLocationRef),claims=list(graph?.claims),[start,end]=normalized.span,overlaps=claims.filter(row=>row?.span&&row.span.start<end&&row.span.end>start),matching=claims.filter(row=>row?.verified===true&&text(row?.actionRef)==='action:move'&&text(row?.actuality).toUpperCase()==='COMMITTED'&&text(row?.completionStatus).toUpperCase()==='COMPLETED'&&text(row?.destinationLocationRef)===destination),eligible=verdict?.fallbackUsed!==true&&normalized.verdict==='BREAKING'&&normalized.code==='SCENARIO_BREAKING'&&destination&&matching.length>0&&overlaps.length>0&&overlaps.every(row=>matching.some(move=>text(move.claimId)===text(row.claimId)));
    if(!eligible)return {verdict:{...verdict,...normalized},rebounded:false,claimIds:[]};
    const nonReality=new Set(['DREAM','REPORTED','FUTURE','NEGATED','ATTEMPT','METAPHOR']),claimIds=new Set(matching.map(row=>text(row.claimId))),claimDecisions=normalized.claimDecisions.filter(row=>nonReality.has(row.layer)||!claimIds.has(text(row.claimId))&&row.layer!=='UNKNOWN');
    return {verdict:{...verdict,...normalized,verdict:'OK',code:'NONE',span:[0,0],claimDecisions,continuity:'KEEP',continuitySpan:[0,Math.max(0,+authority?.fullTextLength||0)]},rebounded:true,claimIds:[...claimIds],original:{verdict:normalized.verdict,code:normalized.code,span:normalized.span}}
  }
  function continuityText(fullText,priorText,verdict={}){const body=text(fullText),normalized=normalize(verdict,body.length);if(normalized.continuity==='KEEP')return body;if(normalized.continuity==='SPAN'){const [start,end]=normalized.continuitySpan;if(end>start)return body.slice(start,end).trim()}return text(priorText)}
  function normalizeCircuit(value={}){return {schema:'CORTEX_JUDGE_CIRCUIT_V1',reanalyzeCount:Math.max(0,+value?.reanalyzeCount||0),maxReanalyze:Math.max(1,+value?.maxReanalyze||MAX_REANALYZE),disabled:value?.disabled===true,rateLimitCount:Math.max(0,+value?.rateLimitCount||0),failureCount:Math.max(0,+value?.failureCount||0)}}
  function recordCircuit(value,result={}){const next=normalizeCircuit(value),code=text(result?.code).toUpperCase(),uncertain=text(result?.verdict).toUpperCase()==='REANALYZE'||['MODEL_TIMEOUT','MODEL_RATE_LIMIT','MODEL_FAILURE','INVALID_OUTPUT'].includes(code);if(uncertain)next.reanalyzeCount++;if(code==='MODEL_RATE_LIMIT')next.rateLimitCount++;if(['MODEL_TIMEOUT','MODEL_FAILURE','INVALID_OUTPUT'].includes(code))next.failureCount++;if(next.reanalyzeCount>=next.maxReanalyze)next.disabled=true;return next}
  function fallback(code='MODEL_FAILURE'){return normalize({schema:SCHEMA,verdict:'REANALYZE',code,span:[0,0],claimDecisions:[],continuity:'PRIOR',continuitySpan:[0,0]})}
  function eventTurnAuthorized({verdict,graph,audit,fallbackUsed=false}={}){const judged=normalize(verdict);if(!fallbackUsed&&judged.verdict!=='OK')return false;if(list(audit?.blocking).length)return false;const blocked=new Set(list(audit?.mutationBlockedClaimIds).map(value=>text(value))),verified=new Set(list(graph?.claims).filter(row=>row?.verified===true&&!blocked.has(text(row?.claimId))&&text(row?.actuality).toUpperCase()==='COMMITTED').map(row=>text(row.claimId)));if(!verified.size)return false;return [...list(graph?.inputRealizations),...list(graph?.beatRealizations),...list(graph?.canonRealizations)].some(row=>verified.has(text(row?.claimId)))}
  const api={version:VERSION,model:MODEL,schema:SCHEMA,maxReanalyze:MAX_REANALYZE,outputSchema,normalize,publicCatalog,publicClaims,privateRiskEnvelope,request,applyFinalVerdict,reconcileTransitVerdict,continuityText,normalizeCircuit,recordCircuit,fallback,eventTurnAuthorized};Object.freeze(api);Object.defineProperty(globalThis,'CortexContinuityJudge',{value:api,writable:false,configurable:false,enumerable:true});
})();

/* Cortex v1.32.4 — isolated Luna canon adjudicator: engine-issued evidence references and typed binding. */
(()=>{'use strict';
  const VERSION='1.32.4',SCHEMA='CORTEX_CANON_ADJUDICATION_V3',MODE='REQUIREMENT_ADJUDICATION',STATUSES=['MET','UNMET','UNCERTAIN'];
  const text=(value,fallback='')=>value==null?fallback:String(value),list=value=>Array.isArray(value)?value:(value==null?[]:[value]),clone=value=>{try{return structuredClone(value)}catch{return JSON.parse(JSON.stringify(value))}};
  function findSpan(prose,quote,offset=0){const external=globalThis.CortexCommitGraph?.findEvidenceSpan;if(typeof external==='function')return external(prose,quote,offset);const body=text(prose),needle=text(quote).trim();if(!needle)return null;const at=body.indexOf(needle,Math.max(0,+offset||0));return at>=0?{start:at,end:at+needle.length,mode:'EXACT_QUOTE'}:null}
  const evidenceSchema={type:'object',additionalProperties:false,required:['evidenceRef'],properties:{evidenceRef:{type:'string',minLength:1,maxLength:200}}};
  const invariantThreatSchema={type:'object',additionalProperties:false,required:['invariantRef','status','evidenceQuote'],properties:{invariantRef:{type:'string',minLength:1,maxLength:160},status:{type:'string',enum:['NONE','THREATENED','BROKEN']},evidenceQuote:{type:'string',maxLength:240}}};
  const outputSchema={type:'object',additionalProperties:false,required:['schema','verdicts','invariantThreats'],properties:{schema:{type:'string',enum:[SCHEMA]},invariantThreats:{type:'array',maxItems:8,items:invariantThreatSchema},verdicts:{type:'array',maxItems:24,items:{type:'object',additionalProperties:false,required:['requirementRef','status','evidence'],properties:{requirementRef:{type:'string',minLength:1,maxLength:160},status:{type:'string',enum:[...STATUSES]},evidence:{type:'array',maxItems:8,items:evidenceSchema}}}}}};
  function developer(){return [
    '너는 본문 집필자와 완전히 격리된 Cortex 정사 판정관 Luna다. 판정만 한다.',
    'evidenceSources는 현재 활성 사건에서 화면에 확정된 공개 본문의 누적 근거창이다. 복합 종결조건은 한 비트에 전부 반복될 필요가 없으며 여러 sourceRef의 실제 성립 사실을 합산해 판정한다.',
    'protagonistInvariants가 있으면 각 항목에 대해 이번 확정 본문이 그 불변식을 비가역적으로 파괴하는지 판정한다. BROKEN은 본문에 실제로 그렇게 서술된 경우만이며 evidenceQuote로 그 인용을 제출한다. 일시적·회복 여지가 있는 서술은 THREATENED다. 해당 없음은 NONE 하나로 줄여도 된다.',
    '집필 지시·대체 문장·전개 조언·다음 문단·성립 방법을 만들지 않는다. 출력은 지정된 폐쇄형 JSON뿐이며 자연어 근거를 쓰지 않는다.',
    'MET은 누적 공개 본문에서 조건의 의미상 핵심이 이미 실제로 성립했을 때만 쓴다. evidence에는 evidenceSegments가 제공한 evidenceRef만 넣는다. 본문을 다시 타이핑하거나 요약한 인용문을 만들지 않는다. 근거 세그먼트를 하나도 지목할 수 없으면 MET을 쓰지 않는다.',
    'READER_UNDERSTANDING·PRESENTATION처럼 문단 전체의 효과로 성립하는 요건은 서로 보완하는 evidenceRef를 여러 개 고른다. “독자가 체감했다” 같은 메타 문장은 근거가 아니며, 실제 사물·행동·반응·대조가 효과를 만들어야 한다.',
    '예시 소품의 선택 개수, 묘사 분량, 반복 금지 같은 연출 지침은 그 자체만으로 이미 성립한 의미상 핵심을 미충족으로 되돌리지 않는다. 반면 세계 사실을 부정하는 금지 조건은 실제 위반 문장이 있으면 UNMET이다.',
    '“없다/하지 않는다” 같은 부정 제약은 사건 근거창 전체에 위반 사실이 없으면 별도의 부재 문장을 요구하지 않는다. 긍정 사실이 함께 있는 복합 조건이면 그 긍정 사실의 인용을 evidence로 낸다.',
    '암시·예고·계획·꿈·전언·미래·부정·실패한 시도는 긍정 사실의 성립이 아니다. priorMetRequirements에 이미 있는 조건은 재판정하지 않는다.',
    '애매하면 UNCERTAIN을 쓴다. 관대한 채점은 정사를 오염시키지만, 현재 문단만 보느라 앞 비트의 확정 근거를 버려 이야기를 멈추게 해서도 안 된다.'
  ].join('\n')}
  function normalizeSources(evidenceSources=[],fullText='',priorText=''){
    const rows=list(evidenceSources).map((row,index)=>({sourceRef:text(row?.sourceRef||`event-evidence-${index+1}`).trim().slice(0,160),text:text(row?.text).slice(-12000),current:row?.current===true})).filter(row=>row.sourceRef&&row.text);
    if(!rows.length&&text(priorText))rows.push({sourceRef:'PRIOR_PUBLIC_TEXT',text:text(priorText).slice(-4000),current:false});
    if(text(fullText)&&!rows.some(row=>row.current===true))rows.push({sourceRef:'CURRENT_BEAT',text:text(fullText).slice(0,18000),current:true});
    const seen=new Set;return rows.filter(row=>{if(seen.has(row.sourceRef))return false;seen.add(row.sourceRef);return true}).slice(-8)
  }
  function evidenceSegments(sources=[]){const out=[];for(const source of list(sources)){let cursor=0,index=0;for(const raw of text(source?.text).split(/(?<=[.!?。！？])\s+|\n+/u)){const quote=raw.trim();if(!quote)continue;const span=findSpan(source.text,quote,cursor)||findSpan(source.text,quote,0);if(!span)continue;cursor=span.end;index++;out.push({evidenceRef:`${text(source.sourceRef)}#E${index}`,sourceRef:text(source.sourceRef),text:quote,span:[span.start,span.end],current:source?.current===true})}}return out}
  function recoveryRequest({items=[],requirement,candidate,evidenceSources=[],rawUserInput=''}={}){/* v1.27.10 — 복합 선택조건 2차 질의. 새 권위를 만들지 않고 같은 판정관에게 좁은 질문을 더 묻는다.
       v1.27.11 — 한 사건에 복합 선택조건이 여럿이면 전부를 한 번의 요청에 묶는다(항목별 개별 판정). */
    const rows=items.length?list(items):[{requirement,candidate}];
    const sources=normalizeSources(evidenceSources),segments=evidenceSegments(sources);
    return {mode:MODE,developer:[developer(),'추가 규칙: candidateEvidenceRefs가 제시된 요건은 각각 독립적으로 판정한다. 구 로그의 candidateQuotes가 제시된 요건도 같은 뜻이다. 그 세그먼트들이 문맥상 실제로 요건을 충족하는지만 본다. 사실을 부정하거나("아니었다","거짓"), 가정·상상·전언("~였다면","상상했다","~라는 소문")이거나, 단어만 겹치고 의미가 다르면 충족이 아니다. MET이면 candidateEvidenceRefs 중 실제로 충족을 이루는 evidenceRef만 되돌려라.'].join('\n'),schema:outputSchema,payload:{schema:'CORTEX_CANON_ADJUDICATION_INPUT_V3',rawUserInput:text(rawUserInput).slice(0,2000),evidenceSources:sources,evidenceSegments:segments,protagonistInvariants:[],requirements:rows.map(row=>({requirementRef:text(row?.requirement?.ref||row?.requirement?.requirementRef),description:text(row?.requirement?.description),type:text(row?.requirement?.type),completionRole:text(row?.requirement?.completionRole),source:text(row?.requirement?.source),alternatives:list(row?.requirement?.alternatives).map(value=>text(value)).filter(Boolean).slice(0,8),candidateEvidenceRefs:list(row?.candidate?.bindings).map(item=>text(item?.evidenceRef)).filter(Boolean).slice(0,6),candidateQuotes:list(row?.candidate?.bindings).map(item=>({sourceRef:text(item?.sourceRef),evidenceQuote:text(item?.evidenceQuote)})).filter(item=>item.sourceRef&&item.evidenceQuote).slice(0,6)})).filter(row=>row.requirementRef),priorMetRefs:[]}}}
  function request({rawUserInput='',fullText='',priorText='',evidenceSources=[],requirements=[],priorMetRefs=[],invariants=[]}={}){const sources=normalizeSources(evidenceSources,fullText,priorText),segments=evidenceSegments(sources);return {mode:MODE,developer:developer(),schema:outputSchema,payload:{schema:'CORTEX_CANON_ADJUDICATION_INPUT_V3',rawUserInput:text(rawUserInput).slice(0,2000),evidenceSources:sources,evidenceSegments:segments,protagonistInvariants:list(invariants).map(row=>({invariantRef:text(row?.ref||row?.invariantRef),label:text(row?.label),severity:text(row?.severity),description:text(row?.description)})).filter(row=>row.invariantRef),requirements:list(requirements).map(row=>({requirementRef:text(row?.ref||row?.requirementRef),description:text(row?.description),type:text(row?.type),completionRole:text(row?.completionRole),source:text(row?.source),alternatives:list(row?.alternatives).map(value=>text(value)).filter(Boolean).slice(0,12)})).filter(row=>row.requirementRef),priorMetRequirements:list(priorMetRefs).map(value=>text(value)).filter(Boolean)}}}
  function normalize(raw,requirements=[],invariants=[]){const allowedInvariants=new Set(list(invariants).map(row=>text(row?.ref||row?.invariantRef)).filter(Boolean)),seenInvariants=new Set(),invariantThreats=[];for(const row of list(raw?.invariantThreats)){const invariantRef=text(row?.invariantRef).trim(),status=['NONE','THREATENED','BROKEN'].includes(text(row?.status).toUpperCase())?text(row.status).toUpperCase():'NONE';if(!invariantRef||seenInvariants.has(invariantRef))continue;if(allowedInvariants.size&&!allowedInvariants.has(invariantRef))continue;seenInvariants.add(invariantRef);if(status!=='NONE')invariantThreats.push({invariantRef,status,evidenceQuote:text(row?.evidenceQuote).trim().slice(0,240)})}
    const allowed=new Set(list(requirements).map(row=>text(row?.ref||row?.requirementRef)).filter(Boolean)),seen=new Set(),verdicts=[];for(const row of list(raw?.verdicts)){const requirementRef=text(row?.requirementRef).trim(),status=STATUSES.includes(text(row?.status).toUpperCase())?text(row.status).toUpperCase():'UNCERTAIN';if(!requirementRef||seen.has(requirementRef)||!allowed.has(requirementRef))continue;seen.add(requirementRef);const evidence=list(row?.evidence).map(item=>({evidenceRef:text(item?.evidenceRef).trim().slice(0,200),sourceRef:text(item?.sourceRef).trim().slice(0,160),evidenceQuote:text(item?.evidenceQuote).trim().slice(0,400)})).filter(item=>item.evidenceRef||(item.sourceRef&&item.evidenceQuote));/* V1/V2 테스트·가져온 로그 호환 */if(!evidence.length&&text(row?.evidenceQuote).trim())evidence.push({evidenceRef:'',sourceRef:'CURRENT_BEAT',evidenceQuote:text(row.evidenceQuote).trim().slice(0,400)});verdicts.push({requirementRef,status,evidence})}for(const row of list(requirements)){const ref=text(row?.ref||row?.requirementRef);if(ref&&!seen.has(ref)){seen.add(ref);verdicts.push({requirementRef:ref,status:'UNCERTAIN',evidence:[],code:'VERDICT_MISSING'})}}return {schema:SCHEMA,available:true,verdicts,invariantThreats}}
  const NEGATIVE_CONSTRAINT_RE=/(?:없다|없어야|않는다|않아야|금지|노출하지|사용하지)/u;
  function semanticTokens(value){const particles=/(?:으로부터|에게서|에서|에게|한테|께서|까지|부터|처럼|보다|으로|로|와|과|의|은|는|이|가|을|를|에|도|만)$/u,common=new Set(['정확히','그리고','또는','하며','하여','한다','보여','준다','사용','현재','실제로','이미','계속']);return [...new Set(text(value).toLowerCase().replace(/[^0-9a-z가-힣]+/giu,' ').split(/\s+/u).map(token=>token.replace(particles,'')).filter(token=>(token.length>=2||/\d/u.test(token))&&!common.has(token)))]}
