  function matchingMove(candidate,context={}){const inTransit=['DEPARTED','IN_TRANSIT'].includes(candidate.motionState),targetRef=inTransit?text(candidate.destinationLocationRef):text(candidate.locationRef),targetLabel=inTransit?text(candidate.destinationLocation):text(candidate.location);return verifiedMoves(context.claims).find(row=>targetRef&&text(row?.destinationLocationRef)===targetRef||key(row?.destinationLocationLabel)===key(targetLabel))}
