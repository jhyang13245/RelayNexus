  function recoverChoiceVerdict(row,requirement,sources){if(row.status!=='UNCERTAIN')return row;const description=text(requirement?.description),choice=description.match(/중\s*(\d+)\s*(?:[~\-–]\s*(\d+))?\s*개/u),alternatives=list(requirement?.alternatives).map(value=>text(value)).filter(value=>value&&!NEGATIVE_CONSTRAINT_RE.test(value));if(!choice||alternatives.length<2)return row;const core=alternativeCoverage(alternatives[0],sources);if(!core)return row;const minimum=Math.max(1,+choice[1]||1),examples=alternatives.slice(1).map(value=>alternativeCoverage(value,sources)).filter(Boolean);if(examples.length<minimum)return row;const bindings=[],seen=new Set;for(const binding of [...core.bindings,...examples.slice(0,minimum).flatMap(item=>item.bindings)]){const key=`${binding.sourceRef}|${binding.evidenceQuote}`;if(!seen.has(key)){seen.add(key);bindings.push(binding)}}if(!bindings.length)return row;/* v1.27.10 — 토큰 겹침은 충족을 부여하지 못한다. 부정("거짓이었다")·가정("~였다면 상상했다")도 토큰은 겹치므로,
     여기서 MET을 주면 v1.16·v1.26.2·v1.26.4에서 세 번 몰아낸 '문자열 유사도가 충족을 부여하는 경로'가 돌아온다.
     회복은 자문이다: 후보 인용을 모아 두면 실행부가 판정관에게 "이 인용들이 문맥상 요건을 충족하는가"를 한 번 더 묻는다. 충족 부여는 그 답변만 할 수 있다. */
    return {...row,status:'UNCERTAIN',code:'CHOICE_EVIDENCE_CANDIDATE',recoveryCandidate:{schema:'CORTEX_CHOICE_RECOVERY_CANDIDATE_V1',bindings,quotes:bindings.map(item=>({sourceRef:item.sourceRef,evidenceQuote:item.evidenceQuote}))}}}
  function bindVerdicts(adjudication,evidenceSources,requirements=[]){const sources=typeof evidenceSources==='string'?[{sourceRef:'CURRENT_BEAT',text:evidenceSources,current:true}]:normalizeSources(evidenceSources),byRef=new Map(sources.map(row=>[row.sourceRef,row.text])),segments=evidenceSegments(sources),segmentByRef=new Map(segments.map(row=>[row.evidenceRef,row])),requirementByRef=new Map(list(requirements).map(row=>[text(row?.ref||row?.requirementRef),row])),invariantThreats=list(adjudication?.invariantThreats).map(row=>{if(row.status!=='BROKEN')return row;const quote=text(row?.evidenceQuote);if(!quote)return {...row,status:'THREATENED',code:'EVIDENCE_MISSING',failureStage:'VISIBLE_EVIDENCE_REBIND'};for(const source of sources)if(findSpan(source.text,quote))return row;return {...row,status:'THREATENED',code:'EVIDENCE_NOT_FOUND',failureStage:'VISIBLE_EVIDENCE_REBIND'}/* v1.27.0 — 비가역 판정도 증거 결박: 최종 공개 본문에 없는 인용으로는 BROKEN이 성립하지 않는다 */}),bound=list(adjudication?.verdicts).map(row=>{if(row.status!=='MET')return {...row,evidenceBindings:[]};const evidence=list(row?.evidence).length?list(row.evidence):text(row?.evidenceQuote)?[{sourceRef:'CURRENT_BEAT',evidenceQuote:text(row.evidenceQuote)}]:[],bindings=[];for(const item of evidence){if(text(item?.evidenceRef)){const segment=segmentByRef.get(text(item.evidenceRef));if(!segment)return {...row,status:'UNCERTAIN',evidenceBindings:[],evidenceSpan:null,code:'EVIDENCE_REF_NOT_FOUND',failureStage:'VISIBLE_EVIDENCE_REBIND',failedEvidenceRef:text(item.evidenceRef)};bindings.push({evidenceRef:segment.evidenceRef,sourceRef:segment.sourceRef,evidenceQuote:segment.text,evidenceSpan:segment.span,evidenceMode:'ENGINE_SEGMENT_REF'});continue}const body=byRef.get(text(item?.sourceRef)),span=findSpan(body,text(item?.evidenceQuote));if(!body||!span)return {...row,status:'UNCERTAIN',evidenceBindings:[],evidenceSpan:null,code:'EVIDENCE_NOT_FOUND',failureStage:'VISIBLE_EVIDENCE_REBIND',failedEvidenceQuote:text(item?.evidenceQuote)};bindings.push({evidenceRef:'',sourceRef:text(item.sourceRef),evidenceQuote:text(item.evidenceQuote),evidenceSpan:[span.start,span.end],evidenceMode:span.mode})}if(!bindings.length)return {...row,status:'UNCERTAIN',evidenceBindings:[],evidenceSpan:null,code:'EVIDENCE_MISSING',failureStage:'VISIBLE_EVIDENCE_REBIND'};const first=bindings[0];return {...row,evidence:bindings.map(item=>item.evidenceRef?{evidenceRef:item.evidenceRef}:{sourceRef:item.sourceRef,evidenceQuote:item.evidenceQuote}),evidenceBindings:bindings,evidenceQuote:first.evidenceQuote,evidenceSpan:first.evidenceSpan,evidenceMode:first.evidenceMode}}),verdicts=bound.map(row=>recoverChoiceVerdict(row,requirementByRef.get(row.requirementRef),sources));return {...adjudication,schema:SCHEMA,evidenceSourceCount:sources.length,evidenceSegmentCount:segments.length,verdicts,invariantThreats,brokenInvariantCount:invariantThreats.filter(row=>row.status==='BROKEN').length,metCount:verdicts.filter(row=>row.status==='MET').length,unmetCount:verdicts.filter(row=>row.status==='UNMET').length,uncertainCount:verdicts.filter(row=>row.status==='UNCERTAIN').length}}
  function mergeLedger(prior,adjudication,{eventId='',requirements=[],at=''}={}){const byRef=new Map(list(requirements).map(row=>[text(row?.ref||row?.requirementRef),text(row?.description)])),base=text(prior?.eventId)===text(eventId)?prior:null,records={...clone(base?.records||{})};for(const row of list(adjudication?.verdicts)){if(records[row.requirementRef]?.status==='MET')continue;records[row.requirementRef]=row.status==='MET'?{status:'MET',evidenceRef:text(row?.evidenceBindings?.[0]?.evidenceRef),evidenceRefs:list(row?.evidenceBindings).map(item=>text(item?.evidenceRef)).filter(Boolean),evidenceQuote:text(row.evidenceQuote||row?.evidenceBindings?.[0]?.evidenceQuote),evidenceSpan:row.evidenceSpan||row?.evidenceBindings?.[0]?.evidenceSpan||null,evidenceBindings:clone(row.evidenceBindings||[]),at:text(at)}:{status:row.status,code:text(row.code),failureStage:text(row.failureStage),at:text(at)}}
  /* v1.26.3 — verdicts(설명 키)는 records(ref 키·증거 결박)의 파생 뷰다. records에 MET 증거가 없는 충족값은 존재할 수 없다.
