  function createActionOntologyGraph(){const nodes=Object.entries(ACTION_ONTOLOGY).map(([actionRef,concept])=>({actionRef,kind:concept.kind,minimumComponents:Number.isFinite(+concept.minimumComponents)?+concept.minimumComponents:null})),edges=[];for(const [actionRef,concept] of Object.entries(ACTION_ONTOLOGY)){for(const impliedRef of list(concept.implies))edges.push({from:actionRef,to:impliedRef,type:'IMPLIES'});for(const componentRef of list(concept.components))edges.push({from:componentRef,to:actionRef,type:'COMPONENT_OF'})}return {schema:ACTION_ONTOLOGY_SCHEMA,nodes,edges}}

  function koreanGivenName(value){const chars=[...text(value).replace(/\s+/gu,'')];return chars.length===3?chars.slice(1).join(''):''}
  function entityCatalogV3(options={}){
    const rows=[options.protagonist,...list(options.entities),...list(options.characters)].filter(Boolean),seen=new Set(),out=[];
    for(const [index,entity] of rows.entries()){
      const id=text(entity?.id,`entity-${index}`),name=text(entity?.name||entity?.label);if(!id||!name||seen.has(id))continue;seen.add(id);
      const aliases=unique(list(entity?.aliases).map(value=>text(value)).filter(Boolean)),given=koreanGivenName(name),surfaces=[{surface:name,origin:'CANONICAL_NAME',score:1},...aliases.map(surface=>({surface,origin:'DECLARED_ALIAS',score:.98}))];
