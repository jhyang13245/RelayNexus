<!doctype html>
<html lang="ko" data-font-size="small">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <title>단청 Cortex v1.42.0</title>
  <style>
:root{--night:#09130f;--night2:#0d1d17;--paper:#f3efe6;--line:#31463d;--muted:#8c9a92;--lime:#b8f56a;--orange:#f5673f;--blue:#78bad0;--ok:#9ade67;--bad:#fc8181;--shadow:0 24px 70px #0004;--safe-top:env(safe-area-inset-top,0px);--safe-right:env(safe-area-inset-right,0px);--safe-bottom:env(safe-area-inset-bottom,0px);--safe-left:env(safe-area-inset-left,0px);--prose-size:17px;color-scheme:dark;font-family:Pretendard,"Apple SD Gothic Neo","Noto Sans KR",system-ui,sans-serif;color:#eaf0eb;background:var(--night)}
html[data-font-size="medium"]{--prose-size:19px}html[data-font-size="large"]{--prose-size:21px}*{box-sizing:border-box}html{height:100%;overflow-x:hidden;background:var(--night);-webkit-text-size-adjust:100%}body{margin:0;min-height:100dvh;color:#eaf0eb;background:radial-gradient(circle at 15% 0,#173127 0,transparent 29rem),var(--night);overscroll-behavior-y:none;-webkit-tap-highlight-color:transparent}button,input,textarea,select{font:inherit}button{cursor:pointer;touch-action:manipulation;color:inherit}button:disabled{cursor:not-allowed;opacity:.46}
.app{min-height:100dvh;display:grid;grid-template-rows:auto auto 1fr auto}.top{height:76px;padding:0 clamp(18px,4vw,54px);display:flex;align-items:center;gap:16px;border-bottom:1px solid #58736555;background:#08110ed9;backdrop-filter:blur(18px);position:sticky;top:0;z-index:20}.mark{width:42px;height:42px;flex:0 0 42px;border:1px solid var(--lime);display:grid;place-items:center;transform:rotate(45deg);color:var(--lime);font-family:serif;font-weight:800}.mark span{transform:rotate(-45deg)}.brand{min-width:0}.brand strong{display:block;font:700 17px/1.1 ui-monospace,SFMono-Regular,monospace;letter-spacing:.08em}.brand small{display:block;color:var(--lime);margin-top:5px;font:600 10px/1 ui-monospace,monospace;letter-spacing:.18em}.top-actions{margin-left:auto;display:flex;gap:8px}.ghost,.solid{min-height:42px;border:1px solid #566a61;background:#0d1b16;color:#dce7df;padding:10px 14px}.solid{background:var(--lime);border-color:var(--lime);color:#102014;font-weight:800}.worldbar{padding:12px clamp(18px,4vw,54px);display:flex;gap:12px;align-items:center;border-bottom:1px solid #33473f;background:#0a1512;min-width:0}.worldbar span{color:#90a198;font-size:12px}.worldbar strong{font-size:13px;min-width:0}.dot{width:4px;height:4px;flex:0 0 4px;background:var(--orange);border-radius:50%}.mode{margin-left:auto;display:flex;align-items:center;gap:8px;color:#a9b7af;font-size:11px;letter-spacing:.08em}.mode i{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 12px var(--ok)}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;min-height:0}.story{min-width:0;padding:clamp(22px,4vw,58px) clamp(18px,6vw,88px) 190px;position:relative;background:linear-gradient(90deg,transparent 0 97%,#253a3150 97%)}.event-kicker{color:var(--orange);font:700 11px/1 ui-monospace,monospace;letter-spacing:.22em}.event-title{font:500 clamp(32px,5vw,68px)/1.04 Georgia,"Noto Serif KR",serif;margin:14px 0 12px;letter-spacing:-.045em}.event-copy{max-width:720px;color:#aab6af;line-height:1.85;margin:0 0 42px}.feed{width:100%;max-width:780px;min-width:0}.empty{color:#81958a;border:1px dashed #3a5146;padding:30px;line-height:1.8}.turn{border-top:1px solid #3a4b44;padding:30px 0 36px}.turn:first-child{border-top:0}.turn.is-new{animation:rise .38s ease-out}.turn-meta{display:flex;justify-content:space-between;gap:12px;color:#75877e;font:600 10px/1 ui-monospace,monospace;letter-spacing:.14em;margin-bottom:18px}.choice{color:#9aa9a1;font:600 13px/1.7 sans-serif;border-left:2px solid var(--lime);padding-left:13px;margin-bottom:18px}.prose{font:400 var(--prose-size)/2 Georgia,"Noto Serif KR",serif;color:#e8ede9;margin:0;white-space:pre-wrap;word-break:keep-all;overflow-wrap:break-word}.opening-scene .choice{color:var(--orange);border-left-color:var(--orange);font-family:ui-monospace,monospace;letter-spacing:.08em}.cursor{display:inline-block;width:7px;height:1.05em;background:var(--lime);vertical-align:-.15em;animation:blink .8s steps(1) infinite}.diagnostic,.notice{border:1px solid #914738;background:#3b1b1677;color:#ffd0c4;padding:16px;line-height:1.7;margin:18px 0}
.engine-notice{border:1px solid #8a6337;background:#2b2116;color:#ead9c2;padding:15px 16px;margin:16px 0;line-height:1.65}.engine-notice.error{border-color:#b85545;background:#351b18}.engine-notice.info{border-color:#3f6f65;background:#142621}.engine-notice-head{display:flex;align-items:flex-start;gap:9px;margin-bottom:9px}.engine-notice-head b{color:#ffd49b}.engine-notice.error .engine-notice-head b{color:#ffb2a6}.engine-notice.info .engine-notice-head b{color:#a9d8ca}.engine-notice-code{margin-left:auto;color:#8f9d96;font:700 9px/1.4 ui-monospace,monospace}.engine-notice p{margin:6px 0;font-size:12px}.engine-notice dl{display:grid;grid-template-columns:50px minmax(0,1fr);gap:5px 9px;margin:10px 0 0;font-size:11px}.engine-notice dt{color:#879b91}.engine-notice dd{margin:0;color:#c8d3cd}.engine-notice-stack .engine-notice{margin:9px 0}
.side{border-left:1px solid #31443c;background:#0b1713;padding:24px 20px;overflow:auto;max-height:calc(100dvh - 129px);position:sticky;top:129px;min-width:0}.drawer-head{display:none;align-items:center;justify-content:space-between;margin-bottom:12px}.drawer-close{border:1px solid #566a61;background:#0d1b16;padding:8px 12px}.inspector-tabs{display:grid;grid-template-columns:1fr 1fr;gap:5px;position:sticky;top:-24px;z-index:2;background:#0b1713;padding:8px 0 13px}.inspector-tab{border:1px solid #334b40;background:#09140f;color:#82958b;padding:11px 8px;font:700 10px/1 ui-monospace,monospace;letter-spacing:.1em}.inspector-tab.active{background:#183121;color:var(--lime);border-color:#77a653}.inspector-pane{display:none}.inspector-pane.active{display:block}.side h2{font:700 11px/1 ui-monospace,monospace;letter-spacing:.2em;color:var(--lime);margin:4px 0 18px}.panel{border-top:1px solid #2c4037;margin-top:22px;padding-top:22px;overflow-wrap:anywhere}.panel:first-child{margin-top:0}.panel h3{font-size:12px;margin:0 0 13px;color:#bcc8c1}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.metric{border:1px solid #2f453b;padding:13px;background:#0e1e18}.metric small{display:block;color:#70827a;font:600 9px ui-monospace,monospace;letter-spacing:.12em;margin-bottom:7px}.metric strong{font:600 17px ui-monospace,monospace}.metric em{color:#81938a;font-size:9px;font-style:normal}.kv{display:grid;grid-template-columns:84px minmax(0,1fr);gap:8px;font-size:12px;line-height:1.5;margin:9px 0}.kv span:first-child{color:#71847a}.kv b{color:#c9d4ce}.status{display:flex;align-items:center;gap:8px;font-size:12px;margin:10px 0;color:#9fb0a7}.status i{width:8px;height:8px;border-radius:50%;background:var(--blue)}.status i.ok{background:var(--ok);box-shadow:0 0 10px #9ade6755}.event-card{border:1px solid #30483c;background:#0d1d17;margin:0 0 11px;padding:14px}.event-card.active{border-left:3px solid var(--lime)}.event-card.sealed{border-left:3px solid var(--blue);opacity:.9}.event-card.pending{opacity:.58}.event-card-head{display:flex;gap:10px;align-items:flex-start}.event-card-head strong{font-size:13px;line-height:1.45}.event-status{margin-left:auto;border:1px solid currentColor;padding:4px 6px;color:var(--lime);font:700 8px/1 ui-monospace,monospace;letter-spacing:.1em}.event-card.sealed .event-status{color:var(--blue)}.event-card.pending .event-status{color:#73867d}.event-time,.seal-reason{margin-top:9px;color:#8ca097;font-size:11px;line-height:1.55}.progress-pair{margin:13px 0 15px}.progress-line{display:grid;grid-template-columns:58px 1fr 36px;gap:8px;align-items:center;margin:8px 0;color:#83978d;font-size:10px}.progress-line b{color:#c5d0ca;font:700 9px/1 ui-monospace,monospace;text-align:right}.beat-progress{height:4px;background:#22372e;margin:0}.beat-progress i{display:block;height:100%;background:var(--orange)}.beat-progress.stage i{background:var(--lime)}.turn-consumption{border-left:2px solid #345144;padding-left:8px;margin:10px 0;color:#8fa198;font-size:10px;line-height:1.55}.turn-consumption.ok{border-color:var(--ok);color:#a8bcaf}.turn-consumption.hold{border-color:var(--orange);color:#d3ac87}.beat-row{display:grid;grid-template-columns:46px 1fr;gap:9px;margin:8px 0;color:#8fa198;font-size:11px;line-height:1.55}.beat-row b{color:#c8d3cd;font:700 9px/1.55 ui-monospace,monospace}.requirement{display:grid;grid-template-columns:18px 1fr;gap:7px;margin:8px 0;color:#9db0a6;font-size:11px;line-height:1.5}.requirement i{font-style:normal;color:#73887d}.requirement.met i{color:var(--ok)}.font-size-actions,.actions{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.font-size-actions{grid-template-columns:repeat(3,1fr)}.font-size-actions button,.actions button{border:1px solid #334b40;background:#09140f;color:#9eb0a7;padding:11px 8px;font-size:11px}.font-size-actions button[aria-pressed="true"]{background:#183121;color:var(--lime);border-color:#77a653}.actions .wide{grid-column:1/-1}.migration{border:1px solid #3e574b;background:#0e1e18;padding:14px}.migration strong{color:var(--lime)}.small{font-size:11px;color:#8fa49a;line-height:1.65}.hidden{display:none!important}
.composer{position:fixed;left:0;right:350px;bottom:0;z-index:15;padding:14px clamp(18px,6vw,88px) calc(14px + var(--safe-bottom));background:linear-gradient(0deg,#08110f 72%,transparent);pointer-events:none}.compose-box{max-width:800px;margin:auto;border:1px solid #56685f;background:var(--paper);color:#17231e;box-shadow:var(--shadow);padding:14px;pointer-events:auto}.compose-box textarea{border:0;resize:none;width:100%;min-height:66px;max-height:30dvh;overflow-y:auto;background:transparent;color:#14211b;outline:none;line-height:1.55;font-size:16px}.compose-actions{display:flex;align-items:center;gap:8px;margin-top:8px}.compose-actions small{margin-left:auto;color:#78827d;font-size:10px}.progress{height:3px;background:#d5cec0;margin:-14px -14px 12px;overflow:hidden}.progress i{display:block;height:100%;width:0;background:var(--orange);transition:width .25s}.progress.busy i{width:86%;animation:load 1.2s ease-in-out infinite}.drawer-toggle{display:none;position:fixed;right:0;top:43%;z-index:31;border:1px solid #60816e;border-right:0;background:#0b1914;color:var(--lime);padding:16px 7px;writing-mode:vertical-rl;font-size:10px;letter-spacing:.12em}.drawer-scrim{display:none;position:fixed;inset:0;z-index:29;border:0;background:#020604a8;backdrop-filter:blur(2px)}
dialog{width:min(640px,calc(100% - 24px));max-width:100%;border:1px solid #526b5e;border-radius:0;background:#0c1914;color:#e5ece7;padding:0;box-shadow:0 30px 90px #000b}dialog::backdrop{background:#020604c9;backdrop-filter:blur(5px)}dialog form{padding:20px;min-width:0}dialog h2{font:600 18px Georgia,serif;margin:0 0 16px}.field{display:grid;gap:7px;margin:14px 0;min-width:0}.field label{font-size:11px;color:#9baca2}.field input,.field textarea,.field select{width:100%;min-width:0;border:1px solid #42574d;background:#07100d;color:#e8efea;padding:11px;outline:none}.row{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.row button{border:1px solid #566a61;background:#0d1b16;padding:10px 14px}.row .primary{background:var(--lime);color:#102014;border:0;font-weight:800}
@keyframes blink{50%{opacity:0}}@keyframes rise{from{opacity:0;transform:translateY(8px)}}@keyframes load{0%{transform:translateX(-100%)}50%{transform:translateX(20%)}100%{transform:translateX(115%)}}
@media(max-width:900px){body.drawer-open{overflow:hidden}.top{height:calc(66px + var(--safe-top));padding:var(--safe-top) calc(14px + var(--safe-right)) 0 calc(14px + var(--safe-left));gap:10px}.mark{width:38px;height:38px;flex-basis:38px}.brand strong{font-size:14px}.brand small{font-size:8px;letter-spacing:.1em}.top-actions .label{display:none}.top-actions button{min-width:44px;min-height:44px;padding:9px 10px}.worldbar{padding:10px calc(14px + var(--safe-right)) 10px calc(14px + var(--safe-left));gap:8px;white-space:nowrap;overflow:hidden}.worldbar span{display:none}.worldbar strong{font-size:11px;text-overflow:ellipsis;overflow:hidden}.worldbar #worldLocationBar{max-width:42vw}.worldbar #activeEventBar,.worldbar #profileLabel{display:none}.mode{flex:0 0 auto}.layout{display:block;width:100%;min-width:0}.story{width:100%;padding:26px calc(18px + var(--safe-right)) 175px calc(18px + var(--safe-left));background:none}.event-title{font-size:clamp(31px,9.2vw,42px);line-height:1.08}.event-copy{font-size:14px;line-height:1.72;margin-bottom:24px}.turn{padding:24px 0 30px}.prose{font-size:var(--prose-size);line-height:1.88}.side{position:fixed;right:0;top:calc(66px + var(--safe-top));bottom:0;width:min(90vw,380px);max-height:none;padding:20px calc(18px + var(--safe-right)) calc(24px + var(--safe-bottom)) 18px;z-index:30;transform:translateX(104%);transition:transform .22s ease-out;box-shadow:-20px 0 50px #0008;overscroll-behavior:contain}.side.open{transform:translateX(0)}.drawer-head{display:flex}.drawer-scrim.open{display:block}.drawer-toggle{display:block;right:var(--safe-right);top:46%;min-width:32px;min-height:72px;padding:12px 6px;border-radius:12px 0 0 12px;box-shadow:-8px 8px 30px #0007}.composer{right:0;padding:12px calc(12px + var(--safe-right)) calc(12px + var(--safe-bottom)) calc(12px + var(--safe-left))}.compose-box{max-width:none;border-radius:14px;padding:12px}.compose-box textarea{min-height:52px;max-height:180px}.compose-actions small{display:none}dialog{position:fixed;inset:auto 0 0 0;width:100%;max-width:none;max-height:calc(100dvh - var(--safe-top) - 12px);margin:0;border-width:1px 0 0;border-radius:18px 18px 0 0;padding-bottom:var(--safe-bottom)}dialog form{max-height:inherit;overflow:auto}.field input,.field select,.field textarea{font-size:16px;min-height:44px}}
@media(max-width:430px){.brand small{display:none}.event-title{font-size:clamp(29px,9vw,36px)}.compose-actions .ghost{padding-inline:10px}.compose-actions .solid{flex:1}}@media(max-width:370px){.brand strong{font-size:12px}.story{padding-inline:14px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  .import-report{margin:14px 0 0;padding:13px;border:1px solid #30483c;background:#07100d;color:#b9c8c0;white-space:pre-wrap;word-break:break-word;max-height:220px;overflow:auto}.import-report.ok{border-color:#5f8e49;color:#d9f2c6}.import-report.bad{border-color:#914738;color:#ffd0c4}
  .drawer-head{display:flex}body.inspector-closed .layout{grid-template-columns:minmax(0,1fr)}body.inspector-closed .side{display:none}body.inspector-closed .composer{right:0}body.inspector-closed .drawer-toggle{display:block}
  .event-card.sealed.early{border-left:3px solid #d8b4fe;background:#1d192b;opacity:1}.event-card.sealed.early .event-status{color:#e4caff;border-radius:10px;letter-spacing:0;font-size:10px}.event-card.sealed.early .seal-reason{color:#c5b3dd}

.event-card.alternative{border-left-color:#d0ad72}.event-card.alternative .event-status,.requirement.allowed i{color:#d0ad72}.requirement.allowed i{min-width:3.5em;font-size:.8em}
.play-tip{position:fixed;right:18px;bottom:135px;width:min(360px,calc(100vw - 36px));box-sizing:border-box;z-index:1000;padding:18px;border:1px solid #55776b;background:#12251f;color:#dce9e1;box-shadow:0 8px 32px #0007;font:14px/1.65 sans-serif}.play-tip p{margin:0 0 12px}.play-tip button{display:block;margin-left:auto;padding:8px 16px;border:1px solid #72917e;background:#203c2c;color:#e3eedb;cursor:pointer}
</style>
  <style>
  .turn-image-action{margin-top:22px;border:1px solid #385247;background:#0b1b15;padding:14px;display:flex;align-items:center;gap:14px}.turn-image-action.error{border-color:#914738}.turn-image-action-copy{min-width:0;display:grid;gap:5px}.turn-image-action-copy strong{font-size:12px;color:#dce9e1}.turn-image-action-copy small{color:#80978b;font-size:10px;line-height:1.5}.turn-image-button{margin-left:auto;flex:0 0 auto;border:1px solid var(--lime);background:#162b20;color:var(--lime);padding:10px 13px;font-size:11px;font-weight:800}.turn-image-panel{margin:24px 0 0;border:1px solid #3a5146;background:#07100d}.turn-image-panel img{display:block;width:100%;height:auto;aspect-ratio:1088/608;object-fit:contain;background:#050a08}.turn-image-caption{display:flex;justify-content:space-between;gap:12px;padding:10px 12px;color:#81968b;font:600 9px/1.4 ui-monospace,monospace;letter-spacing:.1em}.turn-image-caption strong{color:var(--lime)}
  @media(max-width:430px){.turn-image-action{align-items:stretch;flex-direction:column}.turn-image-button{margin-left:0;width:100%}}
  </style></head>
<body>
<div class="app">
  <header class="top"><div class="mark"><span>脈</span></div><div class="brand"><strong>단청 CORTEX</strong><small id="runtimeVersionLabel">BEAT EXPERIENCE RUNTIME</small></div><div class="top-actions"><button class="ghost" id="importBtn"><span class="label">시나리오 </span>불러오기</button><button class="ghost" id="settingsBtn">설정</button></div></header>
  <div class="worldbar"><span>WORLD</span><strong id="worldClock">D+0 · 00:00</strong><i class="dot"></i><span>LOCATION</span><strong id="worldLocationBar">-</strong><i class="dot"></i><strong id="activeEventBar">-</strong><i class="dot"></i><strong id="profileLabel">CORTEX</strong><div class="mode"><i id="modeLight"></i><b id="modeLabel">API KEY REQUIRED</b></div></div>
  <main class="layout"><section class="story"><div class="event-kicker">ACTIVE CANON / COMMIT GRAPH</div><h1 class="event-title" id="heroEventTitle"></h1><p class="event-copy" id="heroEventSummary"></p><section class="feed" id="feed"></section></section>
  <button class="drawer-scrim" id="drawerScrim" type="button" aria-label="상태 패널 닫기"></button>
  <button class="drawer-toggle" id="drawerBtn" type="button" aria-controls="inspector" aria-expanded="false">사건·진단</button>
  <aside class="side" id="inspector"><div class="drawer-head"><b>사건·진단</b><button class="drawer-close" id="closeDrawerBtn" type="button" aria-label="사건·진단 패널 닫기">닫기</button></div>
    <div class="inspector-tabs" role="tablist"><button class="inspector-tab active" type="button" data-inspector-tab="events">사건</button><button class="inspector-tab" type="button" data-inspector-tab="diagnostics">진단</button></div>
    <section class="inspector-pane active" data-inspector-pane="events"><h2>CANON EVENTS · <span id="eventChainCount">1 EVENT</span></h2><p class="event-time">현재 사건부터 이어지는 사건 연쇄를 표시합니다. 공개 전 세부 내용은 봉인합니다.</p><div id="eventInspector"><div class="panel"><div class="kv"><span>현재</span><b id="eventTitle"></b></div><div class="kv"><span>상태</span><b id="eventPhase"></b></div><div class="kv"><span>요건</span><b id="eventRequirements"></b></div></div></div></section>
    <section class="inspector-pane" data-inspector-pane="diagnostics"><h2>LIVE TELEMETRY</h2><div class="metric-grid"><div class="metric"><small>COMPILE</small><strong id="mCompile">—</strong><em> ms</em></div><div class="metric"><small>PRE-STREAM</small><strong id="mPreStream">—</strong><em> ms</em></div><div class="metric"><small>FIRST TEXT</small><strong id="mTtft">—</strong><em> ms</em></div><div class="metric"><small>PROVIDER TTFT</small><strong id="mProviderTtft">—</strong><em> ms</em></div><div class="metric"><small>COMMIT</small><strong id="mCommit">—</strong><em> ms</em></div><div class="metric"><small>CAPSULE</small><strong id="mCapsule">MISS</strong></div></div>
      <div class="panel"><h3>World</h3><div class="kv"><span>작품</span><b id="storyTitle"></b></div><div class="kv"><span>시간</span><b id="worldTime"></b></div><div class="kv"><span>장소</span><b id="worldLocation"></b></div></div>
      <div class="panel"><h3>Runtime</h3><div class="status"><i class="ok" id="judgeLight"></i><span id="morphStatus">LUNA JUDGE · ISOLATED</span></div><div class="kv"><span>판정관</span><b id="judgeState">대기</b></div><div class="kv"><span>REANALYZE</span><b id="judgeReanalyze">0 / 4</b></div><div class="kv"><span>호출 제한</span><b id="judgeRateLimit">0</b></div><div class="kv"><span>마지막 판정</span><b id="judgeLast">—</b></div><div class="kv"><span>담화 모호성</span><b id="judgeAmbiguity">없음</b></div><div class="kv"><span>문단 상태</span><b>PROVISIONAL</b></div><div class="kv"><span>세계 권위</span><b>ATOMIC REF GRAPH</b></div><div class="kv"><span>Kiwi</span><b>REMOVED</b></div></div>
      <div class="panel"><h3>Engine notices</h3><div id="engineNoticePanel" class="engine-notice-stack"><div class="event-time">현재 설명할 오류가 없습니다.</div></div></div>
      <div class="panel"><h3>본문 글자 크기</h3><div class="font-size-actions" id="fontSizeActions"><button type="button" data-font-size="small" aria-pressed="true">작게</button><button type="button" data-font-size="medium" aria-pressed="false">보통</button><button type="button" data-font-size="large" aria-pressed="false">크게</button></div></div>
      <div class="panel migration"><h3>Nexus native bridge</h3><p class="small"><strong>기본 CortexPack을 오프라인으로 내장합니다.</strong><br>서사 JSON 전체와 모바일 최적화 인물 기준 이미지 23장을 포함하며, 다른 Package 1.5·Instant Story·구형 패키지도 계속 불러올 수 있습니다.</p></div>
      <div class="panel actions"><button id="exportBtn">공통 세션 내보내기</button><button id="restoreBackupBtn" class="wide" type="button">초기화·되감기 전 기록 복구</button><button id="copyPromptBtn" class="wide" type="button">마지막 공개 작가 요청 복사</button></div>
    </section>
  </aside></main>
  <div id="recoveryNotice" class="panel" role="status" hidden></div><div class="composer"><div class="compose-box"><div class="progress" id="progress"><i></i></div><textarea id="input" maxlength="4000" enterkeyhint="enter" spellcheck="true" placeholder="주인공의 행동을 한국어로 입력하세요."></textarea><div class="compose-actions"><button class="ghost" id="rewindQuickBtn" type="button" disabled>되감기</button><small id="streamState">Enter 전송 · Shift+Enter 줄바꿈</small><button class="solid" id="send" type="button">정사 전개 →</button></div></div></div>
</div>

<dialog id="settingsDialog"><form method="dialog"><h2>연결 설정</h2><div class="field"><label>OpenAI API Base URL</label><input id="baseUrl" value="https://api.openai.com/v1"></div><div class="field"><label>모델</label><input id="model" value="gpt-6-luna"></div><div class="field"><label>API Key (이 기기에만 저장)</label><input id="apiKey" type="password" autocomplete="off"></div><div class="field"><label>문체 지침</label><textarea id="styleGuide" rows="5"></textarea></div><p class="small">작품마다 다른 문체를 지정할 수 있습니다. 집필 지시문의 맨 끝에 그대로 전달됩니다.</p><div class="field"><label>본문 표시 속도</label><select id="typingSpeed"><option value="natural">자연스럽게 (권장)</option><option value="slow">천천히</option><option value="fast">빠르게</option><option value="instant">즉시 표시</option></select></div><p class="small">모델 출력은 최대 속도로 받아 두고 화면에 나타나는 속도만 조절합니다. 첫 문단을 읽는 동안 후속 문단을 생성·검사합니다.</p><div class="field"><label>장면 이미지 품질</label><select id="imageQuality"><option value="low">Low · 빠르고 경제적</option><option value="medium">Medium · 더 정교하게</option></select></div><p class="small">확정 본문을 표시하는 동안 이미지 프롬프트를 준비합니다. 실제 GPT-Image-2 비용은 각 비트의 이미지 추가 버튼을 눌렀을 때만 발생하며 1088×608 가로 이미지 한 장을 생성합니다.</p><input id="literaryCapsule" type="hidden" value="off"><div class="field"><label>장기기억</label><p class="small">최근 3사건은 공개 원문으로 전달합니다. 종료된 3사건마다 Luna가 원문 전체를 읽고 1,000자 이내로 요약합니다. 요약에는 별도 API 비용이 발생하며, 실패하거나 지연되면 원문을 유지하고 집필을 계속합니다.</p></div><div class="row"><button value="cancel">취소</button><button class="primary" id="saveSettings" value="default">저장</button></div></form></dialog>
<dialog id="importDialog"><form method="dialog"><h2>공통 세션 가져오기</h2><div class="field"><input id="scenarioFile" type="file" accept="application/json,.json,application/zip,.zip"></div><div class="field"><textarea id="scenarioJson" rows="12" placeholder="RELAY_CANONICAL_SESSION_V1, CORTEX_APP_STATE 또는 시나리오 JSON"></textarea></div><p class="small">전체 백업 ZIP과 JSON을 가져올 수 있습니다. Nexus 작품 패키지 ZIP은 오른쪽 패널의 패키지 불러오기를 사용하세요. 변환 결과는 Nexus와 Cortex가 함께 읽는 공통 세션입니다.</p><div class="row"><button value="cancel">취소</button><button class="primary" id="applyScenario" value="default">적용</button></div></form></dialog>
<dialog id="nexusImportDialog"><form method="dialog"><h2>Nexus 패키지 ZIP 불러오기</h2><div class="field"><label>Package 1.5 · Instant Story · 기존 ScenarioPack</label><input id="nexusPackageFile" type="file" accept=".zip,application/zip,application/x-zip-compressed"></div><p class="small">패키지를 메인 런타임에서 직접 해석해 Nexus/Cortex 공통 세션으로 변환합니다. 현재 플레이 기록은 적용 버튼을 누를 때 교체되며, 작품명별 예외 규칙은 사용하지 않습니다.</p><pre id="nexusImportReport" class="import-report">ZIP을 선택하면 인물·사건·분기·시작 상태의 의미 보존 여부를 먼저 검사합니다.</pre><div class="row"><button value="cancel">취소</button><button class="primary" id="applyNexusPackage" type="button" disabled>검사한 패키지 적용</button></div></form></dialog>

<script src="data:text/javascript;base64,"></script>
<script>
/* Cortex Compatibility Contract v1.24.3-alpha
 * Pure, package-agnostic invariants shared by import, Korean role analysis,
 * canon lifecycle, event evidence and carryover reconciliation.
 */
(()=>{
  'use strict';

  const scalar=value=>typeof value==='string'||typeof value==='number'||typeof value==='boolean';
  const text=(value,fallback='')=>value==null?fallback:(scalar(value)?String(value).trim():fallback);
  const list=value=>Array.isArray(value)?value:(value==null?[]:[value]);
  const unique=value=>[...new Set(list(value).filter(Boolean))];
  const hash=value=>{let h=2166136261;for(const ch of text(value)){h^=ch.codePointAt(0);h=Math.imul(h,16777619)}return (h>>>0).toString(36)};
  const normalize=value=>text(value).toLowerCase().replace(/[“”'‘’「」『』()[\]{}<>]/g,' ').replace(/[^0-9a-z가-힣· _:-]/giu,' ').replace(/\s+/g,' ').trim();
  const STOP=new Set('대신 그리고 하지만 그러고 이어서 바로 그냥 다시 이미 현재 실제 주인공 사용자 플레이어 사건 장면 상태 결과 정보 사실 정도'.split(' '));
  const PARTICLE_CHAINS=[
    ['으로부터는','으로부터'],['에게서는','에게서'],['한테서는','한테서'],
    ['까지는','까지'],['부터는','부터'],['에서는','에서'],['에게는','에게'],
    ['한테는','한테'],['으로는','으로'],['로는','로'],['에는','에'],
    ['으로부터','으로부터'],['에게서','에게서'],['한테서','한테서'],
    ['이랑','이랑'],['에게','에게'],['한테','한테'],['까지','까지'],
    ['부터','부터'],['에서','에서'],['으로','으로'],['랑','랑'],['께','께'],
    ['로','로'],['에','에'],['을','을'],['를','를'],['와','와'],['과','과'],
    ['은','은'],['는','는'],['이','이'],['가','가'],['의','의']
  ];

  function stripParticle(token){
    const clean=text(token).replace(/^[“”'‘’「」『』()[\]{}]+|[“”'‘’「」『』()[\]{},，。.!?！？;；]+$/g,'');
    for(const [surface,particle] of PARTICLE_CHAINS){
      if(clean.length>surface.length&&clean.endsWith(surface))return {stem:clean.slice(0,-surface.length),particle,surface,topic:surface!==particle};
    }
    return null;
  }

  function contentTokens(value){
    return unique(normalize(value).split(/\s+/u).map(token=>{
      const stripped=stripParticle(token);
      return normalize(stripped?.stem||token);
    }).filter(token=>token.length>=2&&!STOP.has(token)&&!/^\d+$/u.test(token)));
  }

  function tokenMatch(a,b){return a===b||(a.length>=3&&b.length>=3&&(a.startsWith(b)||b.startsWith(a)))}
  function coverage(required,evidence){
    const requiredTokens=contentTokens(required),evidenceTokens=contentTokens(evidence);
    if(!requiredTokens.length)return {ok:true,ratio:1,hits:[],required:[]};
    const hits=requiredTokens.filter(want=>evidenceTokens.some(got=>tokenMatch(want,got))),ratio=hits.length/requiredTokens.length;
    return {ok:ratio>=.42||(requiredTokens.length<=2&&hits.length===requiredTokens.length),ratio,hits,required:requiredTokens};
  }

  function phraseBefore(tokens,index,stem,maxWords=5){
    const parts=[stem];
    for(let i=index-1;i>=0&&parts.length<maxWords;i--){
      const raw=text(tokens[i]).replace(/[“”'‘’「」『』()[\]{},，。.!?！？;；]/g,'');
      if(!raw||stripParticle(raw)||/(?:고|며|면서|다가|지만|는데|어서|아서|해서|뒤|후|전)$/u.test(raw))break;
      parts.unshift(raw);
    }
    return text(parts.join(' ')).replace(/^(?:그리고|하지만|그러고(?:는)?|이어서|바로|급히|일단|그냥|아예)\s+/u,'');
  }

  function caseRoles(clause){
    const tokens=text(clause).replace(/([,，。.!?！？;；])/g,' $1 ').split(/\s+/u).filter(Boolean),roles=[];
    for(let i=0;i<tokens.length;i++){
      const parsed=stripParticle(tokens[i]);
      if(!parsed)continue;
      const phrase=phraseBefore(tokens,i,parsed.stem);
      if(phrase)roles.push({...parsed,phrase,index:i,raw:tokens[i]});
    }
    return roles;
  }

  function movementRoles(clause,predicateIndex=Infinity){
    const roles=caseRoles(clause).filter(role=>role.index<=predicateIndex),explicit=roles.filter(role=>['에','까지'].includes(role.particle)),directional=roles.filter(role=>['로','으로'].includes(role.particle));
    const destination=(explicit.at(-1)||directional.at(-1))?.phrase||'';
    const manner=explicit.length?directional.filter(role=>role.phrase!==destination).at(-1)?.phrase||'':'';
    const source=roles.filter(role=>['에서','부터','으로부터'].includes(role.particle)).at(-1)?.phrase||'';
    return {destination,source,manner,roles};
  }

  function koreanPredicateRole(surface,clause=''){
    const predicate=text(surface),context=text(clause),local=`${context} ${predicate}`.replace(/\s+/gu,' ');
    if(/눈(?:을|이)\s*(?:뜨|떴|떠|뜬|뜬다)|잠에서\s*(?:깨|깼)|깨어나/u.test(local))return {kind:'WAKE',lemma:'wake',stateTransition:'AWAKE',eParticleRole:'NONE'};
    if(/(?:잠(?:에)?\s*(?:들|든|들어)|잠들|수면에\s*빠)/u.test(local))return {kind:'REST',lemma:'sleep',stateTransition:'SLEEPING',eParticleRole:'COMPLEMENT'};
    if(/(?:열중|몰두|집중|참여|관여|의존|익숙|능숙|관심|전념|착수|종사)(?:하|했|해|이|였|된|되)/u.test(predicate))return {kind:'GENERIC_ACTION',lemma:'',stateTransition:'',eParticleRole:'COMPLEMENT'};
    if(/(?:부수|깨뜨|깨트|파괴|망가뜨|망가트|찢|태우|박살|부러뜨|절단|폭파)/u.test(local))return {kind:'DESTROY',lemma:'destroy',stateTransition:'',eParticleRole:'NONE'};
    /* 표면 문자열은 후보를 찾는 데만 쓴다. 특히 `후려갈기다` 안의 `갈`을
       이동으로 확정하던 것처럼 부분 문자열 하나가 다른 행동을 이기지 못한다. */
    if(/(?:때리|때린|때렸|때려|두드|내리(?:치|친|쳤|쳐)|내려치|후려(?:갈기|치|친|쳤|쳐)|걷어차|공격|찌르|쏘|휘두르|조르|제압|가격)/u.test(local))return {kind:'ATTACK',lemma:'attack',stateTransition:'',eParticleRole:'NONE'};
    if(text(predicate).split(/\s+/u).some(form=>/^(?:가다|가고|가는|가면|가서|가려|간다|갔다|갈|갑니다|오다|오고|오는|오면|오려|온다|왔다|올|향하다|향하|이동하다|이동|도착하다|도착|출발하다|출발|떠나다|떠나|들어가다|들어가|나가다|나가|돌아가다|돌아가|건너가다|건너가|올라가다|올라가|내려가다|내려가)$/u.test(form)))return {kind:'MOVE',lemma:'move',stateTransition:'',eParticleRole:'DESTINATION'};
    if(/(?:줍|얻|획득|건네받|수령|회수|집어\s*들|챙기)/u.test(local))return {kind:'ACQUIRE',lemma:'acquire',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:넣|보관|수납|담|꽂)/u.test(local))return {kind:'STORE',lemma:'store',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:버리|내려놓|반납|건네|분실|놓아\s*두)/u.test(local))return {kind:'RELEASE',lemma:'release',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:확인|조사|살피|관찰|검색|읽|들여다|검토|발견|찾아(?:보|내|낸|냈)|찾았|점검)/u.test(local))return {kind:'INSPECT',lemma:'inspect',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:말하|묻|대답|응답|전화|연락|문자|메시지|외치|부르|설득|요청)/u.test(local))return {kind:'COMMUNICATE',lemma:'communicate',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:일어(?:나|난|났|날)|몸을\s*일으|앉|기립|웅크리|엎드리)/u.test(local))return {kind:'POSTURE',lemma:'posture',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:멈추|멈췄|중단|그만두)/u.test(local))return {kind:'STOP',lemma:'stop',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:기다리|머무르|버티|대기)/u.test(local))return {kind:'WAIT',lemma:'wait',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:쉬|휴식|눕|수면)/u.test(local))return {kind:'REST',lemma:'rest',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:먹|마시|삼키)/u.test(local))return {kind:'CONSUME',lemma:'consume',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:열|개방|잠금\s*해제)/u.test(predicate))return {kind:'OPEN',lemma:'open',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:닫|잠그|봉인)/u.test(predicate))return {kind:'CLOSE',lemma:'close',stateTransition:'',eParticleRole:'NONE'};
    if(/(?:만들|조립|제작|작성|그리|설치|준비)/u.test(local))return {kind:'CREATE',lemma:'create',stateTransition:'',eParticleRole:'NONE'};
    return {kind:'',lemma:'',stateTransition:'',eParticleRole:'UNRESOLVED'};
  }

  function verbRoleCompatible(kind,frame={}){
    const scope=text(frame.scopeText||frame.raw),theme=text(frame.theme),predicate=text(frame.predicate);if(!theme||!scope||!predicate)return false;
    const normalizedTheme=normalize(theme),themeTokens=normalizedTheme.split(/\s+/u);if(/^(?:그것|이것|저것|무언가|뭔가|바닥|앞|뒤|옆|안|밖)$/u.test(normalizedTheme)||['먼저','다시','이미','곧'].includes(themeTokens[0]))return false;
    const themeAt=scope.indexOf(theme),predicateAt=scope.indexOf(predicate,Math.max(0,themeAt));if(themeAt<0||predicateAt<0||themeAt>=predicateAt||predicateAt-themeAt>44)return false;
    if(!/(?:을|를|은|는|이|가|와|과|랑|하고|에|에게|한테)/u.test(scope.slice(themeAt,predicateAt)))return false;
    if(kind==='inventory_add'&&!/(?:집|줍|받|챙|넣|보관|획득|건네받)/u.test(predicate))return false;
    if(kind==='inventory_remove'&&!/(?:놓|버리|건네|주|내려놓|꺼내)/u.test(predicate))return false;
    return true;
  }

  function requirementAlternatives(requirement){
    const raw=text(requirement?.description||requirement?.goal||requirement?.title||requirement),explicit=list(requirement?.alternatives||requirement?.aliases).map(value=>text(value)).filter(Boolean);
    const split=raw.split(/\s*\|\s*/u).map(value=>text(value)).filter(Boolean);
    // A pipe in migrated packages separates a broad author goal from an observable signal.
    // Prefer the concrete signal while retaining explicit aliases as equivalent evidence.
    return unique([...(split.length>1?split.slice(1):split),...explicit]);
