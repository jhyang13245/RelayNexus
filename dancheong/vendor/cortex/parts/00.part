  const CONTRACT_SOURCE='systemic_native_package_fidelity_v11';
  /* 목표 컴파일 규칙이 바뀌면 이 값을 올린다.
     저장된 세션은 이전 컴파일 결과를 그대로 들고 있어서, 규칙만 고치면 진행 중인 세션에는 반영되지 않는다.
     실제로 description 을 목표 출처에서 뺀 뒤에도 이어 하던 세션에는 장면 설명이 종결조건으로 남아 있었다.
     런타임이 이 값을 보고 낡은 결과를 버린다. */
  const COMPILER_VERSION='1.18.0-r2';
  const GOAL_TYPES=new Set(['PLAYER_AGENCY','NEGATIVE_CONSTRAINT','READER_UNDERSTANDING','RELATIONSHIP_STATE','INVENTORY_STATE','DIALOGUE','WORLD_STATE','PHYSICAL_FACT']);
  const TURN_ACTS=new Set(['ACTION','SPEECH','THOUGHT','OBSERVATION','REACTION','STATE_ASSERTION','BACKSTORY_ASSERTION','META']);
  const LATIN_TOKEN_RE=/[A-Za-z][A-Za-z'’.-]*/gu;
  const EDITORIAL_LATIN_RE=/\b(?:need|replace|rewrite|revise|draft|note|fix|remove|keep|should|must|maybe|alternative|option|ending|last\s+image|korean\s+only|english\s+only|translate|translation|prompt|instruction|analysis)\b/iu;

  function latinTokens(value){return [...text(value).matchAll(LATIN_TOKEN_RE)].map(match=>match[0].replace(/[.'’]+$/u,'')).filter(Boolean)}

  function segmentNarrativeBuffer(value,flush=false){
    const source=value==null?'':String(value),segments=[];let start=0;
    const boundary=/(?:[.!?。！？]+[”’"'」』)]*|\n{2,})(?:\s+|$)/gu;let match;
    while((match=boundary.exec(source))){const end=boundary.lastIndex,segment=source.slice(start,end);if(segment)segments.push(segment);start=end;if(!match[0])boundary.lastIndex++}
    if(flush&&start<source.length){segments.push(source.slice(start));start=source.length}
    return {schema:'CORTEX_NARRATIVE_SEGMENTS_V1',segments,pending:source.slice(start)};
  }

  function segmentSafeNarrativeBuffer(value,flush=false,options={}){
    const source=value==null?'':String(value),segments=[],minimum=Math.max(8,+options.minSegmentChars||16),holdback=flush?0:Math.max(8,+options.holdbackChars||18),pairs={'“':'”','‘':'’','「':'」','『':'』','(':')','[':']','{':'}'},stack=[];let straightQuote=false,start=0;
    const balanced=()=>!straightQuote&&stack.length===0,push=end=>{if(end<=start)return;const candidate=source.slice(start,end);if(candidate.trim().length<minimum&&!flush)return;if(!flush&&end>source.length-holdback)return;segments.push(candidate);start=end};
    for(let index=0;index<source.length;index++){
      const ch=source[index];if(ch==='"'){straightQuote=!straightQuote;if(balanced()&&/[.!?。！？][”’"'」』)]?$/u.test(source.slice(start,index+1).trim()))push(index+1);continue}if(pairs[ch]){stack.push(pairs[ch]);continue}if(stack.at(-1)===ch){stack.pop();if(balanced()&&/[.!?。！？][”’"'」』)]?$/u.test(source.slice(start,index+1).trim()))push(index+1);continue}if(!balanced())continue;
      if(/[.!?。！？]/u.test(ch)){let end=index+1;while(end<source.length&&/[.!?。！？”’"'」』)]/u.test(source[end]))end++;push(end);index=end-1;continue}
      if(ch==='\n'&&source[index+1]==='\n'){let end=index+2;while(source[end]==='\n')end++;push(end);index=end-1;continue}
      if(ch===','||ch==='，'){push(index+1);continue}
      if(/\s/u.test(ch)&&/(?:고|며|면서|지만|는데|다가|어서|아서|자마자)[,，]?\s$/u.test(source.slice(start,index+1)))push(index+1);
    }
    if(flush&&start<source.length)push(source.length);
    return {schema:'CORTEX_SAFE_NARRATIVE_SEGMENTS_V2',segments,pending:source.slice(start),balanced:balanced(),holdbackChars:holdback};
  }

  function analyzeNarrativeLanguage(value,options={}){
    const source=value==null?'':String(value),allowed=new Set(list(options.allowedLatinTerms).flatMap(latinTokens).map(token=>token.toLowerCase())),parts=segmentNarrativeBuffer(source,true).segments,leaks=[];
    for(const [index,segment] of parts.entries()){
      const tokens=latinTokens(segment),unauthorized=tokens.filter(token=>!allowed.has(token.toLowerCase()));
      const editorial=EDITORIAL_LATIN_RE.test(segment),latinChars=(segment.match(/[A-Za-z]/gu)||[]).length,visibleChars=(segment.match(/[0-9A-Za-z가-힣]/gu)||[]).length,latinRatio=visibleChars?latinChars/visibleChars:0;
      if(editorial)leaks.push({code:'LANGUAGE_LEAK:EDITORIAL_META',segmentIndex:index,segment:text(segment),tokens:unique(tokens.map(token=>token.toLowerCase()))});
      if(unauthorized.length)leaks.push({code:latinRatio>=.18||unauthorized.length>=3?'LANGUAGE_LEAK:LATIN_SENTENCE':'LANGUAGE_LEAK:UNAUTHORIZED_LATIN',segmentIndex:index,segment:text(segment),tokens:unique(unauthorized.map(token=>token.toLowerCase())),latinRatio});
    }
    return {schema:'CORTEX_NARRATIVE_LANGUAGE_POLICY_V1',ok:leaks.length===0,language:'ko',allowedLatinTerms:[...allowed],leaks,issues:unique(leaks.map(leak=>leak.code))};
  }

  function objectStrings(value,out=[]){
    if(value==null)return out;
    if(scalar(value)){const found=text(value);if(found)out.push(found);return out}
    if(Array.isArray(value)){for(const item of value)objectStrings(item,out);return out}
    if(typeof value==='object'){
      for(const key of ['description','goal','requiredOutcome','function','statement','text','summary','result','effect','title','name']){
        if(Object.prototype.hasOwnProperty.call(value,key))objectStrings(value[key],out);
      }
    }
    return out;
  }

  function splitOutsideQuotes(value,separators=new Set(['|'])){
    const source=text(value),out=[];let start=0,straight=false;const stack=[],pairs={'“':'”','‘':'’','「':'」','『':'』','(':')','[':']','{':'}'};
    for(let index=0;index<source.length;index++){
      const ch=source[index];
      if(ch==='"'){straight=!straight;continue}
      if(pairs[ch]){stack.push(pairs[ch]);continue}
      if(stack.at(-1)===ch){stack.pop();continue}
      if(!straight&&!stack.length&&separators.has(ch)){const part=text(source.slice(start,index));if(part)out.push(part);start=index+1}
    }
    const tail=text(source.slice(start));if(tail)out.push(tail);return out;
  }

  function goalType(raw,description=''){
    const declared=text(raw?.semanticRole||raw?.type).toUpperCase();
    if(GOAL_TYPES.has(declared))return declared;
    if(/PLAYER|AGENCY/u.test(declared)||/(?:사용자|플레이어).{0,28}(?:선택|결정|행동|정한다)/u.test(description))return 'PLAYER_AGENCY';
    if(/NEGATIVE|FORBID|CONSTRAINT/u.test(declared)||/(?:하지\s*않|하지\s*말|금지|노출하지|등장시키지|추가하지|없어야)/u.test(description))return 'NEGATIVE_CONSTRAINT';
    if(/READER|UNDERSTAND|PERCEPTION/u.test(declared)||/(?:독자|플레이어|주인공).{0,28}(?:느끼|체감|이해|인식|알게)/u.test(description))return 'READER_UNDERSTANDING';
    if(/RELATION/u.test(declared)||/(?:관계|신뢰|호감|경계|친밀|적대|동맹)/u.test(description))return 'RELATIONSHIP_STATE';
    if(/ITEM|INVENTORY/u.test(declared)||/(?:소지|보유|획득|잃|건네|물품|아이템)/u.test(description))return 'INVENTORY_STATE';
    if(/DIALOGUE|SPEECH/u.test(declared)||/(?:대화|말한다|묻는다|대답한다|발화)/u.test(description))return 'DIALOGUE';
    if(/WORLD|STATE/u.test(declared)||/(?:상태|위치|도착|퇴장|종료|완료|사라|남아|확보|소모)/u.test(description))return 'WORLD_STATE';
    return 'PHYSICAL_FACT';
  }

  function goalCompletionRole(type){
    const normalized=text(type).toUpperCase();
    if(normalized==='PLAYER_AGENCY'||normalized==='NEGATIVE_CONSTRAINT')return 'CONSTRAINT';
    if(normalized==='READER_UNDERSTANDING')return 'PRESENTATION';
    return 'OUTCOME';
  }

  function goalAlternativesForClause(clause,alternatives=[]){
    const wanted=contentTokens(clause),scored=list(alternatives).map(value=>{
      const candidate=text(value),tokens=contentTokens(candidate),hits=tokens.filter(token=>wanted.some(item=>tokenMatch(token,item))).length;
      return {candidate,hits,ratio:tokens.length?hits/tokens.length:0};
    }).filter(row=>row.candidate&&row.hits>0).sort((a,b)=>b.ratio-a.ratio||b.hits-a.hits);
    return unique([...scored.map(row=>row.candidate),...semanticEvidenceAlternatives(clause)]).slice(0,12);
  }

  function atomizeGoal(raw,goal,index=0,source='explicit'){
    if(!goal)return [];
    let clauses=splitRequirementClauses(goal.description);
    /* 패키지는 서로 다른 권위를 한 문장 안에서 연결어미로 잇기도 한다.
       “독자가 … 느끼고 플레이어가 … 결정한다”처럼 문장부호가 없어도
       PLAYER_AGENCY 절의 주어 경계는 안전하게 분리할 수 있다. */
    if(clauses.length<2&&/(?:사용자|플레이어).{0,32}(?:선택|결정|행동|정한다)/u.test(goal.description)){
      const joined=text(goal.description).split(/\s+(?=(?:사용자|플레이어)(?:가|는|은|이)?\s)/u).map(value=>text(value)).filter(Boolean);
      if(joined.length>1)clauses=joined;
    }
    if(clauses.length<2)return [{...goal,completionRole:goalCompletionRole(goal.type),completionRequired:goalCompletionRole(goal.type)!=='CONSTRAINT'&&goal.required!==false,enforced:goal.required!==false}];
    const typed=clauses.map(clause=>({clause,type:goalType({},clause)})),types=unique(typed.map(row=>row.type)),hasAgencyMix=types.includes('PLAYER_AGENCY')&&types.some(type=>type!=='PLAYER_AGENCY');
    /* 문장이 여러 개라는 이유만으로 작가가 선언한 한 요건을 임의 분해하지 않는다.
       서로 다른 의미 권위가 섞였거나, 사건 완료가 될 수 없는 연속 제약이 끼어 있을 때만 원자화한다. */
    if(!hasAgencyMix)return [{...goal,completionRole:goalCompletionRole(goal.type),completionRequired:goalCompletionRole(goal.type)!=='CONSTRAINT'&&goal.required!==false,enforced:goal.required!==false}];
    return typed.map((row,atomIndex)=>{
      const completionRole=goalCompletionRole(row.type),suffix=row.type.toLowerCase().replace(/_/gu,'-'),id=`${goal.id}:${suffix}-${hash(`${atomIndex}|${row.clause}`)}`;
      return {...goal,id,parentId:goal.id,atomIndex,description:row.clause,type:row.type,alternatives:goalAlternativesForClause(row.clause,goal.alternatives),completionRole,completionRequired:completionRole!=='CONSTRAINT'&&goal.required!==false,enforced:goal.required!==false,source:`${source}:atomic`};
    });
  }

  function normalizeGoal(raw,index=0,source='explicit'){
    const description=typeof raw==='string'?text(raw):text(raw?.description||raw?.requiredOutcome||raw?.function||raw?.goal||raw?.statement||raw?.text||raw?.summary||raw?.title);
    if(!description)return null;
    const declaredAlternatives=typeof raw==='object'&&raw?unique([...list(raw.alternatives),...list(raw.aliases)].flatMap(value=>objectStrings(value,[]))):[];
    const alternatives=unique([...declaredAlternatives,...(source==='explicit'?[]:semanticEvidenceAlternatives(description))]);
    const type=goalType(raw,description),id=text(raw?.id,`goal-${hash(`${source}|${index}|${description}`)}`),completionRole=goalCompletionRole(type),required=raw?.required!==false;
    return {id,description,type,required,source,alternatives,completionRole,completionRequired:completionRole!=='CONSTRAINT'&&required,enforced:required,observable:type!=='READER_UNDERSTANDING'||alternatives.length>0||contentTokens(description).length>0};
  }

  function semanticEvidenceAlternatives(description){
    const source=text(description),out=[];
    for(const sentence of splitOutsideQuotes(source,new Set(['.','!','?','。','！','？'])).map(value=>text(value)).filter(Boolean)){
      const enumerated=/(?:중)\s*(?:한두|\d+\s*[~～-]\s*\d+|\d+)\s*개(?:만)?\s*(?:사용|선택|제시)/u.test(sentence);
      const parts=enumerated?sentence.split(/\s*,\s*|\s+(?:또는|혹은)\s+/u):[sentence];
      for(let part of parts){
        part=text(part)
          .replace(/^(?:독자|사용자|플레이어|주인공)(?:는|은|이|가)\s*/u,'')
          .replace(/^(?:.*?)(?:보기|알기|확인하기)\s*전에\s*/u,'')
          .replace(/\s*(?:중\s*)?(?:한두|\d+\s*[~～-]\s*\d+|\d+)\s*개(?:만)?\s*(?:사용|선택|제시)(?:한다|한다는 것)?$/u,'')
          .replace(/\s*(?:을|를|이|가|임을|음을)?\s*(?:환경|행동|묘사|서술)(?:으로|을 통해)?\s*(?:보여|드러내|표현)(?:\s*준)?다$/u,'')
          .replace(/\s*(?:체감|이해|인식|느끼|알게)한다$/u,'')
          .replace(/\s*(?:사용자가|플레이어가)\s*(?:결정|선택)한다$/u,'')
          .trim();
        const tokens=contentTokens(part);
        if(tokens.length>=2&&tokens.length<=16)out.push(part);
      }
    }
    return unique(out);
  }

  function firstNonEmptyGoalSource(raw){
    const candidates=[
      ['requiredFunctions',raw?.requiredFunctions],
      ['completionSignals',raw?.completionSignals],
      ['requiredSignals',raw?.requiredSignals],
      ['completionCriteria',raw?.completionCriteria],
      ['obligations',raw?.obligations],
      ['requiredDialogue',raw?.requiredDialogue],
      ['requiredItems',raw?.requiredItems]
    ];
    for(const [name,value] of candidates){
      const pipeParts=typeof value==='string'&&['completionSignals','requiredSignals','completionCriteria'].includes(name)?splitOutsideQuotes(value,new Set(['|'])):[];
      const sourceItems=pipeParts.length>1?[{description:pipeParts.at(-1),aliases:pipeParts.slice(0,-1)}]:list(value);
      const items=sourceItems.filter(item=>objectStrings(item,[]).length>0);
      if(items.length)return {name,items,mode:'EXPLICIT'};
    }
    const fallback=[];
    /* v1.14.0 — description/summary 는 목표 출처가 아니다.
       그 둘은 이 사건이 어떤 장면인지 적어 둔 설명이지, 성립해야 할 조건이 아니다.
       실제 패키지에서 "오전 6시 43분의 서촌 주택. 사람만 사라지고 생활은 멈춘 듯 남아 있다"가
       종결조건으로 승격되어, 작가에게 "이 장면이 반드시 보여 줘야 하는 것"으로 나갔고
       무엇을 써도 충족되지 않는 조건이 사건 내내 남았다.
       사건이 required 를 직접 선언했더라도 조건의 출처까지 넓어지는 것은 아니다. */
    for(const [name,value] of [['onSuccess',raw?.onSuccess],['effects',raw?.effects]]){
      for(const statement of objectStrings(value,[]))fallback.push({statement,source:name});
    }
    return {name:'semanticFallback',items:unique(fallback.map(item=>item.statement)).slice(0,8),itemSources:fallback,mode:'DERIVED'};
  }

  /* v1.13.0 — Studio 계약: 종결조건은 필수 사건에만 있다.
     studio-export.ts 지침이 "메인 플롯에서 빠지면 뒤가 꼬이는 사건은 required=true 로 지정합니다.
     필수 사건마다 … 본문 완료 판정용 completionSignals … 를 작성합니다"라고 못박는다.

     기존 컴파일러는 반대로 돌았다. 선언이 없으면 description·summary 에서 목표를 지어내고(DERIVED),
     그렇게 생긴 목표가 있으니 required=true 로 승격시켰다. 순환이다.
     그 결과 "오전 6시 43분의 서촌 주택… 선택할 수 있게 끝낸다" 같은 장면 설명이
     종결조건이 되어 영원히 미충족으로 남았다.

     required 가 명시적으로 false 면 목표를 만들지 않는다. 그것이 작가의 선언이다.
     completionSignals 가 남아 있어도 마찬가지다. 편집 흔적이 명시 계약을 이길 수는 없다. */
  function compileEventIR(raw={},index=0){
    /* 선택 사건은 목표 수집 자체를 건너뛴다. 반환 구조는 그대로 두어 이후 경로가 달라지지 않게 한다. */
    const optional=raw?.required===false;
    const id=text(raw?.id||raw?.eventId,`event-${index+1}`),selected=optional?{name:'optional-event',items:[],mode:'EXPLICIT'}:firstNonEmptyGoalSource(raw),goals=[];
    for(const [goalIndex,item] of selected.items.entries()){
      const source=selected.mode==='EXPLICIT'?selected.name:(selected.itemSources?.find(candidate=>candidate.statement===item)?.source||'description');
      const goal=normalizeGoal(item,goalIndex,source);if(goal)goals.push(...atomizeGoal(item,goal,goalIndex,source));
    }
    /* DERIVED 목표는 required 를 끌어올리지 않는다. 지어낸 목표가 사건을 필수로 만들면 순환이다.
       명시 선언(EXPLICIT)이 있을 때만 선언 없는 사건을 필수로 승격한다. */
    const uniqueGoals=unique(goals.map(goal=>normalize(goal.description))).map(key=>goals.find(goal=>normalize(goal.description)===key)).filter(Boolean),completionGoals=uniqueGoals.filter(goal=>goal.completionRequired!==false),required=raw?.required===true||(selected.mode==='EXPLICIT'&&uniqueGoals.length>0);
    const explicitMin=raw?.pacing?.minTurns??raw?.minTurns,explicitMax=raw?.pacing?.maxTurns??raw?.maxTurns,
      /* v1.18.0-r2 — 복구 조건을 자유문에서 실행 권한으로 승격한다. 엔진은 특정 작품의
         '수업', '온라인 자료' 같은 단어를 해석하지 않는다. recoveryAlternatives라는 패키지
         필드 자체를 작가가 선언한 우회 경로로 취급하고, 구조형 항목은 locationBypass=false로
         명시 철회할 수 있다. cancelConditions는 우회 장면의 조건/내용으로 함께 보존하되,
         그것만으로 장소 게이트를 뚫지는 않는다. */
      rawRecovery=Array.isArray(raw?.recoveryAlternatives)?raw.recoveryAlternatives:text(raw?.recoveryAlternatives).split(/\s*(?:\||\n|;)\s*/u).filter(Boolean),
      recoveryAlternatives=rawRecovery.map((value,recoveryIndex)=>{const row=value&&typeof value==='object'?value:{description:text(value)},description=text(row?.description||row?.label||row?.summary);if(!description)return null;return {alternativeRef:text(row?.alternativeRef||row?.id,`recovery-${recoveryIndex+1}`),method:text(row?.method,'PACKAGE_DECLARED'),description,allowLocationBypass:row?.allowLocationBypass!==false&&row?.locationBypass!==false&&row?.requiresCanonLocation!==true}}).filter(Boolean),
      cancelCondition=text(raw?.cancelConditions||raw?.cancelCondition);
    return {
      schema:'CORTEX_COMPILED_EVENT_IR_V1',compilerVersion:COMPILER_VERSION,source:CONTRACT_SOURCE,id,
      identity:{id,title:text(raw?.title||raw?.name,'가져온 사건'),required},
      narrativeGoals:completionGoals,
      /* v1.14.0 — 필수 사건이라고 해서 반드시 종결조건이 있는 것은 아니다.
         장면 설명만 적힌 필수 사건은 흔하고, 그것을 실행 불가로 보면 패키지 자체가 열리지 않는다.
         description 을 목표 출처에서 뺀 뒤 실제로 그 회귀가 났다.
         종결조건이 없는 사건은 조건이 아니라 예산(비트 또는 턴)으로 닫는다.
         어느 쪽으로 닫히는지를 closureMode 에 남겨, 런타임이 판정 방식을 고르게 한다. */
      completionPolicy:{mode:selected.mode,operator:selected.mode==='EXPLICIT'?'ALL':'ANY',sourceFields:unique(uniqueGoals.map(goal=>goal.source)),goals:completionGoals,completionGoalIds:completionGoals.map(goal=>goal.id),closureMode:completionGoals.length>0?'GOALS':'BUDGET',executable:true,endSceneAfterCompletion:raw?.endSceneAfterCompletion===true},
      constraintPolicy:{schema:'CORTEX_EVENT_CONSTRAINT_POLICY_V1',constraints:uniqueGoals.filter(goal=>goal.completionRole==='CONSTRAINT'),continuous:true,blocksEventCompletion:false},
      recoveryPolicy:{schema:'CORTEX_EVENT_RECOVERY_POLICY_V2',mode:text(raw?.recoveryPolicy?.mode||raw?.fallbackPolicy,'TYPED_RECOVERY'),allowEndlessExtension:false,activationPolicy:'BLOCKED_ROUTE_OR_WINDOW_PRESSURE',cancelCondition,alternatives:recoveryAlternatives,allowsLocationBypass:recoveryAlternatives.some(row=>row.allowLocationBypass===true)},
      transitionPolicy:{nextEventId:eventReference(raw?.nextEventId||raw?.followUp?.eventId||raw?.followUp||raw?.nextEvent?.id),endSceneAfterCompletion:raw?.endSceneAfterCompletion===true},
      disclosurePolicy:{protectedTerms:list(raw?.protectedTerms),revealPolicy:raw?.revealPolicy||null},
      pacingPolicy:{minTurns:Number.isFinite(+explicitMin)?Math.max(1,Math.round(+explicitMin)):null,maxTurns:Number.isFinite(+explicitMax)?Math.max(1,Math.round(+explicitMax)):null,minimumIsSoft:true},
      attestation:{rawDigest:hash(JSON.stringify(raw)),goalDigest:hash(JSON.stringify(uniqueGoals.map(goal=>[goal.id,goal.type,goal.completionRole,goal.description])))}
    };
  }

  function eventReference(value){const candidate=text(value);return /^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$/u.test(candidate)?candidate:''}
  /* v1.38.1 — every event has exactly three authored/runtime beats. Imported packages
     may still contain older 1/2/4+ beat layouts, so preserve their content while
     folding it into FREE → GUIDED → CLOSURE. Extensions are separate runtime beats. */
  function runtimeBeatCount(){return 3}
  function materializeRuntimeBeats(raw={},eventIR=null){
    const authored=list(raw?.beats),synthetic=(phase,index)=>({id:`runtime-beat-${index+1}`,title:phase==='FREE'?'자유 전개':phase==='GUIDED'?'정사 유도':'사건 종결',goal:'',phase,status:index?'PENDING':'ACTIVE',runtimeSynthetic:true,runtimeExtension:false,sourceBeatRefs:[]});
    if(!authored.length)return ['FREE','GUIDED','CLOSURE'].map(synthetic);
    const normalize=(beat,phase,index,sourceRows=[beat])=>{const sourceBeatRefs=sourceRows.map((row,rowIndex)=>text(row?.id,`source-beat-${rowIndex+1}`)),goals=unique(sourceRows.map(row=>text(row?.goal||row?.description)).filter(Boolean));return {...beat,id:text(beat?.id,`beat-${index+1}`),title:text(beat?.title,phase==='FREE'?'자유 전개':phase==='GUIDED'?'정사 유도':'사건 종결'),goal:goals.join(' · '),phase,status:index?'PENDING':'ACTIVE',runtimeSynthetic:false,runtimeExtension:false,runtimeThreeBeat:true,sourceBeatRefs}};
    if(authored.length===1)return [normalize(authored[0],'FREE',0),synthetic('GUIDED',1),synthetic('CLOSURE',2)];
    const middle=authored.length===2?[]:authored.slice(1,-1),guidedRows=middle.length?middle:[{id:'runtime-guided-import',title:'정사 유도',goal:''}],guided=normalize(guidedRows[0],'GUIDED',1,guidedRows);
    return [normalize(authored[0],'FREE',0),guided,normalize(authored.at(-1),'CLOSURE',2)];
  }

  const MORPH_ANALYSIS_CACHE=new Map(),MORPH_ANALYSIS_CACHE_LIMIT=96;
  function primeMorphAnalysis(analysis={}){
    const source=text(analysis?.text);if(!source)return {accepted:false,reason:'EMPTY_TEXT'};
