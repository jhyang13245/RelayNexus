    if(text(options.source)==='USER_INPUT'){for(const proposition of propositions.filter(row=>row.actuality==='COMMITTED'&&row.actorRef)){const node=basePresence.nodes.find(row=>row.entityRef===proposition.actorRef);if(node?.status==='UNKNOWN'){node.status='PRESENT';node.reason='USER_ACTOR_ENTAILMENT'}}for(const proposition of propositions.filter(row=>row.actuality==='COMMITTED'&&row.roles.patientRef&&['ATTACK','ACTIVITY'].includes(row.actionKind))){const node=basePresence.nodes.find(row=>row.entityRef===proposition.roles.patientRef);if(node?.status==='UNKNOWN'){node.status='PRESENT';node.reason='USER_DIRECT_INTERACTION_ENTAILMENT'}}}
    const analysisStatus=unresolved.length?'REANALYZE':cachedMorph?'READY':'FALLBACK';return {schema:KOREAN_IR_SCHEMA,version:3,normalizedText:source,tokens,mentions,propositions,resolutionLedger:{schema:RESOLUTION_SCHEMA,entries:resolutionEntries},presenceGraph:basePresence,locationGraph,actionOntology:createActionOntologyGraph(),unresolved:unique(unresolved.map(row=>JSON.stringify(row))).map(row=>JSON.parse(row)),analysisStatus,authority:'REFERENCE_GRAPH_SEMANTIC_IR',consumerPolicy:'SURFACE_FOR_CANDIDATE_DISCOVERY_ONLY_REFS_FOR_DECISIONS'};
  }

  function classifyTurnAct(input){
    const source=text(input),clauses=source.split(/(?<=[.!?。！？])\s+|\n+/u).map(value=>text(value)).filter(Boolean),acts=[];
    for(const clause of clauses){
      let type='';
      if(/^(?:\s*[-#*]|(?:설정|메타|시스템|작가)\s*[:：])/u.test(clause))type='META';
      else if(/(?:라고\s*(?:말|외치|묻|답)|말한다|외친다|묻는다|대답한다|["“”「」『』])/u.test(clause))type='SPEECH';
      else if(/[!?！？]{1,}|^(?:아|으아|와|헉|음|흠|하하|후|젠장|좋아|싫어|꿀맛)/u.test(clause))type='REACTION';
      else if(/(?:생각한다|생각했다|떠올린다|떠올렸다|궁금하다|왜\s+.*(?:까|지)|마음속|(?:고|아|어)\s*싶다|원한다|바란다)/u.test(clause))type='THOUGHT';
      else if(/(?:보인다|보였다|들린다|들렸다|느껴진다|살펴본다|관찰한다)/u.test(clause))type='OBSERVATION';
      else if(/(?:년|개월|주|일)\s*(?:전|동안)|예전|과거|어릴\s*때|이제껏|그동안|어느덧/u.test(clause)&&/(?:였다|했다|되었다|됐다|있었다|없었다)/u.test(clause))type='BACKSTORY_ASSERTION';
      else if(/(?:이다|였다|이었다|있다|없다|되었다|됐다|적응(?:했|하|이\s*되)|상태다|같다|느끼다)(?:[.!?。！？]|$)/u.test(clause))type='STATE_ASSERTION';
      else if(koreanActionPredicateSegments(clause).length||/(?:가(?:고|는|려|겠다)|간다|갔다|오(?:고|는|겠다)|온다|왔다|나가|나간|들어가|들어간|돌아가|돌아간|열|닫|먹|마시|만들|집|잡|놓|챙|기다리|자|쉬|공격|살피|확인|읽|쓰|말하|외치|묻|대답)(?:[가-힣]*)(?:다|요|자|라|겠다|한다|했다)/u.test(clause)||/(?:을|를|에게|한테|께|에서|으로|로|와|과|랑|이랑)(?:\s+[가-힣0-9]+){0,5}\s+[가-힣]{1,24}(?:다|요|자|라)[.!?。！？]?$/u.test(clause))type='ACTION';
      else if(/[?？]$/u.test(clause))type='THOUGHT';
      else type='STATE_ASSERTION';
      acts.push({type,clause,committable:type!=='META'});
    }
    const priority=['ACTION','SPEECH','REACTION','OBSERVATION','THOUGHT','BACKSTORY_ASSERTION','STATE_ASSERTION','META'],primary=priority.find(type=>acts.some(act=>act.type===type))||'STATE_ASSERTION';
    return {schema:'CORTEX_TURN_ACT_V1',primary,acts,hasAction:acts.some(act=>act.type==='ACTION'),valid:TURN_ACTS.has(primary)};
  }

  function quantityFrom(textValue){
    const source=text(textValue),numeric=source.match(/(\d+)\s*(?:가지|개|그릇|접시|종류)/u);if(numeric)return Math.max(1,+numeric[1]);
    const words={한:1,두:2,세:3,네:4,다섯:5,여섯:6,일곱:7,여덟:8,아홉:9,열:10};for(const [word,count] of Object.entries(words))if(new RegExp(`${word}\\s*(?:가지|개|그릇|접시|종류)`,'u').test(source))return count;return 1;
  }

  function frameDuration(frame,intent={}){
    const raw=text(frame?.raw||intent.raw),quantity=quantityFrom(raw),kind=text(frame?.kind).toUpperCase();
    if(kind==='MOVE')return frame?.motionClass==='JOURNEY'||frame?.motionClass==='ESCAPE'?900:frame?.transport?600:frame?.completion==='ARRIVAL'?180:90;
    if(kind==='CREATE')return /(?:요리|조리|굽|끓|볶|튀기)/u.test(raw)?Math.max(600,quantity*480):Math.max(90,quantity*90);
    if(kind==='CONSUME')return Math.max(300,quantity*150);
    if(kind==='REST'||kind==='WAIT')return 600;
    if(kind==='ATTACK'||kind==='DESTROY')return 90;
    if(kind==='REACTION'||kind==='SPEECH')return 15;
    return 45;
  }

  function estimateActionGraphDuration(frames,intent={}){
    if(Number.isFinite(+intent.requestedDurationSec)&&+intent.requestedDurationSec>0)return {seconds:+intent.requestedDurationSec,mode:'EXPLICIT',steps:[]};
    const steps=list(frames).filter(Boolean).map(frame=>({frameId:text(frame.frameId),kind:text(frame.kind),seconds:frameDuration(frame,intent),raw:text(frame.raw)}));
    const seconds=steps.reduce((sum,step)=>sum+step.seconds,0)||(['REACTION','SPEECH','THOUGHT','STATE_ASSERTION','BACKSTORY_ASSERTION'].includes(intent?.turnAct?.primary)?15:45);
    return {schema:'CORTEX_ACTION_GRAPH_DURATION_V1',seconds,mode:'COMPOSED_SEQUENTIAL',steps};
  }

  function evidenceForGoal(goal,evidenceText,turnNo=0){
    const result=requirementCoverage(goal,evidenceText,/(?:않았|않는다|못했|못했다|실패|하지\s*못|하지\s*않|아니다|없었다)/u),actuality=result.ok?'COMMITTED':'UNKNOWN';
    return {schema:'CORTEX_EVENT_EVIDENCE_V1',id:`evidence-${hash(`${goal.id}|${turnNo}|${result.clause||''}`)}`,goalId:goal.id,propositionId:`proposition-${hash(`${goal.type}|${normalize(result.alternative||goal.description)}`)}`,type:goal.type,actuality,polarity:result.affirmed===false?'NEGATED':'POSITIVE',world:'CANON',actorRefs:[],targetRefs:[],span:text(result.clause),sourceTurn:turnNo,confidence:result.ratio||0};
  }

  function auditCompiledEvent(eventIR,evidenceText,turnNo=0,existing=[]){
    const goals=list(eventIR?.completionPolicy?.goals),ledger=[...list(existing)];
    for(const goal of goals){const evidence=evidenceForGoal(goal,evidenceText,turnNo);if(evidence.actuality==='COMMITTED')ledger.push(evidence)}
    const rows=goals.map(goal=>{const matches=ledger.filter(item=>item?.goalId===goal.id&&item.actuality==='COMMITTED'&&item.polarity!=='NEGATED');return {goalId:goal.id,description:goal.description,type:goal.type,ok:matches.length>0,evidenceIds:matches.map(item=>item.id)}}),operator=eventIR?.completionPolicy?.operator==='ANY'?'ANY':'ALL',ok=operator==='ANY'?rows.some(row=>row.ok):rows.every(row=>row.ok),missingGoalIds=ok?[]:rows.filter(row=>!row.ok).map(row=>row.goalId);
    return {schema:'CORTEX_EVENT_AUDIT_V1',ok,operator,rows,missingGoalIds,evidenceLedger:ledger.slice(-512)};
  }

  function transitionEventMachine(machine,eventIR,audit,context={}){
    const current=machine&&machine.activeEventId===eventIR?.id?{...machine}:{schema:'CORTEX_EVENT_FSM_V1',activeEventId:eventIR?.id,state:'ACTIVE',eventTurns:0,extensionCount:0};
    current.eventTurns+=context.committed===false?0:1;current.lastAudit=audit;
    if(current.state==='SEALED')return current;
    if(audit?.ok){current.state='CLOSURE_CANDIDATE';current.closeEligible=true;if(eventIR?.completionPolicy?.endSceneAfterCompletion||eventIR?.transitionPolicy?.endSceneAfterCompletion||current.eventTurns>=Math.max(1,+eventIR?.pacingPolicy?.minTurns||1))current.state='SEALED'}
    else if(context.overdue){current.state='BLOCKED';current.blockedReason='UNSATISFIED_TYPED_GOALS_AT_DEADLINE'}
    else current.state='ACTIVE';
    return current;
  }

  function authorizeEntityPromotion(input={}){
    const label=text(input.label),needle=normalize(label),tokens=contentTokens(label);
    if(!needle||tokens.length===0)return {authorized:false,source:'UNRESOLVED',reason:'ENTITY_LABEL_MISSING'};
    const sources=[
      ['USER_INPUT',input.userInput],
      ['PACKAGE',input.packageText],
      ['CANON',list(input.canonAliases).join(' ')]
    ];
    for(const [source,value] of sources){
      const haystack=normalize(value),hayTokens=contentTokens(value);
      const exact=haystack.includes(needle),tokenGrounded=tokens.length>1&&tokens.every(token=>hayTokens.some(got=>tokenMatch(token,got)));
      if(exact||tokenGrounded)return {authorized:true,source,reason:exact?'EXACT_SOURCE_SPAN':'SOURCE_TOKEN_GROUNDING'};
    }
    return {authorized:false,source:'MODEL_ONLY',reason:'PLOT_ENTITY_HAS_NO_AUTHORIZED_PROVENANCE'};
  }

  function requirementCoverage(requirement,evidence,negationPattern){
    const alternatives=requirementAlternatives(requirement),clauses=text(evidence).split(/(?<=[.!?。！？])\s+|\n+/u).map(value=>text(value)).filter(Boolean);
    let best={ok:false,ratio:0,alternative:alternatives[0]||'',clause:''};
    for(const alternative of alternatives){
      for(const clause of clauses){
        const result=coverage(alternative,clause),affirmed=!(negationPattern&&negationPattern.test(clause));
        if(result.ratio>best.ratio)best={...result,ok:result.ok&&affirmed,affirmed,alternative,clause};
        if(result.ok&&affirmed)return {...result,ok:true,affirmed:true,alternative,clause};
      }
    }
    return best;
  }

  function entityRefFor(ledger,label,evidence=''){
    const entries=list(ledger?.entries),active=entries.filter(entry=>entry?.active!==false&&entry?.targetRef&&['inventory_add','inventory_move','inventory_store'].includes(entry.kind));
    const labelTokens=contentTokens(label),evidenceText=normalize(evidence);
    let best=null;
    for(const entry of active){
      const tokens=contentTokens(entry.targetName||entry.statement),hits=tokens.filter(token=>labelTokens.some(other=>tokenMatch(token,other))||evidenceText.includes(token)),score=tokens.length?hits.length/tokens.length:0;
      if(!best||score>best.score||(score===best.score&&(+entry.sourceTurn||0)>(+best.entry.sourceTurn||0)))best={entry,score};
    }
    if(best&&best.score>=.5)return best.entry.targetRef;
    const canonical=contentTokens(label).join('-')||normalize(label)||'item';
    return `item-${hash(canonical)}`;
  }

  function reconcileCanon(ledger,candidates,turnNo){
    const out={...(ledger||{}),entries:list(ledger?.entries).map(entry=>({...entry}))},resolutionLedger={...(ledger||{}),entries:list(ledger?.entries).map(entry=>({...entry}))},added=[];
    for(const raw of list(candidates)){
      const candidate={...raw},statement=text(candidate.publicStatement||candidate.statement),evidence=text(candidate?.evidence?.text||candidate.evidence||candidate.evidenceText||statement);
      if(!statement)continue;
      if(['inventory_add','inventory_remove','destruction'].includes(candidate.kind))candidate.targetRef=candidate.targetRef||entityRefFor(resolutionLedger,candidate.targetName,evidence);
      if(candidate.kind==='destruction'||candidate.kind==='inventory_remove'){
        for(const entry of out.entries)if(entry.targetRef===candidate.targetRef&&entry.active!==false&&['inventory_add','inventory_move','inventory_store'].includes(entry.kind)){entry.active=false;entry.deactivatedAtTurn=turnNo;entry.deactivatedBy=candidate.kind;}
      }
      const lifecycle=['inventory_add','inventory_remove','destruction'].includes(candidate.kind),identity=lifecycle?`${candidate.kind}|${candidate.targetRef||''}|turn:${turnNo}`:`${candidate.kind}|${candidate.targetRef||''}|${normalize(statement)}`;
      if(out.entries.some(entry=>(lifecycle?`${entry.kind}|${entry.targetRef||''}|turn:${+entry.sourceTurn||0}`:`${entry.kind}|${entry.targetRef||''}|${normalize(entry.statement)}`)===identity))continue;
      const entry={...candidate,id:candidate.id||`canon-${hash(identity)}`,statement,sourceTurn:turnNo,visibility:'PUBLIC_CONFIRMED',active:true};
      out.entries.push(entry);added.push(entry);if(candidate.kind==='inventory_add')resolutionLedger.entries.push({...entry});
    }
    out.entries=out.entries.slice(-256);out.revision=Math.max(0,+out.revision||0)+added.length;
    return {ledger:out,added};
  }

  function repairCanonLedger(ledger){
    const out={...(ledger||{}),entries:[]};
    const ordered=list(ledger?.entries).map((entry,index)=>({...entry,__index:index})).sort((a,b)=>(+a.sourceTurn||0)-(+b.sourceTurn||0)||a.__index-b.__index);
    for(const raw of ordered){
      const entry={...raw};delete entry.__index;
      const evidence=text(entry?.evidence?.text||entry.evidence||entry.evidenceText||entry.statement);
      if(['inventory_add','inventory_remove','destruction'].includes(entry.kind))entry.targetRef=entry.targetRef||entityRefFor(out,entry.targetName,evidence);
      if(entry.kind==='inventory_remove'||entry.kind==='destruction'){
        for(const prior of out.entries)if(prior.targetRef===entry.targetRef&&prior.active!==false&&['inventory_add','inventory_move','inventory_store'].includes(prior.kind)){
          prior.active=false;prior.deactivatedAtTurn=+entry.sourceTurn||0;prior.deactivatedBy=entry.kind;
        }
      }
      const identity=['inventory_add','inventory_remove','destruction'].includes(entry.kind)?`${entry.kind}|${entry.targetRef||''}|turn:${+entry.sourceTurn||0}`:`${entry.kind}|${entry.targetRef||''}|${normalize(entry.statement)}`;
      if(out.entries.some(prior=>(['inventory_add','inventory_remove','destruction'].includes(prior.kind)?`${prior.kind}|${prior.targetRef||''}|turn:${+prior.sourceTurn||0}`:`${prior.kind}|${prior.targetRef||''}|${normalize(prior.statement)}`)===identity))continue;
      out.entries.push(entry);
    }
    out.entries=out.entries.slice(-256);out.revision=Math.max(+ledger?.revision||0,out.entries.length);
    return out;
  }

  function dedupeCarryover(entries){
    const map=new Map();
    for(const raw of list(entries)){
      if(!raw)continue;
      const key=raw.id||`syscarry-${hash(`${raw.kind||''}|${raw.eventRef||''}|${raw.beatRef||''}|${text(raw.statement)}`)}`,previous=map.get(key);
      if(!previous){map.set(key,{...raw,id:key});continue}
      const resolved=previous.status==='RESOLVED'||raw.status==='RESOLVED',newer=(+raw.sourceTurn||0)>=(+previous.sourceTurn||0)?raw:previous;
      map.set(key,{...previous,...newer,id:key,status:resolved?'RESOLVED':newer.status||'OPEN',...(resolved?{resolvedAt:raw.resolvedAt||previous.resolvedAt,resolvedAtTurn:raw.resolvedAtTurn||previous.resolvedAtTurn}:{})});
    }
    return [...map.values()];
  }

  function walk(value,path='root',out=[]){
    if(value==null||typeof value!=='object')return out;
    out.push({value,path});
    if(Array.isArray(value)){value.forEach((item,index)=>walk(item,`${path}[${index}]`,out));return out}
    for(const [key,item] of Object.entries(value))walk(item,`${path}.${key}`,out);
    return out;
  }

  function scoreArray(value,kind){
    if(!Array.isArray(value)||!value.length)return 0;
    const sample=value.slice(0,8).filter(item=>item&&typeof item==='object');if(!sample.length)return 0;
    if(kind==='events')return sample.reduce((score,item)=>score+(item.eventId||item.id?2:0)+(item.title||item.name?1:0)+(item.beats||item.completionSignals||item.requiredFunctions||item.startTime||item.schedule?3:0),0)/sample.length;
    return sample.reduce((score,item)=>score+(item.characterId||item.id?2:0)+(item.name||item.displayName?2:0)+(item.profile||item.publicProfile||item.aliases||item.voice||item.role?2:0)-(item.eventId||item.startTime||item.beats?3:0),0)/sample.length;
  }

  function discoverPackageParts(jsonFiles){
    const nodes=[];for(const [name,value] of Object.entries(jsonFiles||{}))walk(value,name,nodes);
    const arrays=nodes.filter(node=>Array.isArray(node.value)),objects=nodes.filter(node=>node.value&&!Array.isArray(node.value)&&typeof node.value==='object');
    const bestArray=kind=>arrays.map(node=>({...node,score:scoreArray(node.value,kind)})).sort((a,b)=>b.score-a.score)[0];
    const events=bestArray('events'),characters=bestArray('characters');
    const initial=objects.map(node=>({...node,score:(node.value.world?5:0)+(node.value.protagonist||node.value.mainCharacter||node.value.player?4:0)+(node.value.presentCharacterIds?2:0)})).sort((a,b)=>b.score-a.score)[0];
    const project=objects.map(node=>({...node,score:(node.value.title||node.value.name?2:0)+(node.value.genre?1:0)+(node.value.summary||node.value.synopsis?1:0)+(node.value.project?1:0)})).sort((a,b)=>b.score-a.score)[0];
    const runtime=objects.find(node=>node.value.format==='RELAY_NOVEL_NARRATIVE_RUNTIME_EXTENSION_V1')||objects.find(node=>Array.isArray(node.value.alternateBeats)||Array.isArray(node.value.characterDisclosure));
    return {events:events?.score>=3?events.value:[],characters:characters?.score>=3?characters.value:[],initial:initial?.score>0?initial.value:{},project:project?.score>0?(project.value.project||project.value):{},runtime:runtime?.value||null,paths:{events:events?.path||'',characters:characters?.path||'',initial:initial?.path||'',project:project?.path||'',runtime:runtime?.path||''}};
  }

  function validateScenario(scenario,source={}){
    const issues=[],warnings=[],people=[scenario?.protagonist,...list(scenario?.characters)].filter(Boolean);
    if(!text(scenario?.title))issues.push('TITLE_MISSING');
    if(!text(scenario?.protagonist?.name)||scenario?.protagonist?.name==='주인공')warnings.push('PROTAGONIST_GENERIC');
    if(!people.length)issues.push('CHARACTERS_MISSING');
    if(!text(scenario?.event?.id)||!text(scenario?.event?.title))issues.push('EVENT_MISSING');
    const importedPeople=people.filter(person=>text(person?.name)&&person.name!=='주인공');
    if((+source.characterCount>0&&importedPeople.length<+source.characterCount)||(source.hadCharacters&&!source.characterCount&&importedPeople.length===0))issues.push('CHARACTERS_LOST_DURING_IMPORT');
    if(+source.eventCount>0&&!text(scenario?.event?.id))issues.push('EVENTS_LOST_DURING_IMPORT');
    if(source.hadWorldLocation&&!text(scenario?.world?.location))issues.push('LOCATION_LOST_DURING_IMPORT');
    if(source.hadWorldTime&&!text(scenario?.world?.time))issues.push('TIME_LOST_DURING_IMPORT');
    if(source.hadEventSummary&&!text(scenario?.event?.summary))issues.push('ACTIVE_EVENT_SUMMARY_LOST');
    if(source.hadRelationships&&!list(scenario?.relationships).length)issues.push('RELATIONSHIPS_LOST_DURING_IMPORT');
    if(!text(scenario?.world?.location)&&!source.hadWorldLocation)warnings.push('WORLD_LOCATION_UNDECLARED');
    if(!text(scenario?.world?.time)&&!source.hadWorldTime)warnings.push('WORLD_TIME_UNDECLARED');
    return {ok:issues.length===0,issues,warnings};
  }

  const DREAM_ENTER_V15=/(?:꿈속|꿈을\s*꾸|꿈이었다|꿈인\s*듯|악몽|몽중|환몽)/u;
  const DREAM_EXIT_V15=/(?:꿈에서\s*깨|잠에서\s*깨|눈(?:을|이)\s*(?:뜨|떴|떠|뜬)|깨어나)/u;
  const DREAM_ANCHOR_V15=/(?:눈을\s*감|잠들|잠에\s*들|졸음|의식이\s*(?:흐려|멀어)|정신을\s*잃)/u;
  const DREAM_REFERENCE_V151=/(?:꿈속(?:에서|의)?|꿈에서|악몽에서)[^.!?。！？\n]{0,120}(?:뒤(?:라|라서|인지)?|후(?:라|라서|인지)?|느낌|기억|잔향|여운|것\s*같|듯(?:하|이)|떠올|회상|보았던|봤던|지냈던|겪었던)/u;
  const MEMORY_ENTER_V15=/(?:회상|기억\s*속|기억(?:을|이)?\s*떠올|떠올렸|떠올랐|생각났다|그때(?:를|가)?\s*떠올|과거(?:를|가)?\s*떠올)/u;
  const MEMORY_EXIT_V15=/(?:회상에서\s*벗어나|기억에서\s*돌아오|정신을\s*차리|현실로\s*돌아오)/u;
