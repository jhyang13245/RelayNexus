  r.eventEligibility={...r.eventEligibility,canConsumeEventTurn:true,revealCurrentEvent:true};
  if(added){const beats=rows(sc.event.beats).filter(b=>!b.runtimeExtension);for(let i=0;i<Math.min(count,beats.length);i++)beats[i].status='COMPLETED';const next=rows(sc.event.beats).findIndex(b=>b.status!=='COMPLETED'&&!b.runtimeExtension);if(next>=0){sc.event.activeBeatIndex=next;sc.event.beats[next].status='ACTIVE'}}
  r.eventTransition={schema:'CORTEX_EVENT_TRANSITION_V2',status:'ACTIVE',fromEventId:t.fromEventId,toEventId:id,authority:'PREVIOUS_EVENT_SEALED',migratedBeatCount:keys.length};
