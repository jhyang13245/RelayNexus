  const keys=[...new Set(rows(t.turnIds).filter(k=>typeof k==='string'&&k))];let added=0;
  for(const key of keys)if(!ledger.some(x=>x.eventId===id&&(x.beatKey||x.turnKey)===key)){ledger.push({eventId:id,beatKey:key,turnKey:key,migrated:true,authority:'PUBLIC_TRANSITION_RECEIPT'});added++}
  const count=Math.max(state.activeEventId===id?(+state.eventBeats||+state.eventTurns||0):0,ledger.filter(x=>x.eventId===id).length);
