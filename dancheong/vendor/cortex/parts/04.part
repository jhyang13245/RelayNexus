 }
 function expandSources(payload){const table=new Map(rows(payload.sourceTable).map(r=>[r.id,r.text]));const walk=v=>v&&typeof v==='object'?(v.$source?table.get(v.$source):Array.isArray(v)?v.map(walk):Object.fromEntries(Object.entries(v).filter(([k])=>k!=='sourceTable').map(([k,x])=>[k,walk(x)]))):v;return walk(payload)}
 function clockAfter(day,time,elapsed){const m=/^(\d{2}):(\d{2})(?::(\d{2}))?$/.exec(time||'');if(!m||+m[1]>23||+m[2]>59||+(m[3]||0)>59||!Number.isFinite(elapsed)||elapsed<0||!Number.isInteger(elapsed)||!Number.isInteger(day)||day<0)return null;const n=day*86400+(+m[1])*3600+(+m[2])*60+(+(m[3]||0))+elapsed;return {day:Math.floor(n/86400),time:[Math.floor(n%86400/3600),Math.floor(n%3600/60),n%60].map(x=>String(x).padStart(2,'0')).join(':')};}
 function evidenceSchema(schema){
  const walk=v=>{if(!v||typeof v!=='object')return v;if(Array.isArray(v))return v.map(walk);const o={};for(const [k,x]of Object.entries(v)){if(k==='properties'){o[k]={};for(const [name,property]of Object.entries(x))o[k][name==='evidenceQuote'?'evidenceId':name==='evidenceQuotes'?'evidenceIds':name]=walk(property)}else if(k==='required')o[k]=x.map(name=>name==='evidenceQuote'?'evidenceId':name==='evidenceQuotes'?'evidenceIds':name);else o[k]=walk(x)}return o};
  const out=walk(schema);out.required.unshift('evidence');out.properties={evidence:{type:'array',maxItems:96,items:{type:'object',additionalProperties:false,required:['id','sourceRef','quote'],properties:{id:{type:'string'},sourceRef:{type:'string'},quote:{type:'string',maxLength:280}}}},...out.properties};return out;
 }
 function expandEvidence(raw){
  if(!Array.isArray(raw.evidence))return raw; // Legacy saves and mock adapters.
  const table=new Map();for(const r of raw.evidence){if(!r.id||table.has(r.id))throw Error('INVALID_EVIDENCE_ID');table.set(r.id,r)}
  const quote=id=>{if(!id)return '';if(!table.has(id))throw Error('MISSING_EVIDENCE_ID');return table.get(id).quote};
  const walk=v=>v&&typeof v==='object'?(Array.isArray(v)?v.map(walk):Object.fromEntries(Object.entries(v).filter(([k])=>k!=='evidence').flatMap(([k,x])=>k==='evidenceId'?[['evidenceQuote',quote(x)],['evidenceSourceRef',x?table.get(x).sourceRef:'']]:k==='evidenceIds'?[['evidenceQuotes',x.map(quote)],['evidenceSourceRefs',x.map(id=>id?table.get(id).sourceRef:'')]]:[[k,walk(x)]]))):v;
  return walk(raw);
 }
 // Event selection belongs to the engine. Old transition receipts are already public commits.
 function activateEvent(sc){
  const r=sc.runtime||(sc.runtime={}),id=sc.event?.id,t=r.eventTransition;
