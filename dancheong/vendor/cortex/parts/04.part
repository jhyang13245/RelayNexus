  function defaultTime(context={}){const start=context.start||{},authority=context.temporalAuthority||{},direct=tick(authority.defaultEndDay,authority.defaultEndTime);if(direct!=null)return {day:+authority.defaultEndDay,time:clock(authority.defaultEndTime)};const a=tick(start.day,start.time);return a==null?{day:+start.day||0,time:clock(start.time)||'00:00:00'}:fromTick(a+Math.max(0,+authority.defaultCommitDurationSec||0))}
  function synthesizeTrack(track,resolved,context={}){const start=context.start||{},rows=list(track?.segments).map(row=>({...row}));if(!rows.length)rows.push({paragraphIndex:Math.max(1,paragraphs(context.prose).length),startDay:+start.day||0,startTime:clock(start.time),endDay:resolved.day,endTime:resolved.time,startLocation:start.location,endLocation:resolved.location,startLocationRef:start.locationRef,endLocationRef:resolved.locationRef,motionState:resolved.motionState,destinationLocation:resolved.destinationLocation,destinationLocationRef:resolved.destinationLocationRef,movementScope:'UNKNOWN',transitionReason:'독립 축 판정으로 확정된 비트 종료 상태',evidenceQuote:''});Object.assign(rows.at(-1),{endDay:resolved.day,endTime:resolved.time,endLocation:resolved.location,endLocationRef:resolved.locationRef,motionState:resolved.motionState,destinationLocation:resolved.destinationLocation,destinationLocationRef:resolved.destinationLocationRef});return normalize(rows,{start,turnId:context.turnId,source:'AXIS_RESOLVED_SPACETIME_TRACK'})}
  function resolve(track,inspection,context={}){const start=context.start||{},author=inspection?.candidate||finalState(track,start),claimTrack=trackFromClaims(context.claims,context),claim=finalState(claimTrack,start),timeStatus=inspection?.time?.status||'MISSING',locationStatus=inspection?.location?.status||'MISSING',timeAuthor=timeStatus==='ACCEPT'||timeStatus==='ESCALATE'&&timeClaimSupports(track,inspection,context),locationAuthor=locationStatus==='ACCEPT'||locationStatus==='ESCALATE'&&locationClaimSupports(track,inspection,context),fallbackTime=defaultTime(context),timeAxis=timeAuthor?{status:'ACCEPTED',authority:'PROSE_AUTHOR',day:author.day,time:author.time}:{status:timeStatus==='REJECT'?'REJECTED_FALLBACK':'DEFERRED_DEFAULT',authority:'TEMPORAL_DEFAULT_FALLBACK',...fallbackTime};let locationAxis;if(locationAuthor)locationAxis={status:'ACCEPTED',authority:'PROSE_AUTHOR',location:author.location,locationRef:author.locationRef,motionState:author.motionState,destinationLocation:author.destinationLocation,destinationLocationRef:author.destinationLocationRef};else if(claimTrack.complete)locationAxis={status:'CLAIM_FALLBACK',authority:'VERIFIED_CLAIM_FALLBACK',location:claim.location,locationRef:claim.locationRef,motionState:claim.motionState,destinationLocation:claim.destinationLocation,destinationLocationRef:claim.destinationLocationRef};else locationAxis={status:locationStatus==='REJECT'?'REJECTED_FALLBACK':'DEFERRED_PRIOR',authority:'PRIOR_STATE_FALLBACK',location:text(start.location),locationRef:text(start.locationRef),motionState:'STATIONARY',destinationLocation:'',destinationLocationRef:''};const resolvedState={day:timeAxis.day,time:timeAxis.time,location:locationAxis.location,locationRef:locationAxis.locationRef,motionState:locationAxis.motionState,destinationLocation:locationAxis.destinationLocation,destinationLocationRef:locationAxis.destinationLocationRef,source:'NARRATIVE_SPACETIME_AXIS_RESOLUTION_V1'},acceptedTrack=synthesizeTrack(track,resolvedState,context),bothAuthor=timeAxis.authority==='PROSE_AUTHOR'&&locationAxis.authority==='PROSE_AUTHOR',authority=bothAuthor?'PROSE_AUTHOR':locationAxis.authority==='VERIFIED_CLAIM_FALLBACK'&&timeAxis.authority==='TEMPORAL_DEFAULT_FALLBACK'?'VERIFIED_CLAIM_FALLBACK':timeAxis.authority==='TEMPORAL_DEFAULT_FALLBACK'&&locationAxis.authority==='PRIOR_STATE_FALLBACK'?'PRIOR_STATE_FALLBACK':'MIXED_AXIS_AUTHORITY',status=bothAuthor?'ACCEPT':locationAxis.authority==='VERIFIED_CLAIM_FALLBACK'&&inspection?.status==='MISSING'?'CLAIM_FALLBACK':'DEFERRED';return {schema:DECISION_SCHEMA,status,authority,time:timeAxis,location:locationAxis,resolvedState,acceptedTrack,hardIssues:list(inspection?.hardIssues),triggerCodes:list(inspection?.triggerCodes),agreement:inspection?.status==='ESCALATE'?(bothAuthor?'COMPATIBLE':'CONFLICT'):'NOT_REQUIRED'}}
  function applyToScenario(scenario,txn,track,decision=null){const adjudication=decision||txn?.narrativeSpacetimeDecision,selected=adjudication?.acceptedTrack||track,state=adjudication?.resolvedState||finalState(selected,{day:txn?.start?.day,time:txn?.start?.time,location:txn?.start?.location,locationRef:txn?.start?.locationRef||scenario?.world?.locationEntityRef}),nodes=list(scenario?.locationGraph?.nodes),matched=nodes.find(row=>text(row?.locationRef||row?.ref)===state.locationRef||key(row?.label||row?.name)===key(state.location)),authorLocation=adjudication?.location?.authority==='PROSE_AUTHOR',locationRef=state.locationRef||text(matched?.locationRef||matched?.ref)||(authorLocation&&state.location?`location:prose-${hash(state.location)}`:text(scenario?.world?.locationEntityRef));if(authorLocation&&state.location&&!matched&&!state.locationRef)scenario.locationGraph={schema:'CORTEX_LOCATION_GRAPH_V1',nodes:[...nodes,{locationRef,label:state.location,relation:'OBSERVED_IN_PROSE',source:'NARRATIVE_SPACETIME_TRACK_V1_GUARDED'}]};txn.endStatePatch={...(txn.endStatePatch||{}),worldDay:state.day,worldTime:state.time,location:state.location};const transit=['DEPARTED','IN_TRANSIT'].includes(state.motionState)&&state.destinationLocationRef?{schema:'CORTEX_WORLD_TRANSIT_V1',status:'EN_ROUTE_COMMITTED',fromLocationRef:text(txn?.start?.locationRef||scenario?.world?.locationEntityRef),fromLabel:text(txn?.start?.location),destinationLocationRef:state.destinationLocationRef,destinationLabel:state.destinationLocation,sinceDay:state.day,sinceTime:state.time}:null;scenario.world={...(scenario.world||{}),day:state.day,time:state.time,location:state.location,locationDescription:state.location,locationEntityRef:locationRef,transit};scenario.runtime=scenario.runtime||{};scenario.runtime.narrativeSpacetimeTrack=clone(selected);scenario.runtime.narrativeSpacetimeDecision=adjudication?{schema:DECISION_SCHEMA,status:adjudication.status,authority:adjudication.authority,time:clone(adjudicatio