/* Explicit model routing and bounded edits. No natural-language keyword verdicts. */
(()=>{'use strict';
 const SCOPES=['DISCLOSURE','ORDER','MATERIAL','FIXED_FACT'];
 const copy=v=>structuredClone(v),rows=v=>Array.isArray(v)?v:[];
 const object=properties=>({type:'object',additionalProperties:false,required:Object.keys(properties),properties});
 // One opening-only literal check. No inferred aliases, fragments, normalization or semantic verdict.
 function openingProtectedTerms(paragraph,{protectedTerms=[],publicTexts=[],revealedTerms=[]}={}){
  const revealed=new Set(rows(revealedTerms));return [...new Set(rows(protectedTerms).filter(t=>typeof t==='string'&&t.trim()))].filter(t=>!revealed.has(t)&&!rows(publicTexts).some(p=>typeof p==='string'&&p.includes(t))&&String(paragraph).includes(t));
 }
 function contractKey(value){const s=JSON.stringify(value);let h=2166136261;for(let i=0;i<s.length;i++)h=Math.imul(h^s.charCodeAt(i),16777619);return (h>>>0).toString(36)+':'+s.length;}
 // Group only already completed, consecutive paragraphs. Never wait for a batch to fill.
 function takeReadyBatch(queue,{maxParagraphs=4,maxChars=900}={}){
  const parts=[];let chars=0;
  while(queue.length&&parts.length<maxParagraphs){const next=queue[0];if(parts.length&&chars+2+next.length>maxChars)break;queue.shift();chars+=next.length+(parts.length?2:0);parts.push(next);}
  return {text:parts.join('\n\n'),paragraphs:parts.length,chars};
 }
 function batchAnnotation(records,paragraphIndex,draft){
  const parts=String(draft).split(/\n\s*\n/u).filter(Boolean),scopes=new Set();
  for(let i=0;i<parts.length;i++){const row=rows(records).find(r=>r.paragraphIndex===paragraphIndex+i&&r.text===parts[i].trim()),a=row?.audit;
   if(a?.version!==1||!Array.isArray(a.scopes)||!a.scopes.every(s=>SCOPES.includes(s))||typeof a.rationale!=='string')return null;
   a.scopes.forEach(s=>scopes.add(s));
  }
  return parts.length?{version:1,scopes:[...scopes],rationale:'인접 원문 문단의 작가 지정 범위 합집합'}:null;
 }
 function route(annotation,{repair=false,positivePrivateMatch=false,guards=null,eventId=''}={}){
  const valid=annotation?.version===1&&Array.isArray(annotation.scopes)&&annotation.scopes.every(s=>SCOPES.includes(s))&&typeof annotation.rationale==='string';
  let scopes=valid?[...new Set(annotation.scopes)]:[...SCOPES];
  const guardsValid=guards?.eventId===eventId&&guards?.reviewed===true&&Array.isArray(guards.scopes)&&guards.scopes.every(s=>SCOPES.includes(s));
  if(guardsValid)scopes=[...new Set([...scopes,...guards.scopes])];
  if(positivePrivateMatch&&!scopes.includes('DISCLOSURE'))scopes.push('DISCLOSURE');
  if(repair&&!scopes.length)scopes=[...SCOPES];
  return {scopes,review:scopes.length>0,source:valid?'AUTHOR_SCOPED_REVIEW':'MISSING_ROUTING_REVIEW',positivePrivateMatch,annotation:valid?copy(annotation):null};
 }
 const authorInstruction='기존 <!--CORTEX_ST_V1 ... --> 안의 segments 배열의 해당 문단 객체에 "audit":{"version":1,"scopes":[],"rationale":"짧은 적용 사유"} 속성을 넣는다. audit를 마커 밖에 별도 줄로 출력하지 않는다. 이것은 안전 승인 아닌 감사 범위 선택이다. 새 정보·정체·문서 내용을 드러내거나 타인이 정보를 아는 대사는 DISCLOSURE, 순서 조건에 걸릴 수 있는 되돌릴 수 없는 행동은 ORDER, 물건 확보·권한·정보 접근 등 다음 행동의 중요한 전제를 실현/사용하면 MATERIAL, 고정 문구·날짜·사실을 명시하면 FIXED_FACT를 scopes에 넣는다. 여러 개 가능하다. 불확실하면 해당 범위를 넣는다. 단순 감각·일상 행동·비유·의도 변경이며 위 사항이 없을 때만 빈 배열이다. 사건 목표가 아직 안 나온 것은 감사 사유가 아니다. 미공개 정답을 rationale에 복사하지 않는다.';
 function request(base,selection){
  const old=base.payload,context=old.contextOrder||{};
  const publicState=old.publicState||{};
  const p={schema:'CORTEX_SCOPED_PUBLICATION_INPUT_V1',scopes:selection.scopes,
   longTermMemory:old.longTermMemory||[],publicHistory:rows(old.eventHistory).map(r=>({turnId:r.turnId||r.id,eventId:r.eventId||r.sourceEventId,text:r.text})),
   previousPublishedTail:context.previousPublishedTail||'',currentPublishedPrefix:context.currentPublishedPrefix||old.priorPublicText||'',
   priorEditorDecision:old.priorEditorDecision||null,repairContext:publicState.repairContext||null,draft:old.draft};
  if(selection.scopes.some(s=>['DISCLOSURE','ORDER','FIXED_FACT'].includes(s)))p.protectionReference={sourceContract:publicState.sourceContract,publicCast:publicState.publicCast||[],authority:'REFERENCE_FOR_EXPLICIT_PROHIBITIONS_ORDER_AND_FIXED_FACTS_ONLY_NOT_COMPLETION_MANDATE'};
  if(selection.scopes.includes('DISCLOSURE')){p.knowledge=publicState.connections?.knowledge||[];p.privateRisk=old.privateRisk;p.publicCatalog=old.publicCatalog;p.publicConstraints=old.publicConstraints;}
  if(selection.scopes.includes('MATERIAL'))p.dependencies=publicState.connections;
  const developer=[
   '너는 선택된 scopes만 확인하는 공개 전 보호 담당이다. 문체·비유·의인화·일상 동작 생략·새 사용자 의도는 교정하지 않는다. 사건의 목표를 이 문단에 넣지 않는다.',
   'FIXED_FACT에 포함되는 기본 신원: protectionReference.publicCast의 공개 성별·나이·가족관계와 호칭을 대조한다. 남동생이 남성 형제를 누나라고 부르는 등 실제 충돌은 해당 호칭만 최소 수리한다. 화자와 지칭 대상을 먼저 확인하고, 인용·별명·명시된 농담이나 위장은 자동 치환하지 않는다. 과거 본문의 호칭 오류는 성별 변경의 근거가 아니다. 미공개 신원은 추정하지 않는다.',
   '원문은 이전 비트 publicHistory → 현재 비트의 실제 공개본 currentPublishedPrefix → 미공개 draft 순서다. 현재 상태는 그 순서대로 일어난 변화의 결과다. 앞 비트의 이동·반납을 현재 비트의 행동보다 나중에 일어난 것으로 읽지 않는다. priorEditorDecision은 이번 비트에서 기각된 감사 주장과 편집자 이유이며 사실 장부가 아니다. 같은 근거만으로 반복 제안하지 않되 새로운 충돌은 검사한다. 과거와 다르거나 기록에 없다는 이유만으로 모순을 주장하지 않는다. 단, 잃거나 사용할 수 없게 된 수단이 회복 경로 없이 중요한 행동에 쓰이는지는 원문의 최신 상태로 확인한다.',
   '감사는 사건 종결의 달성을 강제하지 않는다. privateRisk 표는 columns 순서로 각 행을 읽고 없는 matchedFragments는 빈 배열이다. unsafeSurfaces에는 draft의 실제 구절만 쓴다. 공개 조건과 정답은 출력하지 않는다.',
   'DISCLOSURE: 명시적 비공개 조건이 있는 비밀 또는 인물이 실제로 알 수 없는 중요한 지식만 확인한다. publicCatalog에 있는 기본 이름·가족관계·일상 지식 자체를 비밀로 만들거나 매번 취득 장면을 요구하지 않는다. 서술자의 기본 인물 소개와 인물이 새 비밀을 알아낸 행동을 구별한다. 현재 prefix에서 공개된 정보는 숨기려고 되돌리지 않는다. 화면·문서·대화에서 직접 읽거나 듣는 행위는 취득 경로다. 공개 순서 위반 여부와 경로 부재를 구분한다. 단순 감각/익살을 초자연 사실로 확대하지 않는다. ORDER: 필수 선행조건을 실제로 건너뛰는 후행 행동만 확인한다. 미달성과 위반은 다르다.',
   'MATERIAL: 후속 중요 행동의 가능 여부를 바꾸는 소유·접근·권한의 실제 충돌만 다룬다. draft나 prefix의 새 인계·이동·확인은 허용한다. 같은 장면의 세부 배치·자세·일상적인 용기 취급을 일일이 입증하게 하지 않는다. 대상 곁에 놓았다는 서술만으로 봉인 해제나 내용 접근을 추정하지 않는다. 반대로 앞서 잃거나 거절한 특정 대상을 닮은 새 대상으로 대체해 같은 일을 완수한 것으로 취급하는 것은 중요한 충돌이다.',
   'FIXED_FACT: 명시적으로 고정된 설정/원문과 양립 불가능한 주장을 확인한다. 신체 상태·위치·자세·소지·의도·관계는 변할 수 있다. 이전 공개 상태는 그때의 사실이며 이후 회복·변화 자체를 모순으로 보지 않는다. 현재 초안에 인과적 변화가 있으면 보존한다. 과거 상태를 소급 취소하거나 필요한 연결 없이 결과만 바꾸는 경우와 구분한다. 비유·주관적 생각과 실제 사실을 구별한다. protectionReference의 사건 결과·완료 조건은 이 문단에서 달성시킬 지시가 아니며 종결 미달은 검사하지 않는다.',
   '표현의 문자적 차이만으로 수리하지 않는다. 문맥상 같은 기능 상실·부재·상태를 가리키는 생략이나 관용 표현은 PASS다. 실제 후속 행동의 가능 여부·정보 공개·소유·위치가 달라지는 분명한 문제만 REPAIR로 제안하고 basis, draftClaim, incompatibility에 서로 충돌하는 근거를 짧게 쓴다. 애매한 일반 문맥은 PASS다. 중요한 비밀/필수 순서의 불확실성은 REPAIR/OTHER_PUBLICATION_RISK로 해당 부분만 보류 제안한다. 위험한 이유를 설명할 때 비공개 내용은 복사하지 않는다.',
   'repairContext가 있으면 앞 감사의 주장도 틀릴 수 있다. 원문이 성립하면 KEEP 가능한 판단을 하고, 수정으로 후속 초안의 전제가 달라졌을 때만 tailDisposition=REGENERATE다. 단순 미달성·길이·더 좋은 문체를 이유로 수정하지 않는다. draft는 시간순 인접 문단 묶음일 수 있다. 뒤 문단의 취득·허가는 그 이전 행동의 근거가 될 수 없다. 묶음 내부의 선후관계도 읽는다. PASS이면 code=NONE, reason은 짧게, 나머지 근거·교정 문자열은 빈 문자열, 배열은 빈 배열, tailDisposition=KEEP으로 반환한다. REPAIR일 때만 실제 모순과 최소 교정에 필요한 근거를 쓴다. 지정 JSON만 출력한다.'
  ].join('\n');
  return {developer,payload:p,schema:base.schema};
 }
 const editSchema=object({decision:{type:'string',enum:['KEEP','EDIT']},reason:{type:'string',maxLength:300},changesPremise:{type:'boolean'},edits:{type:'array',maxItems:3,items:object({before:{type:'string',minLength:1,maxLength:1600},after:{type:'string',maxLength:1600}})}});
 function applyEdit(draft,proposal){
  if(!['KEEP','EDIT'].includes(proposal?.decision)||!Array.isArray(proposal.edits))throw Error('INVALID_MINIMAL_EDIT');
  if(proposal.decision==='KEEP'){if(proposal.edits.length)throw Error('KEEP_WITH_EDITS');return {text:draft,kept:true,changesPremise:false};}
  if(!proposal.edits.length||proposal.edits.length>3)throw Error('INVALID_EDIT_COUNT');
  const spans=proposal.edits.map(e=>{if(typeof e.before!=='string'||!e.before||typeof e.after!=='string')throw Error('INVALID_EDIT_SPAN');const at=draft.indexOf(e.before);if(at<0||draft.indexOf(e.before,at+1)>=0)throw Error('AMBIGUOUS_EDIT_SPAN');return {at,end:at+e.before.length,after:e.after}}).sort((a,b)=>a.at-b.at);
  for(let i=1;i<spans.length;i++)if(spans[i].at<spans[i-1].end)throw Error('OVERLAPPING_EDIT');
  let text=draft;for(const s of spans.reverse())text=text.slice(0,s.at)+s.after+text.slice(s.end);
  if(!text.trim())throw Error('EMPTY_EDIT_RESULT');return {text,kept:false,changesPremise:proposal.changesPremise===true};
 }
 const editInstruction='너는 감사의 주장을 독립적으로 검토하는 국소 편집자다. 감사도 오판할 수 있다. code가 TECHNICAL_REVIEW_UNAVAILABLE이면 감사의 모순 주장이 없는 통신 실패다. protectionContext.scopes의 보호 범위만 직접 확인하여 KEEP/EDIT를 최종 결정한다. 통신 실패 자체를 본문 결함으로 취급하지 않는다. protectionContext의 이전 공개 원문과 현재 prefix가 기준이다. 공개 원문에 반대되는 과거 행동을 새로 끼워 넣어 초안을 합리화하지 않는다. 미공개 후속 초안보다 공개 과거의 보존이 우선이다. 현재 시점의 실제 새 행동·개입·회복으로 자연스럽게 성립하면 KEEP하고 edits=[]다. 변화 전 상태와 다르다는 이유만으로 되돌리지 않는다. 원인 없이 상태를 바꾼 경우에만 필요한 연결을 최소 수정한다. 잘못된 감사에 맞춰 사용자 행동을 지우지 않는다. 문맥상 같은 상태를 가리키는 표현이나 일상적인 세부 배치·용기 취급을 지나치게 읽은 감사라면 KEEP한다. 원문에 없는 개봉·내용 접근을 단순 위치 표현에서 추정하지 않는다. 실제로 정보 공개나 후속 행동의 가능성을 바꾸는 명백한 보호 위반만 EDIT한다. before는 초안의 유일한 연속 구절, after는 그 부분의 최소 대체문이다. 최대3부분이며 나머지 문장을 다시 쓰지 않는다. 원문을 지키려면 사용 수단·소지·인지·행동 결과를 바꿔야 하는 경우 그 부분을 고치고 changesPremise=true로 후속 초안을 새로 잇게 한다. 사건 목표 삽입·일상 과정 의무화·문체 평탄화는 금지한다. 비밀을 보충하지 않는다. changesPremise는 수정 때문에 미공개 후속 초안이 의존하는 소유·위치·인지·행동 결과가 더 이상 성립하지 않을 때만 true다. 같은 장면의 세부 위치나 동의 표현을 바꾼 것만으로 후속 전체를 폐기하지 않는다. draft가 여러 문단이면 내부 인과도 함께 보존하고, 부분 수정이 같은 묶음 뒤 문장을 무효로 만들면 그 의존 부분도 함께 고친다. 최소 편집으로 묶음 전체를 일관되게 고칠 수 없으면 문제 발생 직전까지 보존하고 그 뒤 미공개 부분을 제거하여 changesPremise=true로 새로 잇는다. 출력은 지정 JSON이며 내부 시공간 마커를 만들지 않는다. 이 KEEP/EDIT 결정은 재감사 없이 적용되므로 실제 보호 위반과 단순 상태 변화를 구별한다. 현재 사건에서 공개 가능한 관계·사실과 미래 정보의 공개를 구별한다. 문제가 있는 정보만 고치고 같은 문장의 합법적인 관계·생활 사실까지 삭제하지 않는다. 필요하면 그 사실을 발신인 정체와 분리해 자연스러운 서술로 보존한다. 현재 사건의 미충족 목표를 새로 채우라는 뜻은 아니다.';
 Object.defineProperty(globalThis,'CortexPublicationPolicy',{value:Object.freeze({takeReadyBatch,batchAnnotation,route,request,authorInstruction,editSchema,applyEdit,editInstruction,contractKey,openingProtectedTerms})});
})();

/* Public prose is the narrative authority. IDs here identify storage units only. */
(()=>{'use strict';
 const rows=v=>Array.isArray(v)?v:[], copy=v=>structuredClone(v), text=v=>typeof v==='string'?v:'';
 const schema='CORTEX_PROSE_MEMORY_V1';
 function withOpening(turns,{opening='',eventId=''}={}){return opening&&eventId?[{id:'public-opening:'+eventId,sourceEventId:eventId,status:'COMMITTED',text:opening},...rows(turns)]:rows(turns);}
 const timeInstruction='현재 공개 원문과 startState에서 앞으로 이어 쓴다. 사건별 배정 시간표는 없으며 현재 사건 설명에 명시된 시간·경과와 장면의 인과를 읽고 실제 시간을 정한다. 작품 근거 없이 사용자 요청이나 임의 전개로 24시간 이상 도약하지 말고 자연스러운 중단·단축으로 흡수한다. 자정을 넘는 것 자체는 금지가 아니며 현재 제공된 작품 스토리가 사흘 뒤·10년 혼수상태 같은 도약을 명시하면 그 경과를 허용한다. 24시간 미만도 진행 중인 위험·행동·긴박성을 무너뜨리면 우선 인과적으로 우회한다. 꿈·환상은 금지는 아니지만 최후의 수단이고 같은 구제를 반복하지 않는다. 새 사건을 처음 읽었을 때 그 시간대가 이미 지났다면 공개 시각을 보존하며 가까운 다음 시간대까지 필요한 일상을 짧게 연결해 그 비트 안에서 사건을 시작한다. 기다리기 입력이나 별도 준비 비트를 요구하지 않는다. 이미 마감·기회를 넘겼다면 지연·상황 변화·대체 기회의 원인과 결과를 설득력 있게 집필한다. 이미 출발·종료했다고 공개한 사실을 없었던 일로 바꾸지 않고 그 이후 새 인과로 잇는다. 다음 사건 내용은 추측하거나 선취하지 않는다. clockEnd는 해당 문단 마지막 실제 날짜·시각이며 다른 인물의 위치·회상과 주인공의 현재를 구별한다. 이미 공개된 경과는 사후 상한으로 되돌리거나 0초로 묶지 않는다.';
 const alternateEnd=t=>t?.transition?.closureMode==='ALTERNATIVE'||t?.transition?.status==='SEALED_FORCED_INCOMPLETE';
 function closureTip(turn,turns){if(turn?.status!=='COMMITTED'||!alternateEnd(turn))return null;const previous=rows(turns).filter(t=>t!==turn&&t.status==='COMMITTED'&&/^SEALED/.test(t.transition?.status||'')).at(-1);if(alternateEnd(previous))return null;return '이야기가 다른 흐름으로 이어졌습니다. 지금까지의 상황과 인물의 행동에 자연스럽게 이어지는 입력을 해보세요. 사건이 더 매끄럽게 연결되고, 이야기의 몰입도도 높아집니다.';}
 function fingerprint(value){let a=2166136261,b=5381;for(const c of JSON.stringify(value)){a=Math.imul(a^c.charCodeAt(0),16777619);b=Math.imul(b,33)^c.charCodeAt(0)}return (a>>>0).toString(16)+(b>>>0).toString(16)}
 function events(turns){const out=[],map=new Map();for(const t of rows(turns)){if(t.status!=='COMMITTED'||!text(t.text).trim())continue;const id=text(t.sourceEventId)||text(t.txn?.eventId)||'legacy-unassigned';let e=map.get(id);if(!e){e={eventId:id,turns:[]};map.set(id,e);out.push(e)}e.turns.push({turnId:t.id,text:t.text})}return out}
 function sourceKey(group){return fingerprint(group)}
 function validRecords(memory,all){const byId=new Map(all.map(e=>[e.eventId,e]));return rows(memory?.summaries).filter(s=>s.text&&[...s.text].length<=1000&&rows(s.eventIds).length&&s.eventIds.every(id=>byId.has(id))&&sourceKey(s.eventIds.map(id=>byId.get(id)))===s.sourceKey)}
 function plan(turns,currentEventId,memory={}){
  const all=events(turns),ids=all.map(e=>e.eventId);if(currentEventId&&!ids.includes(currentEventId))ids.push(currentEventId);
  const recent=new Set(ids.slice(-3)),valid=validRecords(memory,all),eligible=valid.filter(s=>s.eventIds.some(id=>!recent.has(id)));
  // Keep three-event summaries independently. Legacy archives are read-only fallbacks.
  eligible.sort((a,b)=>a.eventIds.length-b.eventIds.length);const covered=new Set(),summaries=[];
  for(const s of eligible){if(s.eventIds.some(id=>covered.has(id)))continue;s.eventIds.forEach(id=>covered.add(id));summaries.push({eventIds:copy(s.eventIds),text:s.text})}
  summaries.sort((a,b)=>ids.indexOf(a.eventIds[0])-ids.indexOf(b.eventIds[0]));
  const raw=all.filter(e=>recent.has(e.eventId)||!covered.has(e.eventId));return {schema,authority:'FINAL_PUBLIC_PROSE',recentEventIds:[...recent],summaries,rawEvents:copy(raw),rawChars:raw.reduce((n,e)=>n+e.turns.reduce((n,t)=>n+t.text.length,0),0),unsummarizedEventIds:raw.filter(e=>!recent.has(e.eventId)).map(e=>e.eventId)};
 }
 function readingContext(plan){return {summaries:copy(rows(plan?.summaries)),publicProse:rows(plan?.rawEvents).flatMap(e=>rows(e.turns).map(t=>text(t.text))).join('\n\n')};}
 function writerMessages(developer,user){
  const messages=[{role:'developer',content:[{type:'input_text',text:developer}]}];
  let payload;try{payload=JSON.parse(user)}catch{}
  if(payload?.schema!=='CORTEX_PROSE_WRITER_V1')return [...messages,{role:'user',content:[{type:'input_text',text:user}]}];
  const intent=text(payload.rawUserInput);delete payload.rawUserInput;
  if(payload.memory?.rawEvents)payload.memory=readingContext(payload.memory);
  return [...messages,{role:'user',content:[{type:'input_text',text:JSON.stringify(payload)}]},{role:'user',content:[{type:'input_text',text:intent}]}];
 }
 function nextJob(turns,currentEventId,memory={}){
  const all=events(turns),closed=all.filter(e=>e.eventId!==currentEventId),valid=validRecords(memory,all);
  for(let i=0;i+3<=closed.length;i+=3){const group=closed.slice(i,i+3),key=sourceKey(group);if(!valid.some(s=>s.sourceKey===key))return {kind:'THREE_EVENTS',eventIds:group.map(e=>e.eventId),sourceKey:key,source:copy(group)}}
  return null;
 }
 function accept(memory,job,result,turns){const body=text(result).trim();if(!body||[...body].length>1000)throw Error('MEMORY_LENGTH_INVALID');const all=events(turns),group=job.eventIds.map(id=>all.find(e=>e.eventId===id));if(group.some(e=>!e)||sourceKey(group)!==job.sourceKey)throw Error('MEMORY_SOURCE_CHANGED');return {schema,summaries:[...validRecords(memory,all).filter(s=>s.sourceKey!==job.sourceKey),{eventIds:copy(job.eventIds),sourceKey:job.sourceKey,text:body,kind:job.kind}]}}
 const summaryInstruction='너는 소설 장기기억 요약 담당이다. 제공된 최종 공개 원문 전체를 읽고 한국어 서술형으로 1,000자 이내에 요약한다. 지나치게 짧게 줄이지 않는다. 실제 전개와 인과관계, 인물의 구별, 중요한 대화·정보·약속과 미해결 사항을 보존한다. 의도·관찰·전언을 실행·소유·확정 사실로 바꾸지 않는다. 모호한 사실은 모호함을 유지한다. 사용자 입력이나 미래 설정을 사실로 추가하지 않는다. 인물 ID, 상태표, 등록 정보는 만들지 않는다. 요약문만 출력한다. ARCHIVE는 제공된 과거 요약들을 같은 원칙으로 통합한다.';
 const obj=p=>({type:'object',additionalProperties:false,required:Object.keys(p),properties:p}),str={type:'string'},closureKeys=['goalsMet','sceneActionSettled','sceneSettled','handoffReady'];
 const judgeSchema=obj({requirements:{type:'array',items:obj({requirementRef:str,status:{type:'string',enum:['MET','ALTERNATIVE_MET','UNMET','UNCERTAIN','OUT_OF_SCOPE']},reason:{type:'string',maxLength:240}})},earlyClosure:obj({...Object.fromEntries(closureKeys.map(k=>[k,{type:'string',enum:['YES','NO','UNCERTAIN']}])),reason:{type:'string',maxLength:240}})});
 const judgeInstruction='너는 사건 종결 판정관이다. fullText의 시간순 공개 원문 전체를 먼저 읽고 현재 사건 조건을 판단한다. 사용자 요청·요약·이전 판정은 증거가 아니다. sourceContract와 requirements는 달성 기준이며 그 내용이 실제 일어났다고 가정하지 않는다. 과거·현재의 실제 행동과 계획·전언·관찰을 구별하고, 마지막 비트에 이미 성립한 사실을 반복할 필요는 없다. 공개 원문은 현재 사건과 이전 두 사건이다. 조건이 요구하는 과거 시점이 이 범위 밖이라 확인할 수 있을 때만 OUT_OF_SCOPE다. 현재 목표 미달은 UNMET 또는 UNCERTAIN이다. sourceContract.occurrenceContext는 사건 시작 자격의 참고다. 내부 루트 활성·사건 봉인 상태를 본문에서 다시 증명하라고 요구하지 않는다. 조건에 명시된 실제 서사상 선행 순서는 보존한다. 각 조건은 원본이 허용한 성공 경로 또는 대체 경로 중 실제 성립한 경로로 읽는다. 정상 목표가 실제 성립하면 MET, 허용된 대체 경로가 실제 성립하여 그 목표를 대체·생략했다면 ALTERNATIVE_MET과 대체 사유를 쓴다. 대체에서도 남는 필수 결과가 미달이면 UNMET이다. 우회가 쉽거나 사용자가 거절했다는 이유만으로 면제하지 않는다. 대체 달성을 정상 행동 수행으로 꾸미지 않는다. 현재 위치에 원래부터 있었다면 귀가·이동했다고 쓰지 않고, 이미 공개된 최초 발견을 새 발견으로 다시 만들지 않는다. 복합 조건은 필수 결과·선택 개수·제약을 구분하고 일부만 성립한 것을 전체 MET으로 만들지 않는다. 관계는 원문 문맥과 암시로 판단하되 동거만으로 특정 관계를 단정하지 않는다. 인물 등록·상태 장부·인용문·본문 수리는 출력하지 않는다. requirements 각각의 MET/ALTERNATIVE_MET/UNMET/UNCERTAIN/OUT_OF_SCOPE와 짧은 이유만 반환한다. earlyClosure는 허용 대체 경로의 완료도 goalsMet=YES로 읽되 실제 미달은 NO다. 현재 사건에서 시작한 필수 행동이 정리되고 장면이 끝나면 sceneActionSettled와 sceneSettled를 YES로 한다. 다음 사건에서 할 일·새 수수께끼·원본이 남겨 둔 선택은 미달 사유가 아니다. 다음 장소에 미리 도착할 필요는 없다. 최소 2비트는 엔진이 관리한다.';
 function verdict(raw,requirements){const known=new Set(rows(requirements).map(r=>r.ref)),seen=new Set();if(!raw||!Array.isArray(raw.requirements)||!raw.earlyClosure)throw Error('VERDICT_FORMAT');for(const r of raw.requirements){if(!known.has(r.requirementRef)||seen.has(r.requirementRef)||!['MET','ALTERNATIVE_MET','UNMET','UNCERTAIN','OUT_OF_SCOPE'].includes(r.status))throw Error('VERDICT_REQUIREMENTS');seen.add(r.requirementRef)}if(seen.size!==known.size||closureKeys.some(k=>!['YES','NO','UNCERTAIN'].includes(raw.earlyClosure[k])))throw Error('VERDICT_INCOMPLETE');return {available:true,requirements:raw.requirements.map(r=>({requirementRef:r.requirementRef,status:r.status,reason:text(r.reason)})),earlyClosure:{...copy(raw.earlyClosure),userActionSettled:raw.earlyClosure.sceneActionSettled}}}

 function judgeWindow(turns,currentEventId,{opening='',openingEventId=''}={}){const all=events(turns),ids=all.map(e=>e.eventId);if(currentEventId&&!ids.includes(currentEventId))ids.push(currentEventId);const at=ids.indexOf(currentEventId),recent=ids.slice(Math.max(0,at-2),at+1);return {schema:'CORTEX_JUDGE_WINDOW_V1',eventIds:recent,initialPublicProse:recent.includes(openingEventId)?text(opening):'',rawEvents:copy(all.filter(e=>recent.includes(e.eventId)))};}
 const nonblocking=r=>['MET','ALTERNATIVE_MET','OUT_OF_SCOPE','AUTHOR_ACCEPTED'].includes(r?.status);

 function requirementDisplay(event, saved){const same=saved?.eventId===event?.id,records=same?saved?.records:null,legacy=same?saved?.verdicts:null;return rows(event?.requiredFunctions).map(r=>{const ref=r.ref||r.id,label=text(r.description)||text(r.label),record=records?.[ref],status=record?.status||(records?'UNREVIEWED':legacy?.[label]===true?'MET':'UNREVIEWED');return {ref,label,status,met:status==='MET',allowed:nonblocking({status}),reason:text(record?.reason)};});}
 function judgeContract(contract){const result=copy(contract),conditions=result.fields?.conditions;delete result.fields?.conditions;if(conditions)result.occurrenceContext=conditions;return result;}
 function extensionReview(enabled,scope,requirements,records){if(!enabled)return null;return {scope:copy(scope),requirements:copy(requirements),missing:rows(requirements).filter(r=>!nonblocking(records?.[r.ref])).map(r=>({requirementRef:r.ref,condition:r.description,status:records?.[r.ref]?.status||'UNCERTAIN',reason:records?.[r.ref]?.reason||'직전 판정 없음'}))};}
 function acceptObjections(review,raw){const allowed=new Set(rows(review?.missing).map(r=>r.requirementRef)),seen=new Set();return rows(raw).filter(r=>{if(rows(raw).filter(x=>x?.requirementRef===r?.requirementRef).length!==1||!allowed.has(r?.requirementRef)||seen.has(r.requirementRef)||!['ALREADY_MET','EXTRA_DEMAND'].includes(r.basis)||!text(r.reason).trim())return false;seen.add(r.requirementRef);return true}).map(r=>({requirementRef:r.requirementRef,basis:r.basis,reason:text(r.reason),status:'AUTHOR_ACCEPTED'}));}
 function objectionReceipt(review,data={}){const candidates=rows(data.candidates),accepted=acceptObjections(review,candidates),decisions=rows(review?.missing).map(condition=>{const matches=candidates.filter(r=>r?.requirementRef===condition.requirementRef),r=matches[0],valid=matches.length===1&&['ACCEPT_JUDGMENT','ALREADY_MET','EXTRA_DEMAND'].includes(r?.basis)&&text(r?.reason).trim();return {...copy(condition),decision:!r?'MISSING':valid?r.basis:'INVALID',authorReason:valid?text(r.reason):'',eventIds:copy(review?.scope?.eventIds||[]),result:valid?(r.basis==='ACCEPT_JUDGMENT'?'FOLLOW_JUDGMENT':'AUTHOR_ACCEPTED'):'NO_INFERENCE'};}),excludedCount=candidates.filter(r=>!decisions.some(d=>d.requirementRef===r?.requirementRef&&!['MISSING','INVALID'].includes(d.decision))).length,invalidFields=+data.invalidFields||0;return {status:invalidFields||excludedCount||decisions.some(d=>d.decision==='INVALID')?'INVALID':decisions.some(d=>d.decision==='MISSING')?(data.provided&&!candidates.length?'EMPTY':'MISSING'):accepted.length?'ACCEPTED':decisions.length?'JUDGMENT_ACCEPTED':data.provided?'EMPTY':'MISSING',provided:data.provided===true,invalidFields,excludedCount,candidates:copy(candidates),accepted,decisions};}
 const extensionInstruction='extensionReview가 있을 때만 직전 판정의 미충족 사유를 검토한다. 반문 판단 근거는 extensionReview.scope의 동일한 3사건 공개 원문과 원래 조건으로 한정한다. 집필용 장기기억이나 사용자 요청을 반문의 증거로 삼지 않는다. 지적이 맞으면 이번 장면에서 인과적으로 보완한다. 이미 달성했거나 원래 조건에 없는 요구라면 반복·취소하지 않고 작가 판단으로 이의를 제기한다. 단지 쓰기 어렵거나 이번 초안에서 새로 채운 것은 이의가 아니다. 관계·정체성·결과가 대사와 서술의 연결이나 자연스러운 암시로 이미 전달되었다면 그것도 ALREADY_MET의 근거다. 판정관이 요구하는 노골적인 재설명에 맞추어 좋은 본문을 반복하거나 취소하지 않는다. reason에는 기존 공개 원문의 짧은 구절과 그 문맥이 원래 조건을 충족하는 이유를 쓴다. 마지막 문단의 기존 CORTEX_ST_V1 비공개 주석 JSON 최상위에 segments와 나란히 authorObjections:[{requirementRef:"해당 조건 참조",basis:"ALREADY_MET 또는 EXTRA_DEMAND",reason:"짧은 근거"}]를 추가한다. 출력 구조는 {"segments":[마지막 문단의 기존 시공간 객체],"authorObjections":[반문 객체]}이다. requirementRef는 extensionReview.missing의 값을 그대로 복사한다. extensionReview.missing의 모든 조건마다 반드시 한 항목을 출력한다. 판정이 맞으면 basis는 ACCEPT_JUDGMENT, reason에는 인정 사유와 이번 비트 보완 방향을 기록한다. 이미 충족했다면 ALREADY_MET, 추가 요구라면 EXTRA_DEMAND를 쓴다. 필드 누락이나 빈 배열은 동의로 해석되지 않는다. 본문에는 판정 논쟁을 쓰지 않는다. 이의는 해당 조건의 최종 처리이며 재감사를 요구하지 않는다.';

 function writerPacing(completedBeats=0,extensionRound=0){const n=Math.max(0,Math.floor(Number(completedBeats)||0)),ext=Math.max(0,Math.floor(Number(extensionRound)||0)),phase=ext>=2?'FINAL_CLOSURE':ext===1?'REPAIR_CLOSURE':n===0?'FREE':n===1?'GUIDED':'CLOSURE';const tasks={FREE:'사용자 행동을 받아 자유롭게 시작하되 현재 사건의 목표와 연결되는 생활·관계·행동의 단서를 자연스럽게 심는다. 첫 비트에 종결을 강요하지 않는다.',GUIDED:'사용자 행동의 결과·환경·NPC 반응을 현재 사건 목표와 인과적으로 연결하고, 아직 드러나지 않은 핵심 사실이나 필요한 행동을 본문에서 실질적으로 실현한다. 목표와 무관한 새 미스터리로 진행을 대체하지 않는다.',CLOSURE:'기본 마지막 비트다. 현재 사건 조건과 공개 원문을 직접 대조해 실제로 남은 목표를 이번 본문에서 완수하고 현재 장면을 마무리한다. 새 곁가지·새 선택지를 계속 만들어 종결을 미루지 않는다.',REPAIR_CLOSURE:'연장 첫 비트다. extensionReview의 지적을 원문으로 검토하여 부족한 목표는 이번 집필로 보완하고, 잘못된 지적은 비공개 이의로 처리한다.',FINAL_CLOSURE:'마지막 연장이다. 남은 목표의 보완 또는 정당한 이의를 우선하고 현재 사건을 마무리한다. 해결 대신 새로운 수수께끼를 늘리지 않는다.'};return {phase,beatNumber:n+1,extensionRound:ext,task:tasks[phase]};}
 const pacingInstruction='activeEvent.pacing의 단계별 집필 목적을 따른다. 사건 계약은 장식용 배경이 아니라 이번 사건에서 실현할 결과다. 원문에 이미 성립한 내용은 반복하지 않고, 아직 필요한 내용은 행동·대화·환경으로 자연스럽게 보여 준다. 사용자 요청은 전부 실현할 의무가 없으며 인과적으로 조정·우회할 수 있다. 사용자 선택을 보존하면서도 NPC의 독립 행동과 환경·서술을 통해 목표를 진행한다. 다음 사건의 비공개 사실을 당겨 오거나 새 위기를 만드는 것으로 현재 목표의 보완을 대신하지 않는다. 이미 공개된 본문을 취소하지 않는다. 패키지의 풍부한 전개·긴장·변수 추가 지시는 현재 사건 목표와 단계 안에서 적용한다. 패키지가 선택을 남긴 결말을 허용하면 선택지를 추가로 해결하느라 끝난 사건을 붙잡지 않는다. 기본 비트에도 목표를 달성하려고 집필하되 직전 판정의 미충족 사유는 연장비트에서만 제공된다. 별도 계획표·목표 보고서는 출력하지 않는다.';
 // Transport keys are local to this request; model output never reconstructs internal references.
 function judgeTransport(requirements){const local=rows(requirements).map((r,i)=>({ref:'r'+(i+1),description:r.description}));return {requirements:local,schema:obj({requirements:obj(Object.fromEntries(local.map(r=>[r.ref,obj({status:judgeSchema.properties.requirements.items.properties.status,reason:{type:'string',maxLength:240}})]))),earlyClosure:judgeSchema.properties.earlyClosure})};}
 function transportVerdict(raw,requirements){const local=judgeTransport(requirements).requirements,values=raw?.requirements;if(!values||Array.isArray(values)||typeof values!=='object'||Object.keys(values).length!==local.length||local.some(r=>!Object.hasOwn(values,r.ref)))throw Error('VERDICT_REQUIREMENTS');return verdict({...raw,requirements:local.map((r,i)=>({...values[r.ref],requirementRef:requirements[i].ref}))},requirements);}
 const branchInstruction='원본 사건 계약의 성공·실패·취소 경로 중 공개 원문에서 실제 진행된 경로를 읽는다. 원본이 행동 생략이나 대체 종결을 허용하면 그 경로로 종결하되 생략된 행동을 수행했다고 기록하지 않는다. 대체 경로에서도 요구하는 결과는 실제 성립해야 한다. 준비·접근 가능·선택 기회와 실제 수행·수령·선택은 다르다. 앞선 사건의 특정 대상에 관한 목표를 동명·유사한 새 대상으로 대신 충족시키지 않는다. 그 경로의 필수 조건과 금지 사항은 유지하며 근거 없는 면제는 하지 않는다.';
 Object.defineProperty(globalThis,'CortexProseMemory',{value:Object.freeze({schema,timeInstruction,closureTip,requirementDisplay,judgeContract,withOpening,readingContext,writerMessages,writerPacing,pacingInstruction:pacingInstruction+' '+branchInstruction,judgeWindow,nonblocking,extensionReview,acceptObjections,objectionReceipt,extensionInstruction,events,plan,nextJob,accept,fingerprint,summaryInstruction,judgeSchema,judgeTransport,transportVerdict,judgeInstruction:judgeInstruction.replace('requirements 각각의 MET/ALTERNATIVE_MET/UNMET/UNCERTAIN/OUT_OF_SCOPE와 짧은 이유만 반환한다.','requirements에 제공된 요청 내 키 각각을 출력 객체의 키로 사용하고 상태와 짧은 이유만 반환한다.')+' '+branchInstruction,verdict})});
})();

/* Studio v2.1: authored routing, never a permission gate for public prose. */
(()=>{'use strict';
const rows=v=>Array.isArray(v)?v:[],copy=v=>structuredClone(v),own=(o,k)=>Object.hasOwn(o||{},k);
const instruction='choices는 지정된 사건의 공개 본문만 읽고 SATISFIED/NOT_SATISFIED/UNEVALUATED로 판단한다. 사용자 의도나 예시 대사는 근거가 아니다. 아직 선택이 실현되지 않았거나 모호하면 UNEVALUATED다. 종결조건과 독립적이며 선택을 실현하라는 집필 지시가 아니다. 인용·상태 장부는 작성하지 않는다.';
function contract(sc){return sc?.runtime?.packageV15?.branchEnding||null}
function state(sc){return sc.runtime.branchEndingState||=( {choices:{},decisions:{},flagBase:copy(sc.runtime.packageV15?.flags||{}),ending:null} )}
function validate(c,events){
 if(!c?.enabled)return;
 const ids=new Set(events.map(e=>e.id)),choices=new Set(),decisions=new Set(),terminals=new Set();
 const fail=s=>{throw Error('BRANCH_CONTRACT:'+s)};
 for(const r of rows(c.records)){if(!r.id||choices.has(r.id)||!ids.has(r.sourceEventId)||!r.criterion?.trim()||r.evaluationSource!=='PUBLIC_PROSE'||r.applyPolicy!=='ONCE_PER_EVENT')fail('CHOICE');choices.add(r.id);if(r.satisfiedEffect&&!['increment_flag','set_flag'].includes(r.satisfiedEffect.kind))fail('EFFECT');}
 function predicate(p){if(!p||typeof p!=='object')fail('PREDICATE');if(p.allOf||p.anyOf){for(const v of rows(p.allOf||p.anyOf))predicate(v);return}if(p.not){predicate(p.not);return}if(p.kind==='choice_status'){if(!choices.has(p.choiceId)||!['satisfied','not_satisfied','evaluated'].includes(p.status))fail('CHOICE_REFERENCE');return}if(p.kind==='event_completed'){if(!ids.has(p.eventId))fail('EVENT_REFERENCE');return}if(['flag_equals','flag_at_least'].includes(p.kind)){if(!rows(c.flags).some(f=>f.id===p.flagId))fail('FLAG_REFERENCE');return}fail('UNSUPPORTED_PREDICATE:'+p.kind)}
 for(const r of rows(c.records)){const e=r.satisfiedEffect;if(e){const f=rows(c.flags).find(f=>f.id===e.flagId);if(!f||typeof e.value!==f.valueType||(e.kind==='increment_flag'&&typeof e.value!=='number'))fail('EFFECT_TYPE')}}
 for(const d of rows(c.decisions)){if(!d.id||decisions.has(d.decisionEventId)||!ids.has(d.decisionEventId)||d.matchPolicy!=='FIRST_AUTHORED_MATCH'||![0,1,2].includes(d.recoveryAttempts)||!ids.has(d.fallback?.nextEventId)||d.fallback.acceptsUnevaluated!==true||!d.fallback.narrativeGuidance?.trim())fail('DECISION');decisions.add(d.decisionEventId);for(const r of rows(d.rules)){if(!ids.has(r.nextEventId))fail('TARGET');predicate(r.when)}}
 for(const t of rows(c.terminalEvents)){if(!ids.has(t.terminalEventId)||terminals.has(t.terminalEventId)||!t.endingId)fail('TERMINAL');if(t.returnPolicy!=='stay_ended')fail('UNSUPPORTED_RETURN_POLICY:'+t.returnPolicy);terminals.add(t.terminalEventId)}
 if(!terminals.size)fail('NO_ENDING');
 const visiting=new Set(),done=new Set();function walk(id){if(terminals.has(id)||done.has(id))return;if(visiting.has(id))fail('UNBOUNDED_CYCLE');visiting.add(id);const d=rows(c.decisions).find(d=>d.decisionEventId===id),i=events.findIndex(e=>e.id===id),targets=d?[...d.rules.map(r=>r.nextEventId),d.fallback.nextEventId]:[events[i]?.nextEventId||events[i]?.nextEvent?.id||events[i+1]?.id];for(const t of targets){if(!t||!ids.has(t))fail('DEAD_END');walk(t)}visiting.delete(id);done.add(id)}for(const e of events)walk(e.id);
}
function fromFiles(files,events){const get=(path)=>{const k=Object.keys(files).find(k=>k.replace(/\\/g,'/').replace(/^\.\//,'')===path);return k?files[k]:null},end=get('routes/ending_convergence.json');if(!end?.enabled){const required=value=>value&&typeof value==='object'&&Object.entries(value).some(([key,v])=>(key==='requiredFeatures'&&rows(v).includes('branch_ending_convergence_v1'))||required(v));if(!end&&required(get('manifest.json')))throw Error('BRANCH_CONTRACT:MISSING_REQUIRED_FILES');return null}if(!get('routes/choice_records.json')||!get('routes/branch_decisions.json'))throw Error('BRANCH_CONTRACT:MISSING_REQUIRED_FILES');const c={...copy(end),records:rows(get('routes/choice_records.json')?.records),decisions:rows(get('routes/branch_decisions.json')?.decisions),flags:rows(get('routes/flags.json')?.flags)};validate(c,events);return c}
function pending(sc){const c=contract(sc);if(!c?.enabled)return [];const s=state(sc);return c.records.filter(r=>r.sourceEventId===sc.event.id&&!s.choices[r.id]?.locked)}
function extend(request,transport,choices){if(!choices.length)return;request.choices=choices.map((r,i)=>({key:'c'+i,criterion:r.criterion,sourceEventId:r.sourceEventId}));transport.schema=copy(transport.schema);transport.schema.required.push('choices');transport.schema.properties.choices={type:'object',additionalProperties:false,required:choices.map((_,i)=>'c'+i),properties:Object.fromEntries(choices.map((_,i)=>['c'+i,{type:'string',enum:['SATISFIED','NOT_SATISFIED','UNEVALUATED']}]))}}
function record(sc,choices,raw,turnId){if(!choices.length)return;const s=state(sc);for(let i=0;i<choices.length;i++){const r=choices[i];if(s.choices[r.id]?.locked)continue;const status=raw?.['c'+i];if(!['SATISFIED','NOT_SATISFIED','UNEVALUATED'].includes(status)&&s.choices[r.id])continue;s.choices[r.id]={status:['SATISFIED','NOT_SATISFIED'].includes(status)?status:'UNEVALUATED',sourceEventId:r.sourceEventId,turnId,locked:false}}}
function flags(sc){const c=contract(sc),s=state(sc),out={...Object.fromEntries(c.flags.map(f=>[f.id,f.defaultValue])),...s.flagBase};for(const r of c.records){if(s.choices[r.id]?.status!=='SATISFIED')continue;const e=r.satisfiedEffect;if(!e)continue;out[e.flagId]=e.kind==='increment_flag'?(Number(out[e.flagId])||0)+e.value:e.value;const stat=sc.runtime?.packageV15?.jieum?.stats?.find(x=>x.id===e.flagId);if(stat&&sc.runtime.packageV15.jieum.mode!=='hud_only')out[e.flagId]=Math.max(stat.minimum,Math.min(stat.maximum,out[e.flagId]))}return out}
function evaluate(sc,p){const c=contract(sc),s=state(sc);if(p.allOf){const a=p.allOf.map(x=>evaluate(sc,x));return a.includes(false)?false:a.includes(null)?null:true}if(p.anyOf){const a=p.anyOf.map(x=>evaluate(sc,x));return a.includes(true)?true:a.includes(null)?null:false}if(p.not){const a=evaluate(sc,p.not);return a===null?null:!a}if(p.kind==='choice_status'){const a=s.choices[p.choiceId]?.status;if(!a||a==='UNEVALUATED')return null;return p.status==='evaluated'||(p.status==='satisfied'?a==='SATISFIED':a==='NOT_SATISFIED')}if(p.kind==='event_completed')return rows(sc.runtime.packageV15.completedEventIds).includes(p.eventId);if(['flag_equals','flag_at_least'].includes(p.kind)){if(c.records.some(r=>r.satisfiedEffect?.flagId===p.flagId&&((!globalThis.CortexJieum?.config(sc)||globalThis.CortexJieum.config(sc).mode==='hud_only')||r.sourceEventId===sc.event.id||rows(sc.runtime.packageV15.completedEventIds).includes(r.sourceEventId))&&(!s.choices[r.id]||s.choices[r.id].status==='UNEVALUATED')))return null;const js=globalThis.CortexJieum?.config(sc)?.mode==='hud_only'?null:globalThis.CortexJieum?.config(sc)?.stats.find(x=>x.id===p.flagId);if(js?.mode==='resource'&&sc.runtime.jieum?.resourceStatus==='UNCONFIRMED')return null;const v=js?globalThis.CortexJieum.values(sc)[p.flagId]:flags(sc)[p.flagId];return p.kind==='flag_equals'?v===p.value:typeof v==='number'&&v>=p.value}return null}
function close(sc,event){const c=contract(sc);if(!c?.enabled)return {handled:false};const s=state(sc);for(const r of c.records.filter(r=>r.sourceEventId===event.id)){s.choices[r.id]||={status:'UNEVALUATED',sourceEventId:r.sourceEventId};s.choices[r.id].locked=true}sc.runtime.packageV15.flags=flags(sc);
 const terminal=c.terminalEvents.find(t=>t.terminalEventId===event.id);if(terminal){s.ending=copy(terminal);sc.runtime.packageV15.endingSeen=[...new Set([...rows(sc.runtime.packageV15.endingSeen),terminal.endingId])];return {handled:true,nextEventId:null,ending:copy(terminal)}}
 const d=c.decisions.find(d=>d.decisionEventId===event.id);if(!d)return {handled:false};if(s.decisions[d.id])return copy(s.decisions[d.id]);let unknown=false,match=null;for(const r of d.rules){const v=evaluate(sc,r.when);if(v===null){unknown=true;break}if(v){match=r;break}}const result={handled:true,nextEventId:match?.nextEventId||d.fallback.nextEventId,reason:match?'AUTHORED_MATCH':unknown?'UNEVALUATED_FALLBACK':'NO_MATCH_FALLBACK',guidance:match?'':d.fallback.narrativeGuidance};s.decisions[d.id]=copy(result);s.handoff={...copy(result),fromEventId:event.id};return result;
}
function recovery(sc){const c=contract(sc);if(!c?.enabled)return null;const d=c.decisions.find(d=>d.decisionEventId===sc.event.id);if(!d)return null;const s=state(sc);const records=c.records.filter(r=>!s.choices[r.id]||s.choices[r.id].status==='UNEVALUATED').filter(r=>r.sourceEventId===sc.event.id||rows(sc.runtime.eventLedger?.sealed).some(e=>e.id===r.sourceEventId));return {decision:d,records}}
Object.defineProperty(globalThis,'CortexBranchEnding',{value:Object.freeze({fromFiles,validate,contract,state,pending,extend,record,flags,evaluate,close,recovery,instruction})});
})();

</script>
<script>
/* Cortex v1.38.0 — compact rewind journal and guarded spacetime/spoiler-aligned image intent capsule. */
(()=>{
  'use strict';
  const VERSION='1.39.0',UNDO_SCHEMA='CORTEX_COMMITTED_TURN_SNAPSHOT_V2',LEGACY_UNDO_SCHEMA='CORTEX_COMMITTED_TURN_SNAPSHOT_V1',IMAGE_SCHEMA='CORTEX_IMAGE_INTENT_CAPSULE_V4',IMAGE_MODEL='gpt-image-2.5-flare',IMAGE_SIZE='1088x608',MAX_UNDO=8;
