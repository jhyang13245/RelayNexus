 }
 function context(runtime,turns){
  if(!runtime.interpretationState){const history=rows(turns).filter(t=>t.status==='COMMITTED'),p=projection(runtime);p.publishedRevision=history.length;p.projectionRevision=history.length;p.appliedTurnIds=history.map(t=>t.id);for(let i=history.length-1;i>=0;i--){const t=history[i];if(t.metrics?.unifiedAdjudication?.available!==false&&t.failureKind!=='POST_DISPLAY_TECHNICAL_FAILURE')break;p.pending.unshift({turnId:t.id,eventId:t.sourceEventId||'',revision:i+1,code:'IMPORTED_PENDING'});p.projectionRevision=i}p.status=p.pending.length?'PENDING':'CURRENT';runtime.interpretationState=p;}
  const p=projection(runtime),selected=p.pending.slice(0,64),ids=new Set(selected.map(r=>r.turnId));return {...copy(p),pendingBatchTurnIds:selected.map(r=>r.turnId),pendingRemainingCount:p.pending.length-selected.length,pendingTexts:rows(turns).filter(t=>ids.has(t.id)).map(t=>({sourceRef:'BEAT:'+t.id,turnId:t.id,eventId:t.sourceEventId,text:t.text})),snapshotAuthority:p.status==='CURRENT'?'LAST_ADJUDICATED_STATE':'STALE_REFERENCE_NOT_CURRENT_FACT'};
 }
 function internSources(payload){
  const out=copy(payload),sources=[],byText=new Map();
  function put(value,use){if(typeof value!=='string'||!value)return value;let id=byText.get(value);if(!id){id='S'+(sources.length+1);byText.set(value,id);sources.push({id,text:value,uses:[]})}if(use)sources.find(row=>row.id===id).uses.push(use);return {$source:id};}
  // Only lossless text storage. No semantic selection, truncation, or summarization.
  for(const k of ['fullText','priorPublicText'])if(out[k])out[k]=put(out[k],{scope:k==='fullText'?'CURRENT_BEAT':'PAST_PUBLIC',turnId:out.publicState?.turnId||''});
