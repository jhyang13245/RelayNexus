  }

  function sysNumberWord(v){const n=Number(v);if(Number.isFinite(n))return n;return ({한:1,하루:1,두:2,이틀:2,세:3,사흘:3,네:4,나흘:4,다섯:5,닷새:5,여섯:6,엿새:6,일곱:7,이레:7,여덟:8,여드레:8,아홉:9,아흐레:9,열:10})[v]||null}
  function sysNarrativeLeaps(text){
    const body=sx(text),out=[],unit={년:31536000,해:31536000,개월:2592000,달:2592000,주:604800,일:86400,시간:3600,분:60};
    const add=(seconds,raw,index,confidence='EXPLICIT')=>{if(Number.isFinite(+seconds)&&+seconds>0)out.push({seconds:+seconds,raw,index,confidence})};
    let m,re=/(\d+(?:\.\d+)?|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열|하루|이틀|사흘|나흘)\s*(년|해|개월|달|주|일|시간|분)\s*(?:이|가)?\s*(후|뒤|지나|흘러|지난|만에)/gu;
    while((m=re.exec(body))){const v=sysNumberWord(m[1]);if(v!=null)add(v*unit[m[2]],m[0],m.index)}
    re=/(\d+|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열)\s*번(?:의)?\s*계절|계절(?:이|은)?\s*(\d+|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열)\s*번/gu;
    while((m=re.exec(body))){const v=sysNumberWord(m[1]||m[2]);if(v!=null)add(v*7884000,m[0],m.index,'CALENDAR_CYCLE')}
    re=/(\d+|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열)\s*번(?:의)?\s*해가\s*(?:바뀌|지나|뜨고\s*지)|해가\s*(\d+|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열)\s*번\s*(?:바뀌|지나)/gu;
    while((m=re.exec(body))){const v=sysNumberWord(m[1]||m[2]);if(v!=null)add(v*31536000,m[0],m.index,'CALENDAR_CYCLE')}
    /* v1.13.0 — 경과 표지를 필수로 바꾼다.
       기존 패턴은 뒤쪽 (후|뒤|지나|흘러|만에) 가 선택이라 "몇 년"만 있어도 2년 도약으로 잡았다.
       실제 로그에서 "한시우, 대학생이 된 지 몇 년인데 아직도 이런다"라는 혼잣말이
       UNLICENSED_FORWARD_LEAP:63072000 을 일으켜 정상 본문이 통째로 폐기됐다.
       인물이 자기 이력을 말하는 것과 장면이 실제로 그만큼 흐르는 것은 다르다.
       바로 위 행의 패턴은 이미 경과 표지가 필수인데 이 두 줄만 빠져 있었다. */
    re=/(?:수년|몇\s*년|여러\s*해|오랜\s*세월)\s*(?:이|은|을)?\s*(?:후|뒤|지나|흘러|만에|흐른|지난)/gu;while((m=re.exec(body)))add(2*31536000,m[0],m.index,'LOWER_BOUND');
    re=/(?:수개월|몇\s*개월|몇\s*달)\s*(?:이|은|을)?\s*(?:후|뒤|지나|흘러|만에|흐른|지난)/gu;while((m=re.exec(body)))add(2*2592000,m[0],m.index,'LOWER_BOUND');
    if(/(?:다음\s*날|이튿날|다음날)/u.test(body))add(86400,'next-day',body.search(/(?:다음\s*날|이튿날|다음날)/u));
    return out.sort((a,b)=>a.index-b.index);
  }
  function sysLeapAuthorized(leap,txn){const allowed=Math.max(+txn?.intent?.requestedDurationSec||0,+txn?.temporalContract?.durationSec||0);if(allowed>=leap.seconds*.8)return true;const raw=sx(txn?.intent?.raw);return sysNarrativeLeaps(raw).some(x=>Math.abs(x.seconds-leap.seconds)<=Math.max(60,leap.seconds*.1))}
  /* v1.13.0 — 회상·이력 문맥에서 나온 기간 표현은 장면 시간 이동이 아니다.
