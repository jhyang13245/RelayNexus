  const SYS_REFERENCE_RE=/(?:쓰던|남긴|자리|냄새|향|사진|초상|기억|생각|떠올|회상|실종|돌아오지|없는|부재|유품|흔적|기록|이름만|목소리를\s*기억)/u;

  const SYS_FRAME_DEFS=[
