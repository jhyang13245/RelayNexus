  const SYS_STOPWORDS=new Set('사용자 플레이어 주인공 독자 현재 사건 장면 행동 결과 상태 사실 정보 정도 의미 통해 대한 된다 한다 있다 없다 먼저 이후 동안 지금 다시 하나 모두 서로 그대 이것 그것 여기 거기 어떤 같은 실제 충분히 자연스럽게 명확하게'.split(/\s+/u));
