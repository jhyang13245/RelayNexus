  function sysAgencySatisfied(txn){return Boolean(sx(txn?.intent?.raw)&&!['rejected','branch_required'].includes(sx(txn?.intentDisposition)))}
  const SYS_COMPLETION_NEG_RE=/(?:않았|않는다|않음|못했|못했다|못하|실패했|실패했다|미완료|하지\s*못|하지\s*않|아니었|아니다|없었다|없다|거부했|중단했|취소했)/u;
  function sysEvidenceClauses(evidence){const clauses=sysClauses(evidence);return clauses.length?clauses:[sx(evidence)].filter(Boolean)}
