  function sysInputPresenceLicenseV171(sc,txn){const refs=new Set([sc?.protagonist?.id,...sl(sc?.scene?.presentCharacterIds)]);if(sysEventPhase(sc)!=='WAITING_FOR_START')for(const id of sl(sc?.event?.presentCharacterIds))refs.add(id);for(const node of sl(txn?.intent?.semanticIR?.presenceGraph?.nodes))if(node?.status==='PRESENT'&&node?.entityRef)refs.add(node.entityRef);for(const proposition of sl(txn?.intent?.semanticIR?.propositions))if(proposition?.actuality==='COMMITTED'&&proposition?.actorRef)refs.add(proposition.actorRef);return [...refs].filter(Boolean)}
  function sysPresenceGraph(sc,text='',blocks=[],options={}){
    const ids=new Set(),reasons={},deniedClaims=[];const add=(id,reason)=>{if(!id)return;ids.add(id);(reasons[id]||(reasons[id]=[])).push(reason)};
    if(sc?.protagonist?.id)add(sc.protagonist.id,'PROTAGONIST');
    for(const id of sl(sc?.scene?.presentCharacterIds))add(id,'SCENE_STATE');
    if(sysEventPhase(sc)!=='WAITING_FOR_START')for(const id of sl(sc?.event?.presentCharacterIds))add(id,'ACTIVE_EVENT');
    const licensed=new Set([...ids,...sl(options?.authorizedEntityRefs)]);for(const b of sl(blocks))if(b?.speakerId&&licensed.has(b.speakerId))add(b.speakerId,'DIALOGUE_SPEAKER');
    const body=sx(text),sentences=sysClauses(body);
    for(const c of [sc?.protagonist,...sl(sc?.characters)].filter(Boolean)){
      for(const name of su([c.name,...sl(c.aliases)]).filter(Boolean)){
        for(const sentence of sentences.filter(s=>s.includes(name))){
          const ni=sentence.indexOf(name),after=sentence.slice(ni+name.length,ni+name.length+64),before=sentence.slice(Math.max(0,ni-48),ni);
          const explicitArrival=/(?:등장|나타나|도착|들어오|다가오|돌아오|현현|문을\s*열고\s*들어)/u.test(after);
          const directAfter=SYS_PRESENCE_ACTION_RE.test(after);
          const memoryDominant=SYS_REFERENCE_RE.test(sentence)||/(?:사진|영상|기록|회상|기억|꿈|초상|유품|남긴|쓰던|하던|였던|있었던|과거|던\s*(?:목소리|모습|기억|장면|표정|말|웃음|소리))/u.test(before+after);
          if(explicitArrival||(directAfter&&!memoryDominant)){if(licensed.has(c.id))add(c.id,explicitArrival?'LICENSED_ARRIVAL':'LICENSED_CURRENT_ACTION');else deniedClaims.push({entityRef:c.id,surface:name,reason:'NO_SCENE_EVENT_OR_USER_PRESENCE_LICENSE'});break;}
        }
      }
    }
    if(sysEventPhase(sc)==='WAITING_FOR_START'){
      const future=new Set(sl(sc?.event?.presentCharacterIds)),scene=new Set(sl(sc?.scene?.presentCharacterIds));
      for(const id of future)if(!scene.has(id)&&id!==sc?.protagonist?.id&&!(reasons[id]||[]).some(r=>r==='DIALOGUE_SPEAKER'||r==='EXPLICIT_ARRIVAL'||r==='DIRECT_CURRENT_ACTION'))ids.delete(id);
    }
