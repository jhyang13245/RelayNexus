    ['ACQUIRE',/(?:줍|주웠|얻|획득|건네받|받|집어\s*들|챙기|수령|회수)/u,'object'],
    ['STORE',/(?:넣|보관|수납|담|꽂|챙겨\s*넣)/u,'object'],
    ['RELEASE',/(?:버리|내려놓|반납|건네|잃어버리|분실|두고\s*가|놓아\s*두)/u,'object'],
    ['ATTACK',/(?:(?:초크|헤드록|암바|관절기|조르기)(?:를|을)?\s*(?:걸|건|시도|사용)|목(?:을|를)?\s*조르|붙잡아\s*제압|밀쳐\s*넘|때리|때렸|때려|때린|걷어차|공격|찌르|찔|쏘|쐈|휘두르|휘둘|던져\s*맞|가격)/u,'attack'],
    ['INSPECT',/(?:확인|조사|살피|관찰|검색|읽|열어\s*보|들여다|검토|찾아보|점검)/u,'object'],
    ['COMMUNICATE',/(?:말하|말했|말해|묻|물었|대답|답했|답하|응답|전화|연락|문자|메시지|외치|외쳤|부르|불렀|설득|요청)/u,'target'],
    ['WAIT',/(?:기다리|머무르|버티|대기)/u,'none'],
    ['REST',/(?:쉬|휴식|잠들|자러|눕|수면)/u,'none'],
    ['CONSUME',/(?:먹|마시|마셨|삼키|삼켰)/u,'object'],
    ['OPEN',/(?:열|개방|잠금\s*해제)/u,'object'],
