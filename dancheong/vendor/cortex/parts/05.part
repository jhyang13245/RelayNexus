      const declared=sx(beats[index]?.phase).toUpperCase();
      if(declared===SYS_BEAT_PHASE_V13.FREE)return SYS_BEAT_PHASE_V13.FREE;
      if(declared===SYS_BEAT_PHASE_V13.GUIDED)return SYS_BEAT_PHASE_V13.GUIDED;
      if(declared===SYS_BEAT_PHASE_V13.CLOSURE)return SYS_BEAT_PHASE_V13.CLOSURE;
      if(declared===SYS_BEAT_PHASE_V13.RECOVERY)return SYS_BEAT_PHASE_V13.RECOVERY;
      if(declared===SYS_BEAT_PHASE_V13.HARD)return SYS_BEAT_PHASE_V13.HARD;
      if(index>=beats.length-1)return SYS_BEAT_PHASE_V13.CLOSURE;
