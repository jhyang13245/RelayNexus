  const SYS_BEAT_PHASE_V13={FREE:'FREE',GUIDED:'GUIDED',CLOSURE:'CLOSURE',RECOVERY:'RECOVERY',HARD:'HARD_CLOSURE'};
  const SYS_GUIDED_RATIO_V13=.35,SYS_CLOSURE_RATIO_V13=.7;
  function sysBeatPhaseV13(sc,closure){
    const p=closure?.progress||sysEnsureRuntime(sc),elapsed=+closure?.elapsedRatio||0,turnNo=+closure?.turnNo||1,minTurns=+p?.minTurns||1;
    /* v1.14.0 — 연장 비트는 둘까지다. 두 번째가 마지막이므로 그 턴은 HARD 로 연다.
       v1.13.0 은 마감을 넘긴 뒤에야 HARD 가 되어서, 연장 두 턴 내내 "수렴시켜라"라는
       약한 지시만 나가고 곧바로 강제 실패 봉인으로 떨어졌다. 남은 것을 직접 성립시키라는
       말을 한 번도 하지 않은 채 실패로 닫은 셈이다. 마지막 연장 턴에서 그 말을 한다. */
    const extensionsV14=+p?.closureExtensionCount||0;
