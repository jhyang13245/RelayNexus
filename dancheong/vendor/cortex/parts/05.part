  function sysWaitingDuration(txn,sc){const bounds=sysEventBounds(sc.event,sc.world),now=sclock(txn?.start?.day??sc.world?.day,txn?.start?.time||sc.world?.time),remaining=Math.max(1,bounds.start-now),frame=sysPrimaryFrame(txn?.intent?.actionFrames);if(+txn?.intent?.requestedDurationSec>0)return Math.min(remaining,+txn.intent.requestedDurationSec);if(txn?.intent?.requestedUntilSec!=null){let t=Math.floor(now/86400)*86400+(+txn.intent.requestedUntilSec||0);if(t<=now)t+=86400;return Math.min(remaining,Math.max(1,t-now))}return Math.min(remaining,sysEstimateFrameDuration(frame,txn?.intent||{}))}
