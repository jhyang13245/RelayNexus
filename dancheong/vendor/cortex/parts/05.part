  function sysConcreteObject(sc,name,evidence=''){name=sysCleanPhrase(name);if(!name||name.length<1||SYS_BODY_RE.test(name)||SYS_ABSTRACT_RE.test(name)||SYS_GENERIC_NOUN_RE.test(name))return false;if(sysCharacterByName(sc,name)||sysKnownLocation(sc,name))return false;const known=sysEntityCatalog(sc).some(e=>e.type==='ITEM'&&su(e.aliases).some(a=>sn(a)===sn(name)));if(known)return true;return new RegExp(`${sescape(name)}(?:을|를)[^.!?。！？]{0,40}(?:챙기|줍|얻|받|넣|보관|담|버리|내려놓|건네|건넸|수령|회수|집어\s*들)`,'u').test(sx(evidence))}
