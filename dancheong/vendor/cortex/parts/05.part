  }

  function sysMotifNominals(clause){const tokens=sysTokenize(clause),out=[];for(let i=0;i<tokens.length;i++){let raw=sx(tokens[i]).replace(/[“”'"‘’「」『』()[\]{},，。.!?！？;；]/g,'');if(!raw)continue;let particle='',stem='';for(const p of SYS_MOTIF_PARTICLES){if(raw.length>p.length+1&&raw.endsWith(p)){particle=p;stem=raw.slice(0,-p.length);break}}if(!particle)continue;const parts=[stem];for(let j=i-1;j>=0&&parts.length<4;j--){let t=sx(tokens[j]).replace(/[“”'"‘’「」『』()[\]{},，。.!?！？;；]/g,'');if(!t||SYS_CONNECTOR_RE.test(t)||SYS_MOVE_RE.test(t)||SYS_CARRY_RE.test(t)||SYS_VERBAL_CONNECTOR_RE.test(t))break;if(sysStripParticle(t))break;if(/(?:고|며|면서|다가|지만|는데|어서|아서|해서)$/u.test(t))break;parts.unshift(t)}const phrase=sysCleanPhrase(parts.join(' '));if(phrase)out.push({phrase,particle,index:i,raw:tokens[i]})}return out}
  function sysMotifCandidates(sc,text){const body=sx(text),characters=new Set([sc?.protagonist,...sl(sc?.characters)].filter(Boolean).flatMap(c=>[sn(c.name),...sl(c.aliases).map(sn)])),locations=sysEntityCatalog(sc).filter(e=>e.type==='LOCATION').map(e=>sn(e.name)),out=[];for(const clause of sysClauses(body)){const salient=/(?:기억|떠올|그리|상징|오래된|낡은|빛바랜|익숙|냄새|향|손끝|시선|조용|침묵|따뜻|차가운|젖은|금이|깨진|빛났|바라보|남아|버려진|흔들|반짝|무늬|색|소리|감촉)/u.test(clause)?2:1;for(const c of sysMotifNominals(clause)){const label=sysCleanPhrase(c.phrase),norm=sn(label);if(!label||norm.length<2||characters.has(norm)||locations.some(l=>l===norm||l.includes(norm)||norm.includes(l))||SYS_BODY_RE.test(label)||SYS_ABSTRACT_RE.test(label)||SYS_GENERIC_NOUN_RE.test(label))continue;const toks=sysContentTokens(label),head=toks.at(-1)||norm;if(!toks.length)continue;out.push({label,key:`motif-${stableHash(head)}`,head,tokens:toks,sentence:sline(clause,220),salience:salient})}}return out.filter((x,i,a)=>a.findIndex(y=>y.label===x.label)===i).slice(0,20)}
  function sysMotifSimilar(a,b){const at=new Set(a.tokens||sysContentTokens(a.label)),bt=new Set(b.tokens||sysContentTokens(b.label)),inter=[...at].filter(x=>[...bt].some(y=>sysTokenMatch(x,y)));const denom=Math.max(1,Math.min(at.size,bt.size));if(inter.length/denom>=.5)return true;const ah=sx(a.head),bh=sx(b.head);return ah.length>=2&&bh.length>=2&&(ah.endsWith(bh)||bh.endsWith(ah))}
  function sysMotifLedger(sc){sc.runtime=sc.runtime||{};return sc.runtime.systemicMotifLedger||(sc.runtime.systemicMotifLedger={schema:SYS_MOTIF_SCHEMA,entries:[]})}
  function sysUpdateMotifs(sc,text,turnNo){const ledger=sysMotifLedger(sc),cands=sysMotifCandidates(sc,text);for(const c of cands){let e=ledger.entries.find(x=>sysMotifSimilar(x,c));if(!e){e={key:c.key,label:c.label,head:c.head,tokens:c.tokens,uses:[],salienceByTurn:{},cooldownUntil:0};ledger.entries.push(e)}e.label=e.label.length>=c.label.length?e.label:c.label;e.tokens=su([...(e.tokens||[]),...(c.tokens||[])]);e.uses=su([...(e.uses||[]),turnNo]).filter(n=>turnNo-n<=8);e.salienceByTurn=e.salienceByTurn||{};e.salienceByTurn[turnNo]=Math.max(+e.salienceByTurn[turnNo]||0,+c.salience||1);for(const k of Object.keys(e.salienceByTurn))if(turnNo-(+k)>8)delete e.salienceByTurn[k];const recent=e.uses.filter(n=>turnNo-n<=3),score=recent.reduce((sum,n)=>sum+(+e.salienceByTurn[n]||1),0);if(recent.length>=3||score>=4)e.cooldownUntil=Math.max(e.cooldownUntil,turnNo+3)}ledger.entries=ledger.entries.filter(e=>turnNo-(e.uses?.at(-1)||0)<=12).slice(-64);return ledger}
  function sysMotifDirective(sc,input=''){const ledger=sysMotifLedger(sc),turnNo=typeof turns!=='undefined'&&Array.isArray(turns)?turns.length:0,raw=sx(input),eventText=[sc?.event?.summary,sc?.event?.nextBeat,...sysRequirementList(sc?.event).map(r=>r?.description||r)].join(' '),avoid=[];for(const e of ledger.entries){if(e.cooldownUntil<=turnNo)continue;if(e.tokens?.some(t=>raw.includes(t))||e.tokens?.some(t=>eventText.includes(t)))continue;avoid.push({key:e.key,label:e.label,untilTurn:e.cooldownUntil})}return {schema:SYS_MOTIF_SCHEMA,avoid:avoid.slice(0,10),rule:'최근 반복된 상징·감각 소품은 의미가 새로 변하거나 사용자/현재 사건이 직접 요구하지 않는 한 다시 중심 이미지로 쓰지 않는다.'}}
