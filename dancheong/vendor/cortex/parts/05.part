    const base=settings.baseUrl.replace(/\/+$/u,''),packageRows=CortexTurnExperience.selectImageReferences(capsule,await mediaPackageRowsV230(capsule.storyId)),referenceImages=packageRows.map(row=>row.dataUrl);
