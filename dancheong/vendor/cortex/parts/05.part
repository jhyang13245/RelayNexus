    if(kinds.has('INSPECT'))return 'INVESTIGATION';
    if(kinds.has('COMMUNICATE')||requirements.includes('DIALOGUE'))return 'DIALOGUE';
    if(requirements.includes('RELATIONSHIP_STATE'))return 'RELATIONSHIP';
    return 'DRAMATIC_SCENE';
  }
  function sysLiteraryPolicy(sc,txn){
    const mode=sysSceneMode(sc,txn),presence=sysPresenceGraph(sc),npcIds=presence.presentCharacterIds.filter(id=>id&&id!==sc?.protagonist?.id),capsule=txn?.writerContext?.narrativeCapsule?.payload||{},threads=sl(capsule?.nextScenePressure).filter(x=>x?.statement).slice(0,2),relationship=sl(capsule?.relationshipSubtext).filter(x=>x?.delta||x?.unspokenTension||x?.nextDialoguePressure).slice(0,2);
    const modeGuidance={ACTION:'짧은 인지→행동→충돌→대가의 인과를 우선하고 설명은 움직임 사이에만 넣는다.',INVESTIGATION:'관찰→가설→검증 가능한 발견 순서로 진행하고 한 턴에 새 사실을 과적하지 않는다.',DIALOGUE:'정보 전달보다 욕구·관계·숨은 의도의 충돌을 대사와 반응으로 보여 준다.',RELATIONSHIP:'감정을 선언하지 말고 선택·거리·대사의 온도·행동의 대가로 관계 변화를 드러낸다.',INTERLUDE:'다음 사건을 예고로 끌어오지 말고 생활·관계·환경의 구체적인 현재를 흥미롭게 만든다.',CLOSURE:'새 미스터리와 갈등을 추가하지 않고 이미 열린 인과를 회수해 만족스러운 장면 변화로 닫는다.',DRAMATIC_SCENE:'사용자 행동의 직접 결과와 현재 인물·환경의 반응을 중심으로 한 장면 안의 작은 변화와 갈고리를 만든다.'}[mode];
    /* v1.13.0 — 장면의 감정 골격.
       modeGuidance 는 사건이 어떤 순서로 진행되는지를 말하지만, 인물이 무엇을 겪는지는 말하지 않는다.
       그래서 정합성은 맞는데 "아무것도 달라지지 않은 장면"이 나왔다.
       고정된 5단계를 매 턴 강제하면 세 턴 만에 같은 리듬이 반복되므로,
       모드마다 다른 감정 변화의 축을 하나씩 준다. 한 턴에 그 축이 한 번 움직이면 된다. */
    const emotionalArc={
      ACTION:'뛰어들기 전과 후로 인물의 각오가 달라져야 한다. 몸이 먼저 움직였는지 재고 끝에 나섰는지를 분명히 하고, 그 대가를 인물이 실감하게 하라.',
      INVESTIGATION:'무엇을 예상했고 무엇이 어긋났는지를 남겨라. 발견 자체보다 그 발견이 인물의 짐작을 어떻게 바꿨는지가 장면의 중심이다.',
      DIALOGUE:'대화 전과 후로 두 사람의 거리가 달라져야 한다. 끝내 말하지 못한 것이 무엇인지도 함께 남겨라.',
      RELATIONSHIP:'관계에 대한 인물의 판단이 한 눈금 움직여야 한다. 확신이 흔들리거나, 미뤄 둔 감정을 인정하거나, 선을 다시 긋는다.',
      INTERLUDE:'큰 사건이 없는 장면일수록 인물의 성격이 드러나야 한다. 사소한 것에 발끈하거나 딴생각을 하거나 혼잣말을 하게 하라. 조용히 관조하는 장면으로 만들지 마라.',
      CLOSURE:'인물이 이 일을 어떻게 매듭지었다고 느끼는지를 남겨라. 해결됐다는 사실보다 그것을 받아들이는 태도가 마지막 인상을 만든다.',
      DRAMATIC_SCENE:'사용자 행동의 결과로 인물이 무언가를 새로 알아차리거나 마음을 바꾸게 하라. 아무것도 달라지지 않은 채 끝내지 마라.'
    }[mode];
    return {schema:'CORTEX_LITERARY_POLICY_V2',mode,modeGuidance,emotionalArc,scenePrinciples:['첫 문단은 직전 연속성에서 즉시 이어지는 구체적 행동·감각·대사 중 하나로 시작한다.','이 장면 안에서 인물의 감정이나 판단이 한 번은 움직여야 한다. 다만 그것을 차분한 해설로 설명하지 말고 인물의 반응·말·태도로 드러내라.','사용자가 직접 정하는 주인공의 미발화 대사·감정·결심을 임의 확정하지 않는다.','새 설정 설명보다 현재 장면의 인과와 인물 반응을 우선한다.','각 문단은 앞 문단에서 생긴 원인이나 질문에 반응하며 같은 의미를 다른 문장으로 반복하지 않는다.','감각은 장면에 필요한 1~2개 축을 선택하고 최근 motif cooldown과 겹치는 상징은 피한다.','마지막 문장은 이번 턴에서 실제로 달라진 상태·관계·정보·위치·결정의 여파를 이미지나 행동으로 남긴다.'],dialogue:{eligibleNpcIds:npcIds,rule:npcIds.length?'현재 실제 존재하는 NPC만 말하며 말투·관계·목적이 서로 구별되게 쓴다.':'대화를 만들기 위해 부재 인물을 소환하지 않는다.'},longArc:{pressures:threads,relationshipSubtext:relationship,rule:'장기 복선은 현재 장면과 인과적으로 맞닿은 것만 한 번에 최대 1개를 약하게 진전시키며 정답을 선공개하지 않는다.'},exposition:{maxNewMajorFacts:mode==='INVESTIGATION'||mode==='CLOSURE'?2:1,rule:'한 문단에 설정을 나열하지 말고 발견·행동·대화의 필요에 따라 분산한다.'}};
  }
  function sysNarrativePlan(sc,txn){
    const phase=sysEventPhase(sc),frames=sl(txn?.intent?.actionFrames),primary=sysPrimaryFrame(frames),presence=sysPresenceGraph(sc),presentNpc=presence.presentCharacterIds.filter(id=>id&&id!==sc?.protagonist?.id),closure=sysClosureState(sc,'',txn),motif=sysMotifDirective(sc,txn?.intent?.raw);
    const plan={schema:'CORTEX_NARRATIVE_PLAN_V2',phase,mode:sysSceneMode(sc,txn),literaryPolicy:sysLiteraryPolicy(sc,txn),sceneMoves:[]};
    if(primary)plan.sceneMoves.push({role:'PLAYER_ACTION',instruction:'사용자 행동 프레임을 장면 초반에 실제로 시작하고 대상·목적지·동반자·수단 역할을 보존한다.',frame:sclone(primary)});
    plan.sceneMoves.push({role:'DIRECT_CONSEQUENCE',instruction:'방금 행동이 물리 상태·관계·환경 중 적어도 하나에 남기는 직접 결과를 보여 준다.'});
    if(presentNpc.length)plan.sceneMoves.push({role:'CHARACTER_RESPONSE',instruction:'현재 실제로 존재하는 인물만 반응시키고, 대사는 정보 전달보다 성격·관계·이해 차이를 드러낼 때 사용한다.',eligibleCharacterIds:presentNpc});
    if(txn?.absorptionPlan?.required)plan.sceneMoves.push({role:'CANON_ABSORPTION',instruction:'사용자 계획을 취소하지 않고 공개된 grounding에서 현재 필수 인과가 동선에 끼어들게 한다.',grounding:sclone(txn.absorptionPlan.grounding||[])});
    else if(closure.pressure)plan.sceneMoves.push({role:'EVENT_CLOSURE',instruction:'새 갈등을 늘리지 말고 이미 열린 인과와 미충족 완료조건을 장면 안에서 수렴시킨다.',missing:sclone(closure.audit.missing||[])});
    else if(phase==='WAITING_FOR_START')plan.sceneMoves.push({role:'INTERLUDE',instruction:'예약 사건의 내용을 선취하지 말고 현재 행동·관계·환경의 자유 장면으로 진행한다.'});
    plan.sceneMoves.push({role:'SCENE_DELTA',instruction:'직전 턴과 다른 상태·관계·위치·정보·결정 중 최소 하나의 실제 변화를 남긴다.'});
    plan.sceneMoves.push({role:'CLOSING_IMAGE',instruction:'최근 반복한 상징·문장 이미지를 피하고 이번 턴에서 새로 생긴 변화 하나로 끝낸다.',avoid:sclone(motif.avoid||[])});
