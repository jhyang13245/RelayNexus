  async function generateTurnImageV230(index){const turn=turns[index];if(!turn||turn.status!=='COMMITTED'||turn.imageUrl||turn.imageStatus==='GENERATING')return;if(window.NexusRequireImageApiKey&&!window.NexusRequireImageApiKey())return;turn.id=asText(turn.id||turn?.txn?.txnId)||`legacy-turn-${index+1}-${stableHash(`${turn.input}|${turn.text}`)}`;if(!settings.apiKey.trim()){toast('이미지를 추가하려면 설정에서 OpenAI API Key를 저장해 주세요.');$('settingsDialog').showModal();return}const capsule=prepareTurnImageCapsuleV230(turn);if(!capsule)return toast('확정 본문에서 이미지 장면을 준비하지 못했습니다.');const quality=settings.imageQuality==='medium'?'medium':'low',epoch=sessionEpoch,turnId=turn.id,capsuleId=capsule.id,controller=new AbortController;imageJobControllersV230.set(turnId,controller);turn.imageStatus='GENERATING';turn.imageQuality=quality;delete turn.imageError;renderTurns();try{const generated=await requestTurnImageV230(capsule,quality,controller.signal,turnId),imageUrl=generated.imageUrl,current=turns.find(row=>row?.id===turnId);if(epoch!==sessionEpoch||!current||current.imageCapsule?.id!==capsuleId)return;const assetKey=CortexTurnExperience.imageAssetKey(capsule,quality);current.imageUrl=imageUrl;current.imageAssetKey=assetKey;current.imageStatus='GENERATED';current.imageSize=CortexTurnExperience.imageSize;current.imageModel=generated.model;current.imageRequestedModel=generated.requestedModel;current.imageModelFallback=generated.modelFallback;delete current.imageDiagnostic;current.imageUsage=generated.usage;current.imageReferenceCount=generated.referenceCount;current.imageReferenceCharacters=generated.referenceCharacters;current.imageInputFidelity=generated.inputFidelity;current.imageGeneratedAt=new Date().toISOString();let durable=true;try{await mediaStorePutAllV230(TURN_MEDIA_GENERATED_V230,[{key:assetKey,dataUrl:imageUrl,turnId,storyId:capsule.storyId,updatedAt:Date.now()}])}catch{durable=false}await persist();renderTurns();toast(durable?'장면 이미지를 생성해 이 비트에 저장했습니다.':'장면 이미지를 생성했지만 현재 탭에서만 유