  function sysEntityCatalog(sc){const out=[];const add=(id,name,type,aliases=[])=>{name=sx(name);if(!name)return;out.push({id:sx(id)||`${type}-${stableHash(name)}`,name,type,aliases:su([name,...sl(aliases).map(value=>sx(value))])})};for(const c of [sc?.protagonist,...sl(sc?.characters)])if(c)add(c.id,c.name,'CHARACTER',c.aliases);for(const f of sl(sc?.factions))add(f.id,f.name,'FACTION',f.aliases);for(const loc of [sc?.world?.location,...eventSequence(sc?.event||null).flatMap(e=>sysEventLocations(e))])if(loc)add('',loc,'LOCATION',[]);for(const item of sl(sc?.storyState?.inventory))add(item.targetRef||item.itemRef,item.targetName||item.name,'ITEM',[]);for(const e of sl(sc?.runtime?.canonLedger?.entries))if(/inventory/.test(sx(e?.kind)))add(e.targetRef,e.targetName,'ITEM',[]);return out}
