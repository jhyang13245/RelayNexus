  function sysAuditRequirements(sc,text,txn){const evidence=sysEvidenceText(sc,text),items=sysRequirementList(sc?.event),operator=sc?.event?.compiledEventIR?.completionPolicy?.operator==='ANY'?'ANY':'ALL',rows=items.map(r=>({goalId:sx(r?.id),requirement:sx(r?.description),...sysRequirementSatisfied(r,evidence,txn,sc)})),ok=operator==='ANY'?rows.some(row=>row.ok):rows.every(row=>row.ok),missing=ok?[]:rows.filter(row=>!row.ok).map(row=>row.requirement);if(text&&sc?.event?.compiledEventIR){const typed=CortexContract.auditCompiledEvent(sc.event.compiledEventIR,evidence,(sc?.runtime?.eventMachine?.eventTurns||0)+1,sc?.runtime?.evidenceLedger||[]);sc.runtime.evidenceLedger=typed.evidenceLedger}return {schema:'CORTEX_EVENT_AUDIT_V1',ok,operator,missing,evidence:rows,typedSemanticGate:true}}
  /* v1.12.0 — 조기 충족 공회전 해소.
