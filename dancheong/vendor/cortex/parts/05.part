  function sysGrounding(sc,closure){const anchors=sl(sc?.event?.absorptionAnchors).map(a=>({evidence:sx(a?.fact||a?.evidence||a?.description),strength:sclamp(+a?.strength||4,1,5),sourceId:sx(a?.sourceId||a?.characterId||'event')})).filter(a=>a.evidence&&!containsProtected(sc,a.evidence));if(anchors.length)return anchors.slice(0,2);const missing=sl(closure?.audit?.missing).filter(Boolean);if(missing.length)return missing.slice(0,2).map(evidence=>({evidence,strength:3,sourceId:'event-contract'}));const next=sx(sc?.event?.nextBeat);return next&&!containsProtected(sc,next)?[{evidence:next,strength:2,sourceId:'event'}]:[]}
