  function sysShouldAbsorb(txn,sc,closure=sysClosureState(sc,'',txn)){if(closure.phase==='WAITING_FOR_START'||closure.phase==='NONE')return false;if(!sysRequirementList(sc?.event).length)return false;const frame=sysPrimaryFrame(txn?.intent?.actionFrames),move=sl(txn?.intent?.actionFrames).find(f=>f.kind==='MOVE'),bounds=sysEventBounds(sc.event,sc.world),now=sysWorldTick(sc),remaining=Math.max(0,bounds.end-now),duration=sysEstimateFrameDuration(move||frame,txn?.intent||{}),conflictingMove=Boolean(move?.destination&&move?.movementScope==='SCENE'&&!sysLocationCompatible(sc,move.destination,move.destinationRef)),effectiveDuration=conflictingMove?Math.max(duration,900):duration,deadlineCross=effectiveDuration>=remaining;if(closure.pressure&&!closure.audit.ok)return true;if(txn?.intent?.escape||txn?.intent?.refusal)return true;if(conflictingMove&&(deadlineCross||sc?.event?.locationLocked===true))return true;if((+txn?.intent?.requestedDurationSec||0)>remaining&&remaining>=0)return true;
