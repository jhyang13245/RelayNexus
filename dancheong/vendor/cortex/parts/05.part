  const SYS_TOKEN_EDGE_RE_V14=/^[“”"'‘’「」『』(){}[\]<>]+|[“”"'‘’「」『』(){}[\]<>,.、。!?！？;；:·…]+$/gu;
  function sysContentTokens(text){const raw=sn(text).split(/\s+/u).filter(Boolean),out=[];for(let tok of raw){tok=tok.replace(SYS_TOKEN_EDGE_RE_V14,'').replace(/(?:은|는|이|가|을|를|의|에|에서|에게|으로|로|와|과|도|만|까지|부터)$/u,'');if(tok.length<2||SYS_STOPWORDS.has(tok)||/^\d+$/.test(tok))continue;out.push(tok)}return su(out)}
