  }

  function sysSceneMode(sc,txn){
    const phase=sysEventPhase(sc),closure=sysClosureState(sc,'',txn),frames=sl(txn?.intent?.actionFrames),kinds=new Set(frames.map(f=>f.kind)),requirements=sysRequirementList(sc?.event).map(sysClassifyRequirement);
