  const SYS_BODY_RE=/^(?:머리|얼굴|눈|귀|코|입|목|어깨|팔|팔꿈치|손|손가락|손바닥|손등|가슴|등|허리|배|골반|다리|무릎|발|발목|피부|몸|신체)$/u;
  const SYS_ABSTRACT_RE=/(?:생각|마음|감정|기분|분노|슬픔|공포|기억|시간|순간|사실|정보|상황|행동|선택|시선|목소리|숨|울음|웃음|의지|의도|계획|관계|분위기|느낌|감각|통증|고통|운명|정사|사건|장면)$/u;
  const SYS_GENERIC_NOUN_RE=/(?:사람|것|곳|때|쪽|앞|뒤|안|밖|현재|다음|이전|이번|오늘|내일|어제|문제|상태|결과|원인|방법|정도)$/u;
  const SYS_CONNECTOR_RE=/^(?:그리고|그러고|그러고는|이어서|그런데|하지만|또|곧바로|바로|급히|잠시|일단|그는|그녀는|나는|우리는|자신은)$/u;
  const SYS_VERBAL_CONNECTOR_RE=/(?:타고|챙겨|들고|안고|업고|데리고|끌고|밀고|마치고|끝내고|내려놓고|집어들고|집어\s*들고|준비하고|확인하고|먹고|마시고|말하고|고개를\s*들고|몸을\s*돌려|문을\s*열고)$/u;
  const SYS_GENERIC_PREDICATE_RE=/(?:[가-힣a-z0-9]+(?:한다|했다|한다면|하려고|하려다|해본다|해본다|된다|됐다|간다|갔다|온다|왔다|본다|봤다|먹는다|마신다|쓴다|읽는다|잡는다|놓는다|연다|닫는다|준다|받는다|잔다|쉰다|기다린다|멈춘다|시작한다|끝낸다|떠난다|움직인다|살핀다|말한다|묻는다|대답한다|느낀다|생각한다|결정한다|선택한다|버린다|챙긴다|들어간다|나간다|돌아간다|도착한다))$/u;
  const SYS_VOLUNTARY_ACTION_RE=/(?:일어나|몸을\s*일으|걷|걸어|기어|달리|뛰|손(?:가락)?을\s*(?:뻗|짚|들|움직)|팔을\s*(?:들|움직)|고개를\s*(?:들|돌)|말하|외치|대답|문을\s*열|물건을\s*집|잡아|휘두르)/u;
  const SYS_MOTIF_PARTICLES=['은','는','이','가','을','를','의','에','와','과'];

  function sysClauses(text){return sx(text).split(/(?<=[.!?。！？])\s+|\n+|\s*[;；]\s*/u).map(s=>s.trim()).filter(Boolean)}
  function sysTokenize(clause){return sx(clause).replace(/([,，。.!?！？;；])/g,' $1 ').split(/\s+/u).filter(Boolean)}
  function sysStripParticle(token){return CortexContract.stripParticle(token)}
  function sysPhraseBefore(tokens,index,stem,maxWords=5){const parts=[stem];for(let j=index-1;j>=0&&parts.length<maxWords;j--){let t=sx(tokens[j]).replace(/[“”'"‘’「」『』()[\]{},，。.!?！？;；]/g,'');if(!t||t==='채'||t==='뒤'||t==='후'||t==='전에'||SYS_CONNECTOR_RE.test(t)||SYS_MOVE_RE.test(t)||SYS_CARRY_RE.test(t)||SYS_VERBAL_CONNECTOR_RE.test(t))break;if(sysStripParticle(t))break;if(/(?:고|며|면서|다가|지만|는데|어서|아서|해서)$/u.test(t))break;parts.unshift(t)}return sysCleanPhrase(parts.join(' '))}
  function sysCleanPhrase(v){let s=sx(v).replace(/^[,，。.!?！？;；\s]+|[,，。.!?！？;；\s]+$/g,'').replace(/^(?:그리고|그러고(?:는)?|이어서|곧바로|바로|급히|일단|그냥|아예)\s+/u,'');s=s.replace(/\s+/g,' ');return s.length>72?s.slice(-72):s}
  function sysCasePhrases(clause){const tokens=sysTokenize(clause),out=[];for(let i=0;i<tokens.length;i++){const p=sysStripParticle(tokens[i]);if(!p)continue;const phrase=sysPhraseBefore(tokens,i,p.stem);if(phrase)out.push({phrase,particle:p.particle,index:i,raw:tokens[i]})}return out}
  function sysIndexOfPredicate(clause,re){const m=sx(clause).match(re);return m?m.index:-1}
  function sysNearestCase(cases,particles,predicateIndex,clause){const tokenOffsets=[];let cursor=0;for(const tok of sysTokenize(clause)){const idx=sx(clause).indexOf(tok,cursor);tokenOffsets.push(idx);cursor=Math.max(cursor,idx+tok.length)}const eligible=cases.filter(c=>particles.includes(c.particle)&&(tokenOffsets[c.index]??0)<=Math.max(0,predicateIndex));return eligible.at(-1)||null}
  function sysRoleObjectBefore(tokens,index,particles=['을','를'],maxBack=6){
    for(let j=index-1;j>=0&&j>=index-maxBack;j--){const p=sysStripParticle(tokens[j]);if(p&&particles.includes(p.particle)){const phrase=sysPhraseBefore(tokens,j,p.stem);if(phrase)return phrase;break}}
    return '';
  }
  function sysTransport(clause,sc=null){
    const text=sx(clause),tokens=sysTokenize(text);
    for(let i=0;i<tokens.length;i++){
      if(!SYS_RIDE_PREDICATE_RE.test(tokens[i]))continue;
      const phrase=sysRoleObjectBefore(tokens,i,['을','를'],6);
      if(phrase&&!SYS_BODY_RE.test(phrase)&&!SYS_ABSTRACT_RE.test(phrase)&&!SYS_GENERIC_NOUN_RE.test(phrase))return phrase;
    }
    /* Bare '-로 이동' is semantically ambiguous (destination vs means). Do not guess.
       If the phrase is a known item and another explicit destination exists, it can be a means. */
    const cases=sysCasePhrases(text),directionals=cases.filter(c=>['으로','로'].includes(c.particle)),explicitDest=cases.find(c=>['에','까지'].includes(c.particle));
    if(explicitDest){for(const c of directionals){const n=sn(c.phrase);if(sysEntityCatalog(sc||scenario).some(e=>e.type==='ITEM'&&su(e.aliases).some(a=>sn(a)===n)))return c.phrase}}
    return '';
  }
  function sysAccompanied(clause){
    const text=sx(clause),tokens=sysTokenize(text),out=[],hasMove=SYS_MOVE_RE.test(text);
    for(let i=0;i<tokens.length;i++){
      const p=sysStripParticle(tokens[i]);
      if(p&&['와','과','랑','이랑'].includes(p.particle)&&(hasMove||/^(?:함께|같이)$/u.test(tokens[i+1]||''))){const phrase=sysPhraseBefore(tokens,i,p.stem);if(phrase)out.push(phrase)}
    }
    for(let i=0;i<tokens.length;i++){
      if(!SYS_CARRY_RE.test(tokens[i]))continue;
      const phrase=sysRoleObjectBefore(tokens,i,['을','를'],6);if(phrase)out.push(phrase);
    }
    return su(out.filter(v=>v&&!SYS_GENERIC_NOUN_RE.test(v)));
  }
  function sysObjectBeforePredicate(clause,predicateIndex){const cases=sysCasePhrases(clause),obj=sysNearestCase(cases,['을','를'],predicateIndex,clause);return obj?.phrase||''}
  function sysTargetBeforePredicate(clause,predicateIndex){const cases=sysCasePhrases(clause),t=sysNearestCase(cases,['에게','한테','께'],predicateIndex,clause);return t?.phrase||''}
  function sysMoveFrame(clause,sc=null){const text=sx(clause),pi=sysIndexOfPredicate(text,SYS_MOVE_RE);if(pi<0)return null;const roles=CortexContract.movementRoles(text,Number.MAX_SAFE_INTEGER),transport=sysTransport(text,sc),sourceCase={phrase:roles.source};let destination=sysCleanPhrase(roles.destination);if(destination&&transport&&sn(destination)===sn(transport))destination='';
    const accompanied=sysAccompanied(text),carryTheme=(()=>{const tokens=sysTokenize(text);for(let i=0;i<tokens.length;i++){if(!SYS_CARRY_RE.test(tokens[i]))continue;for(let j=i-1;j>=0&&j>=i-5;j--){const p=sysStripParticle(tokens[j]);if(p&&['을','를'].includes(p.particle))return sysPhraseBefore(tokens,j,p.stem)}}return ''})(),moveWord=text.match(SYS_MOVE_RE)?.[0]||'이동',completion=SYS_ARRIVE_RE.test(text)?'ARRIVAL':SYS_DEPART_RE.test(text)?'DEPARTURE':'TRANSIT',motionClass=SYS_ESCAPE_RE.test(text)?'ESCAPE':SYS_RETURN_RE.test(text)?'RETURN':SYS_TRAVEL_CUE_RE.test(text)?'JOURNEY':completion==='ARRIVAL'?'ARRIVAL':completion==='DEPARTURE'?'DEPARTURE':'TRANSIT',modality=SYS_ATTEMPT_RE.test(text)?'ATTEMPT':SYS_NEGATION_RE.test(text)?'NEGATED':'ASSERTED';return {schema:SYS_ACTION_SCHEMA,kind:'MOVE',lemma:'move',predicate:moveWord,source:sourceCase?.phrase||'',destination,manner:roles.manner,theme:carryTheme,accompaniedEntities:accompanied,transport,motionClass,completion,modality,raw:text}}
  function sysOtherFrames(clause){const text=sx(clause),out=[];for(const [kind,re,role] of SYS_FRAME_DEFS){const m=text.match(re);if(!m)continue;const pi=m.index??0,obj=['object','attack'].includes(role)?sysObjectBeforePredicate(text,pi):'',dative=['target','attack'].includes(role)?sysTargetBeforePredicate(text,pi):'',target=role==='attack'?(dative||obj):dative;out.push({schema:SYS_ACTION_SCHEMA,kind,lemma:kind.toLowerCase(),predicate:m[0],theme:obj,target,source:'',destination:'',accompaniedEntities:[],transport:'',motionClass:'',completion:'ACTION',modality:SYS_ATTEMPT_RE.test(text)?'ATTEMPT':SYS_NEGATION_RE.test(text)?'NEGATED':'ASSERTED',raw:text})}return out}
  function sysGenericActionFrame(clause,sc=null,predicateHint=''){
    const text=sx(clause),turnAct=CortexContract.classifyTurnAct(text),caseAction=sysCasePhrases(text).some(role=>['을','를','에게','한테','께','에서','으로','로','와','과','랑','이랑'].includes(role.particle));if(turnAct.primary!=='ACTION'&&!caseAction)return null;const tokens=sysTokenize(text).filter(t=>!/[,.!?。！？;；]/u.test(t));if(!tokens.length)return null;
    let predicate=sx(predicateHint);if(predicate&&!text.includes(predicate))predicate='';for(let i=tokens.length-1;!predicate&&i>=0;i--){const t=sx(tokens[i]).replace(/[“”'"‘’「」『』()[\]{},，。.!?！？;；]/g,'');if(SYS_GENERIC_PREDICATE_RE.test(t)||/(?:다|요|죠|자|라|며|면서|다가|자마자|아서|어서|여서|고)$/u.test(t)){predicate=t;break}}
    if(!predicate)return null;
    const pi=Math.max(0,text.lastIndexOf(predicate)),cases=sysCasePhrases(text),obj=sysNearestCase(cases,['을','를'],pi,text),target=sysNearestCase(cases,['에게','한테','께'],pi,text),source=sysNearestCase(cases,['에서','부터','으로부터'],pi,text),dirs=cases.filter(c=>['에','으로','로','까지'].includes(c.particle));
    const destination=dirs.at(-1)?.phrase||'';
    return {schema:SYS_ACTION_SCHEMA,kind:'GENERIC_ACTION',lemma:'generic_action',predicate,theme:obj?.phrase||'',target:target?.phrase||'',source:source?.phrase||'',destination,accompaniedEntities:sysAccompanied(text),transport:sysTransport(text,sc),motionClass:'',completion:'ACTION',modality:SYS_ATTEMPT_RE.test(text)?'ATTEMPT':SYS_NEGATION_RE.test(text)?'NEGATED':'ASSERTED',raw:text,confidence:'ROLE_PRESERVATION_FALLBACK'};
  }
  function sysCompileActionFrames(input,sc=null){const out=[];for(const clause of sysClauses(input)){const before=out.length,move=sysMoveFrame(clause,sc);if(move)out.push(move);out.push(...sysOtherFrames(clause));if(out.length===before){const generic=sysGenericActionFrame(clause,sc);if(generic)out.push(generic)}}const seen=new Set();return out.filter(f=>{const key=stableHash(JSON.stringify([f.kind,f.source,f.destination,f.theme,f.target,f.accompaniedEntities,f.transport,f.raw]));if(seen.has(key))return false;seen.add(key);f.frameId=`frame-${key}`;return true})}
  function sysPrimaryFrame(frames){const arr=sl(frames);return arr.find(f=>f.kind==='MOVE')||arr.find(f=>!['WAIT','REST'].includes(f.kind))||arr[0]||null}
  function sysPrimaryMove(input,sc=null){return sysCompileActionFrames(input,sc).filter(f=>f.kind==='MOVE').at(-1)||null}
  function sysIntentAction(frame){if(!frame)return 'act';const map={MOVE:'move',DESTROY:'destroy',ACQUIRE:'acquire',STORE:'store',RELEASE:'release',ATTACK:'attack',INSPECT:'inspect',COMMUNICATE:'communicate',WAIT:'wait',REST:'rest',CONSUME:'consume',OPEN:'open',CLOSE:'close',CREATE:'create',GENERIC_ACTION:'act'};return map[frame.kind]||'act'}

  function sysEventBounds(event,world={}){const day=Number.isFinite(+event?.storyDay)?+event.storyDay:Number.isFinite(+event?.scheduleDay)?+event.scheduleDay:Math.max(0,+world?.day||0),start=Number.isFinite(+event?.startTick)?+event.startTick:day*86400+parseClock(event?.startTime||world?.time||'00:00:00');let end=Number.isFinite(+event?.endTick)?+event.endTick:day*86400+parseClock(event?.endTime||event?.startTime||world?.time||'00:00:00');if(end<=start)end+=86400;return {start,end,startParts:sparts(start),endParts:sparts(end)}}
  function sysWorldTick(sc){return sclock(sc?.world?.day,sc?.world?.time)}
  function sysEventPhase(sc){if(!sc?.event)return 'NONE';const now=sysWorldTick(sc),b=sysEventBounds(sc.event,sc.world);if(now>=b.end)return 'OVERDUE';return 'ACTIVE'}
  function sameLocationRegionV213(catalog,left,right){if(!left||!right)return false;const rows=asList(catalog?.locations),parent=new Map(rows.map(row=>[asText(row?.ref),asText(row?.parentRef||row?.relativeToRef)])),lineage=value=>{const out=new Set([asText(value)]);let cursor=asText(value);for(let index=0;cursor&&index<16;index++){cursor=parent.get(cursor);if(cursor)out.add(cursor)}return out},a=lineage(left),b=lineage(right);return [...a].some(ref=>b.has(ref))}
  function eventEligibilityV213(sc,catalog={}){
    return {schema:'CORTEX_EVENT_ELIGIBILITY_V2',phase:'ACTIVE',timeEligible:true,canConsumeEventTurn:true,revealCurrentEvent:true,stageMismatch:false,bridgeToStart:false};
  }
  function temporalAuthorityV213(input,sc,catalog,eligibility){
    return {startDay:+sc?.world?.day||0,startTime:asText(sc?.world?.time),policy:'AUTHOR_CAUSAL_TIME_NO_SCHEDULE'};
  }
  /* v1.13.0 — 사건 설명문과 성공 결과문은 종결 체크리스트가 아니다.
     compileEventIR 이 description·onSuccess 까지 goal 로 승격시키는 바람에
     "오전 6시 43분의 서촌 주택. 사람만 사라지고…" 같은 분위기 지침이 독립 종결조건이 됐고,
     그것 하나 때문에 사건이 다섯 턴을 붙잡혔다. 그런 문장은 작가에게 주는 지침이지
     하나씩 검사해서 통과시켜야 할 항목이 아니다.
     completionSignals·requiredFunctions 처럼 명시적으로 선언된 것만 체크리스트로 남긴다. */
  const SYS_NON_GOAL_SOURCE_RE_V13=/^(?:description|summary|onsuccess|outcome|tone|mood|premise)$/u;
  function sysExplicitGoalV13(goal,event){
    const source=sx(goal?.source||goal?.origin||goal?.field).toLowerCase();
    if(source&&SYS_NON_GOAL_SOURCE_RE_V13.test(source))return false;
    const text=sx(goal?.description);if(!text)return false;
    /* 사건 설명문·성공문과 글자 그대로 같은 goal 은 자동 승격된 것으로 본다. */
    for(const raw of [event?.description,event?.summary,event?.onSuccess,event?.effects]){const other=sx(raw);if(other&&sn(other)===sn(text))return false}
    return true;
  }
  /* v1.13.0 — Studio 계약: 종결조건은 필수 사건에만 있다.
     studio-export.ts 의 작성 지침이 이렇게 못박고 있다.
       "메인 플롯에서 빠지면 뒤가 꼬이는 사건은 required=true 로 지정합니다.
        필수 사건마다 sequence, 본문 완료 판정용 completionSignals … 를 작성합니다."
     즉 completionSignals 는 필수 사건의 산물이고, 선택 사건에는 애초에 없다.

     그런데 엔진은 required 여부와 무관하게 모든 사건에서 목표를 컴파일했고,
     선언이 없으면 description·summary 에서 지어냈다.
     그렇게 만들어진 "오전 6시 43분의 서촌 주택… 선택할 수 있게 끝낸다"는
     장면 설명이지 충족해야 할 조건이 아니어서 영원히 미충족으로 남았다.

     선택 사건은 종결조건 없이 시간과 비트로만 흐르게 둔다. 그것이 계약이다.
     명시 선언이 하나라도 있으면 required 표시가 없어도 그것을 존중한다. */
  function sysDeclaredCompletionV13(event){
    if(sx(event?.completionSignals))return true;
    if(sl(event?.requiredFunctions).some(r=>sx(r?.description||r?.goal||r)))return true;
    if(sx(event?.requiredItems)||sx(event?.requiredDialogue))return true;
    return false;
  }
  /* required 가 명시적으로 false 면 그것이 최종이다.
     completionSignals 가 남아 있어도 필수로 올리지 않는다. 편집 흔적이 명시 계약을 이길 수 없다.
     required 표시 자체가 없는 구버전 패키지에서만 선언 유무로 추정한다. */
  function sysIsRequiredEventV13(event){
    if(event?.required===false||event?.isRequired===false||event?.packageMeta?.required===false)return false;
    if(event?.required===true||event?.isRequired===true||event?.packageMeta?.required===true)return true;
    return sysDeclaredCompletionV13(event);
  }
  function sysRequirementList(event){
    if(event&&!sysIsRequiredEventV13(event))return [];
    const pick=list=>{const all=sl(list).filter(goal=>goal&&typeof goal.description==='string'&&goal.description.trim());const explicit=all.filter(goal=>sysExplicitGoalV13(goal,event));return explicit.length?explicit:all};
    /* v1.14.0 — 저장된 컴파일 결과는 그것을 만든 컴파일러가 지금과 같을 때만 믿는다.
       세션은 이전 실행의 IR 을 그대로 들고 다닌다. 그래서 목표 규칙을 고쳐도
