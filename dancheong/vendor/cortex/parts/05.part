      if(p.mobility==='IMMOBILE'&&/(?:일어나|걷|걸어|기어|달리|뛰|이동|나가|들어가)/u.test(sentence))return 'IMMOBILE_MOVEMENT';
      if(p.mobility==='LOWER_BODY_IMMOBILE'&&/(?:일어나|걷|걸어|달리|뛰|이동|나가|들어가)/u.test(sentence)&&!/(?:기어|끌고|몸을\s*끌|구르)/u.test(sentence))return 'LOWER_BODY_MOVEMENT_UNAVAILABLE';
