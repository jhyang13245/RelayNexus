  function sysEstimateFrameDuration(frame,intent={}){
    const graph=CortexContract.estimateActionGraphDuration(sl(intent.actionFrames).length?intent.actionFrames:(frame?[frame]:[]),intent);
    /* v1.13.0 hotfix — 액션 프레임을 못 잡으면 15초짜리 턴이 계속 나온다.
