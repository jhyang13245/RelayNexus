  function sysEventLocations(event){const vals=[event?.canonLocation,...sl(event?.beats).map(b=>b?.endLocation),...sl(event?.absorptionAnchors).map(a=>a?.targetLocation)].map(value=>sx(value)).filter(Boolean);return su(vals)}
  function sysLocationCompatible(sc,destination,destinationRef=''){const known=sysEventLocations(sc?.event);if(!known.length)return sc?.event?.locationLocked!==true;if(!destination)return true;const graph=CortexContract.createLocationGraph({currentLocation:sc?.world?.location,eventLocations:known}),knownRefs=new Set(graph.nodes.filter(row=>row.kind==='EVENT').map(row=>row.locationRef)),resolvedRef=sx(destinationRef);return Boolean(resolvedRef&&knownRefs.has(resolvedRef))}
  /* v1.12.2 — 행동 종류별 현실적 하한.
