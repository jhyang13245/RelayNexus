  function sysFutureProtected(sc){const out=[];if(sysEventPhase(sc)==='WAITING_FOR_START'){const scene=new Set(sl(sc?.scene?.presentCharacterIds));for(const c of [sc?.protagonist,...sl(sc?.characters)].filter(Boolean)){if(c.id!==sc?.protagonist?.id&&sl(sc?.event?.presentCharacterIds).includes(c.id)&&!scene.has(c.id))out.push(c.name,...sl(c.aliases))}for(const term of sl(sc?.event?.revealTerms))out.push(term)}try{out.push(...sl(protectedTermsFor(sc)))}catch{}return su(out.map(value=>sx(value)).filter(t=>t.length>=2))}
  function sysFutureLeak(text,txn,sc){const raw=sx(txn?.intent?.raw),body=sx(text);for(const term of sysFutureProtected(sc)){if(body.includes(term)&&!raw.includes(term))return `FUTURE_PROTECTED_TERM:${term}`}return ''}

  function sysRealizationIssues(input,txn,text){
