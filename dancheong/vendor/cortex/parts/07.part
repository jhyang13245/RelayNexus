  function sysGenericFormatIssuesV6(text,txn,blocks=[]){
    const issues=[],body=sx(text),p=txn?.prosePolicy||{},/* v1.12.2 — 호출부가 narration 블록 하나만 넘기므로 blocks 길이는 항상 1이었다.
       그 탓에 문단 검사가 사실상 죽어 있었다(실제 4문단인 본문이 SOFT_PARAGRAPHS_LOW:1<3 로 잡힘).
       블록이 실제로 여러 개일 때만 블록 수를 쓰고, 그렇지 않으면 본문을 직접 나눈다. */
