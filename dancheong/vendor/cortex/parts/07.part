    if(Number.isFinite(+p.minChars)&&body.length<+p.minChars)issues.push(`SOFT_LENGTH_SHORT:${body.length}<${+p.minChars}`);if(Number.isFinite(+p.maxChars)&&body.length>+p.maxChars)issues.push(`SOFT_LENGTH_LONG:${body.length}>${+p.maxChars}`);if(Number.isFinite(+p.minParagraphs)&&paragraphs<+p.minParagraphs)issues.push(`SOFT_PARAGRAPHS_LOW:${paragraphs}<${+p.minParagraphs}`);if(Number.isFinite(+p.maxParagraphs)&&paragraphs>+p.maxParagraphs)issues.push(`SOFT_PARAGRAPHS_HIGH:${paragraphs}>${+p.maxParagraphs}`);
