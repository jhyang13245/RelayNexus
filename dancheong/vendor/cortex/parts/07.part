    try{if(typeof PRIVATE_WORD!=='undefined'&&PRIVATE_WORD.test(body))issues.push('PRIVATE_LEAK:HIDDEN_POLICY_TEXT')}catch{}
    try{if(typeof META_RE!=='undefined'&&META_RE.test(body))issues.push('MODEL_META')}catch{}
