  const SYS_DIRECTIVE_REQ_RE_V13=/(?:보여\s*준다|보여준다|드러낸다|암시한다|체감(?:한다|하게)|느끼게|끝낸다|끝맺는다|유지한다|사용한다|만든다|연출한다|묘사한다|남긴다|첫\s*장면|장면은|장면을)/u;
  /* 연출형 문장은 한 덩어리가 아니라 세 겹으로 쓰여 있다.
       ① 반드시 성립해야 하는 사실   ② 소재를 몇 개까지 쓸지의 제약   ③ 장면을 어떻게 닫을지
     ②를 단순 커버리지로 처리하면 많이 쓸수록 점수가 올라 제약과 정반대로 작동한다.
     실제 패키지가 "우산·찻잔·달력 중 1~2개만 사용한다"인데 본문이 셋을 다 쓰면 위반이다.
     그래서 개수 제약을 따로 떼어 상한을 넘기면 미충족으로 돌린다. */
  const SYS_PICK_LIMIT_RE_V13=/([^.。\n]{4,160}?)\s*중\s*(\d+)\s*(?:~|-|～)?\s*(\d+)?\s*개만/u;
  /* v1.14.0 — 요건 문자열을 한 번만 절로 나누고 그 자리에서 타입을 붙인다.
     이 분류가 요건 해석의 유일한 출처다. 아래 사실 판정과 개수 제약 판정은
     같은 결과를 읽기만 한다. 소비하는 쪽마다 따로 나누고 따로 걸러내면
     한쪽 규칙만 고쳐졌을 때 같은 문장이 두 경로에서 다르게 해석된다.
     실제로 개수 제약이 sysPickConstraintV13 에서 검사되면서 동시에
     필수 사실로도 남아, 제약을 정확히 지킨 본문이 미충족으로 떨어졌다. */
  function sysRequirementParseV14(text){
    return CortexContract.splitRequirementClauses(sx(text))
      .map(s=>sx(s))
      .filter(s=>s.length>=4)
      .map(clause=>{
        const kind=SYS_PICK_LIMIT_RE_V13.test(clause)||SYS_CONSTRAINT_CLAUSE_RE_V14.test(clause)?'CONSTRAINT'
          :SYS_PROHIBITION_CLAUSE_RE_V14.test(clause)?'PROHIBITION'
          :'FACT';
        return {clause,kind};
      });
  }
  function sysPickConstraintV13(text,evidence){
    /* 제약으로 분류된 절에서 먼저 찾는다. 절 분할이 표현을 잘라 놓았을 때만 전체 문장으로 물러난다. */
    const scoped=sysRequirementParseV14(text).filter(c=>c.kind==='CONSTRAINT').map(c=>c.clause).join(' ');
    const m=(scoped&&scoped.match(SYS_PICK_LIMIT_RE_V13))||sx(text).match(SYS_PICK_LIMIT_RE_V13);if(!m)return null;
    const min=Math.max(1,+m[2]||1),max=Math.max(min,+(m[3]||m[2])||min);
    /* 열거는 쉼표로 나뉜다. 각 구의 마지막 명사를 대표어로 본다. */
    const candidates=su(sx(m[1]).split(/[,、·]/u).map(part=>sysContentTokens(part).at(-1)).filter(Boolean));
    if(candidates.length<2)return null;
    const have=new Set(sysContentTokens(evidence)),used=candidates.filter(c=>have.has(c));
    return {min,max,candidates,used,ok:used.length>=min&&used.length<=max};
  }
  /* 요건은 "무엇을 독자에게 알려야 하는가"를 말한다.
     "한명진이 1년 전 실종된 외할머니이며…"는 한명진과 외할머니라는 관계가
     본문에서 실제로 이어져야 성립한다. 두 낱말이 본문 여기저기 흩어져 있는 것으로는 안 된다.

     그래서 문서 전체 어휘 비율이 아니라 문장 단위 공기를 본다.
     요건의 한 문장이 담은 핵심 낱말들이 본문의 어느 한 문장 안에 충분히 모여 있으면
     그 사실은 전달된 것으로 본다. 흩어져 있으면 전달되지 않은 것이다. */
  /* v1.14.0 — 연출형 요건 한 문장에는 성격이 다른 세 가지가 섞여 있다.
       ① 사실   본문이 독자에게 전달해야 하는 것        → 충족 판정 대상
       ② 개수   "우산·찻잔·달력 중 1~2개만 사용한다"    → sysPickConstraintV13 이 따로 검사
       ③ 금지   "초자연 현상은 없다"                    → 없어야 성립. 진술하면 오히려 위반
     ②와 ③을 사실 목록에 남겨 두면, 제약을 정확히 지킨 본문이 미충족으로 떨어진다.
     본문에 "우산·찻잔·달력 중 1~2개만 사용한다"라고 쓸 리가 없기 때문이다.
     실제로 핵심 사실 둘과 우산 하나를 제대로 보여 준 본문이 이 이유로 계속 실패했다.
     절을 나눌 때 ②·③에 해당하는 조각은 사실 목록에서 제외한다. */
  const SYS_CONSTRAINT_CLAUSE_RE_V14=/(?:개만|개 이하|이내로|만 사용|중 하나|중 1|중 한)/u;
  const SYS_PROHIBITION_CLAUSE_RE_V14=/(?:없다|없음|않는다|않아야|말아야|금지|배제한다|쓰지 않)\s*[.。]?\s*$/u;
  function sysFactClausesV13(text){
    return sysRequirementParseV14(text).filter(c=>c.kind==='FACT'&&c.clause.length>=6).map(c=>c.clause);
  }
  /* v1.14.0 — 요건 문장에는 전달할 내용과 전달 방식이 섞여 있다.
     "…환경으로 보여 준다"에서 '환경'·'보여'·'준다'는 작가에게 하는 말이지 본문에 나올 낱말이 아니다.
     그것을 요건 어휘로 세면 본문이 아무리 정확해도 비율이 떨어진다.
     실측에서 "한시우가 그 집에서 계속 생활해 왔음을 환경으로 보여 준다"의 요건 어휘가
     [한시우, 계속, 생활해, 왔음, 환경, 보여, 준다] 일곱 개로 잡혔고,
     본문이 "시우는 그 집에서 계속 살면서도"로 그 사실을 그대로 썼는데도 0.14 로 미충족이 됐다. */
  const SYS_META_DIRECTIVE_TOKENS_V14=new Set('보여 준다 보여준다 드러낸다 드러난다 드러낸 암시한다 암시 체감한다 체감 체감하게 느끼게 느낀다 연출한다 연출 묘사한다 묘사 환경 장면 독자 표현한다 전달한다 알린다 보인다 보이게 끝낸다 끝맺는다 남긴다 만든다 사용한다 유지한다 진행한다 확인한다'.split(' '));
  /* 한국어 서사는 인물을 처음에만 성까지 부르고 이후에는 이름만 쓴다.
     요건이 "한시우"라고 적어 두었는데 본문이 "시우"라고 쓰는 것은 같은 사람을 가리킨 것이다.
     접미만 본다. 접두까지 열면 "한시우"가 "한시"에 걸려 엉뚱한 낱말과 이어진다. */
  function sysTokenHitV14(want,have){
    if(have.has(want))return true;
    for(const token of have){
      if(token.length<2)continue;
      if(want.length>=3&&want.endsWith(token))return true;
      if(token.length>=3&&want.length>=2&&token.endsWith(want))return true;
    }
    return false;
  }
  function sysFactAssertedV13(clause,evidence){
    const want=su(sysContentTokens(clause)).filter(t=>sx(t).length>=2&&!SYS_META_DIRECTIVE_TOKENS_V14.has(t));
    if(want.length<2)return {ok:true,ratio:1,best:''};
    let best=0,bestLine='';
    for(const line of sysClauses(sx(evidence))){
      const have=new Set(sysContentTokens(line));
      const hit=want.filter(t=>sysTokenHitV14(t,have)).length,ratio=hit/want.length;
      if(ratio>best){best=ratio;bestLine=line}
    }
    return {ok:best>=.4,ratio:best,best:sline(bestLine,120),required:want};
  }
  function sysDirectiveCoverageV13(text,evidence,sc){
    const pick=sysPickConstraintV13(text,evidence);
    const want=su(sysContentTokens(text)).filter(t=>sx(t).length>=2);
    if(!want.length)return {ok:false,ratio:0,hits:[],pick};
    const have=new Set(sysContentTokens(evidence));
    const hits=want.filter(t=>have.has(t)),ratio=hits.length/want.length;
    /* ① 요건이 진술한 사실이 본문의 어느 한 문장 안에서 실제로 이어졌는가.
       ② 개수 제약이 있으면 그 범위 안인가.
       v1.13.0 초판은 ②만 보고 판정해, 본문에 우산 하나만 나와도 충족으로 봤다.
       요건이 요구한 '한명진 = 외할머니'라는 사실은 전혀 확인하지 않았다. */
    /* v1.13.0 — 요건 한 문장에 성격이 다른 둘이 섞여 있다.
         ① 반드시 전달돼야 하는 사실  ② 소품을 몇 개까지 쓸지의 연출 제약
       실제 로그에서 본문이 "한명진은 정확히 일 년 전 사라졌다"로 ①을 완벽히 전달하면서
       우산·찻잔·달력을 셋 다 써서 ②를 어겼다.
       이 둘을 한 판정으로 묶으면 어느 쪽으로 묶어도 틀린다.
       ①만 붙들면 제약 위반을 놓치고, ②를 종결 조건에 넣으면 사실이 전달됐는데도 사건이 안 닫힌다.

       그래서 종결은 ①로만 결정하고, ②는 별도 신호로 내보내 같은 턴 재작성에 맡긴다.
       사건 진행은 막지 않되 그 장면 안에서 고친다. */
    const facts=sysFactClausesV13(text).map(c=>({clause:sline(c,90),...sysFactAssertedV13(c,evidence)}));
    const unmet=facts.filter(f=>!f.ok);
    const factsOk=facts.length?unmet.length===0:ratio>=.3;
    const pickViolated=Boolean(pick&&!pick.ok);
    return {ok:factsOk,ratio,hits,required:want,pick,pickViolated,facts,unmetFacts:unmet.map(f=>f.clause)};
  }
  sysRequirementSatisfied=function(req,evidence,txn,sc){const type=sysClassifyRequirement(req),text=sx(req?.description||req?.goal||req?.title||req),aliases=sl(req?.aliases).map(value=>sx(value)).filter(Boolean);if(type==='PLAYER_AGENCY')return {ok:sysAgencySatisfied(txn),type,reason:'DETERMINISTIC_PLAYER_AGENCY'};
    /* 연출형 판정은 부정 제약만 비켜 간다.
       상태 요건이라도 문장이 "…끝낸다" 같은 연출 지시면 상태 비교로는 절대 성립하지 않는다.
       실제 로그의 세 번째 요건이 WORLD_STATE 로 분류되어 이 갈래에서 빠지는 바람에
       핫픽스를 넣고도 계속 failClosed 에 걸렸다. 상태 직접 비교를 먼저 시도하고,
       그것이 실패했을 때 연출형으로 받는다. */
    /* 패키지가 유형을 직접 선언했으면 동사 추측을 하지 않는다.
       semanticRole 에 SCENE/DIRECTIVE/PRESENTATION 이 들어 있으면 그대로 연출형으로 받는다.
       동사 목록은 표현 변형에 취약하므로, 선언이 있는 패키지는 그 경로를 아예 타지 않게 한다.
       기존 패키지는 선언이 없으니 종전대로 휴리스틱으로 떨어진다. */
    const declaredDirectiveV13=/SCENE|DIRECTIVE|PRESENTATION|STAGING/.test(sx(req?.semanticRole||req?.type).toUpperCase());
    const stateTypeV13=['INVENTORY_STATE','RELATIONSHIP_STATE','WORLD_STATE'].includes(type);
    const directiveV13=type!=='NEGATIVE_CONSTRAINT'&&(declaredDirectiveV13||(stateTypeV13?SYS_DIRECTIVE_STRONG_RE_V13.test(text):SYS_DIRECTIVE_REQ_RE_V13.test(text)));
    if(directiveV13&&stateTypeV13){
      const matched=sysStateDirectMatchV121(type,text,sc);
      if(matched)return {ok:true,type,reason:'DETERMINISTIC_STATE_OBJECT_MATCH',matched};
    }
    if(directiveV13){
      const coverage=sysDirectiveCoverageV13(text,evidence);
      return {ok:coverage.ok,type,reason:coverage.ok?'DIRECTIVE_SCENE_COVERAGE':'DIRECTIVE_SCENE_INCOMPLETE',coverage,directive:true};
    }if(type==='NEGATIVE_CONSTRAINT')return {ok:sysNegativeSatisfied(req,evidence),type,reason:'DETERMINISTIC_NEGATIVE_CONSTRAINT'};if(['INVENTORY_STATE','RELATIONSHIP_STATE','WORLD_STATE'].includes(type)){const matched=sysStateDirectMatchV121(type,text,sc);if(matched)return {ok:true,type,reason:'DETERMINISTIC_STATE_OBJECT_MATCH',matched}}const propositionGraph=sysKoreanDiscourseGraphV11(evidence,sc),typedSet=CortexContract.buildTypedEvidence(evidence,{sourceTurn:(+sc?.runtime?.systemicEventState?.eventTurns||0)+1,propositionGraph}),typed=CortexContract.typedRequirementResult(req,typedSet.records);return {ok:typed.ok,type,reason:typed.ok?'V17_REFERENCE_GRAPH_AUTHORITY':typed.status==='REANALYZE'?'V17_SEMANTIC_REANALYZE':'V17_VERIFIED_MISSING',typed,propositionGraph,coverage:{ok:typed.ok,affirmed:typed.ok,ratio:typed.facts?.length?Math.min(...typed.facts.map(row=>+row.ratio||0)):0}}}
  /* v1.12.0 — Requirement Evidence Ledger.
     v1.11.1 은 매 턴 요건 전체를 다시 판정했다. 증거 창이 event.runtimeEvidence 12개뿐이라
     사건 초반에 성립한 요건이 창 밖으로 밀리면 종결 시점에 다시 미충족으로 뒤집혔다.
     비가역 요건(일어난 사건)은 성립 시점에 확정하고, 현재 상태를 묻는 가역 요건만 재검사한다.
     장부는 사건 단위다. 사건이 바뀌면 새로 만들어지므로 이전 사건의 증거는 넘어오지 않는다. */
  const SYS_REVOCABLE_TYPES_V12=new Set(['INVENTORY_STATE','WORLD_STATE','RELATIONSHIP_STATE','NEGATIVE_CONSTRAINT']);
  function sysRequirementLedgerV12(sc){
    const eventId=sx(sc?.event?.id);sc.runtime=sc.runtime||{};
    let ledger=sc.runtime.requirementLedger;
    if(!ledger||ledger.schema!=='CORTEX_REQUIREMENT_LEDGER_V12'||sx(ledger.eventId)!==eventId)ledger=sc.runtime.requirementLedger={schema:'CORTEX_REQUIREMENT_LEDGER_V12',eventId,entries:{}};
    return ledger;
  }
  sysAuditRequirements=function(sc,text,txn){
    const evidence=sysEventEvidenceV5(sc,text),items=sysRequirementList(sc?.event),ledger=sysRequirementLedgerV12(sc),turnNo=(+sc?.runtime?.systemicEventState?.eventTurns||0)+1;
    /* 장부는 실제 본문이 있는 커밋 경로에서만 갱신한다.
       브리핑·비트 계약은 text='' 로 감사를 호출하므로 그 호출이 장부를 뒤집으면 안 된다. */
    const mutate=Boolean(sx(text));
    const rows=items.map(r=>{
      const requirement=sx(r?.description||r?.goal||r?.title||r),key=sx(r?.id)||stableHash(requirement);
      /* v1.13.0 — 모델 판정이 있으면 그것을 규칙 판정보다 우선한다.
         규칙은 어휘를 세고 모델은 의미를 본다. 둘이 어긋나면 의미 쪽이 맞다.
         판정이 없는 요건이나 모델 판정을 끈 경우에는 종전대로 규칙이 결정한다. */
      const savedVerdictV210=sc?.runtime?.requirementVerdicts||sc?.runtime?.systemicEventState?.requirementVerdicts,verdictV13=sx(savedVerdictV210?.eventId)===sx(sc?.event?.id)?savedVerdictV210?.verdicts?.[requirement]:undefined;
      const ruled=sysRequirementSatisfied(r,evidence,txn,sc);
      const live=typeof verdictV13==='boolean'?{...ruled,ok:verdictV13,reason:verdictV13?'MODEL_JUDGED_MET':'MODEL_JUDGED_UNMET',ruledOk:ruled.ok}:ruled;
      const revocable=SYS_REVOCABLE_TYPES_V12.has(sx(live?.type)),prior=ledger.entries[key];
      if(mutate){
        if(live.ok&&!prior?.satisfied)ledger.entries[key]={satisfied:true,revocable,type:sx(live.type),reason:sx(live.reason),atTurn:turnNo};
        else if(!live.ok&&prior?.satisfied&&revocable)ledger.entries[key]={...prior,satisfied:false,revokedAtTurn:turnNo};
      }
      /* v1.13.0 — 모델이 판정한 요건에는 latch 를 적용하지 않는다.
         latch 는 증거 창이 좁아 이전에 성립한 사실이 뒤집히는 것을 막으려고 넣은 장치인데,
         모델 판정까지 덮어써 버렸다. 실제 로그에 ok:true / reason:MODEL_JUDGED_UNMET 이라는
         모순된 행이 남았다. 규칙이 한 번 거짓 통과시키면 그 뒤로는 모델이 아니라고 해도
         영원히 충족으로 고정되는 구조였다.
         모델 판정은 본문 전체를 보고 매 턴 새로 내리므로 창이 좁아 뒤집힐 염려가 없다.
         그쪽이 있으면 그것이 최종이다. */
      const latched=!live.ok&&prior?.satisfied===true&&!revocable&&typeof verdictV13!=='boolean';
      return {requirement,...live,ok:live.ok||latched,latched,revocable};
    });
    const missing=rows.filter(r=>!r.ok).map(r=>r.requirement);
    return {ok:missing.length===0,missing,evidence:rows,typedSemanticGate:true,evidenceScope:'CURRENT_EVENT_LEDGER',ledger:{eventId:sx(ledger.eventId),satisfiedCount:Object.values(ledger.entries).filter(e=>e?.satisfied).length,total:items.length}};
  };

  function sysSpeakerPresent(sc,presentIds,speakerId){const speaker=sx(speakerId);if(!speaker)return true;for(const raw of presentIds){if(sx(raw)===speaker)return true;try{if(typeof publicEntityRef==='function'&&(publicEntityRef(sc,raw,'actor')===speaker||publicEntityRef(sc,raw,'character')===speaker))return true}catch{}}return false}
